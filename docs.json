{
  "theme": "mint",
  "name": "Tikway",
  "colors": {
    "primary": "#407FED",
    "light": "#75A7F3",
    "dark": "#2867D6"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "api": {
    "params": {
      "expanded": "all"
    },
    "url": "full",
    "mdx": {
      "auth": {
        "method": "bearer",
        "name": "Authorization"
      },
      "server": "https://api.tikway.ai"
    }
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ],
    "display": "header"
  },
  "markdown": {
    "schema": false
  },
  "$schema": "https://mintlify.com/docs.json",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "icon": "book-open-cover",
          "href": "https://mintlify.com/docs"
        },
        {
          "anchor": "Blog",
          "icon": "newspaper",
          "href": "https://mintlify.com/blog"
        }
      ]
    },
    "languages": [
      {
        "language": "zh",
        "tabs": [
          {
            "tab": "指南",
            "groups": [
              {
                "group": "开始使用",
                "pages": ["zh/introduction", "zh/untitled-page"]
              },
              {
                "group": "协议适配",
                "pages": [
                  {
                    "group": "OpenAI协议",
                    "pages": []
                  }
                ]
              },
              {
                "group": "开发指南",
                "pages": [
                  "zh/develop-guide/gateway-auth",
                  "zh/develop-guide/status-code-response",
                  "zh/develop-guide/protocol-convert"
                ]
              },
              {
                "group": "请求协议",
                "pages": [
                  {
                    "group": "OpenAI 协议",
                    "pages": [
                      {
                        "group": "Chat Completions",
                        "pages": [
                          "zh/request-protocol/open-ai/chat-completions",
                          "zh/request-protocol/open-ai/function-calling",
                          "zh/request-protocol/open-ai/streaming",
                          "zh/request-protocol/open-ai/multi-turn",
                          "zh/request-protocol/open-ai/full-request-example",
                          "zh/request-protocol/open-ai/response-parameters"
                        ]
                      },
                      {
                        "group": "Responses",
                        "pages": [
                          "zh/request-protocol/open-ai/responses",
                          "zh/request-protocol/open-ai/responses/function-calling",
                          "zh/request-protocol/open-ai/responses/streaming",
                          "zh/request-protocol/open-ai/responses/multi-turn",
                          "zh/request-protocol/open-ai/responses/full-request-example",
                          "zh/request-protocol/open-ai/responses/response-parameters"
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "groups": [
              {
                "group": "对话协议",
                "openapi": "openapi.json"
              },
              {
                "group": "图片生成",
                "openapi": [
                  "image-gpt.openapi.json",
                  "image-banana.openapi.json"
                ]
              }
            ]
          }
        ]
      },
      {
        "language": "en",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["en/introduction", "en/quick-starter"]
          }
        ]
      }
    ]
  }
}
