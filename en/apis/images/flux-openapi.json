{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikway Flux Image API",
    "description": "Tikway standard image API.",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "Image generation"
    },
    {
      "name": "Image generation/Flux"
    }
  ],
  "paths": {
    "/v1/images/generations": {
      "post": {
        "summary": "Image generation",
        "deprecated": false,
        "description": "Flux supports text-to-image and image-to-image through POST /v1/images/generations. Use images for up to 4 reference images and size for output dimensions. Each request produces one image. Optional seed, output_format, and safety_tolerance depend on the selected model.",
        "tags": [
          "Image generation/Flux"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "title": "TikwayImageRequest",
                "type": "object",
                "required": [
                  "model",
                  "prompt"
                ],
                "description": "Model-specific image options.",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "examples": [
                      "flux-2-flex",
                      "flux-2-max",
                      "flux-pro-1.1",
                      "flux-dev"
                    ],
                    "description": "Required. Use a model ID or available alias returned by Get Models."
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "size": {
                    "type": "string",
                    "pattern": "^(auto|[1-9][0-9]*x[1-9][0-9]*)$",
                    "description": "Output size as WIDTHxHEIGHT, or auto for the model default. Supported sizes depend on the selected model."
                  },
                  "seed": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ],
                    "description": "Model-specific image options."
                  },
                  "output_format": {
                    "type": "string",
                    "enum": [
                      "jpeg",
                      "png"
                    ]
                  },
                  "safety_tolerance": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      }
                    ],
                    "description": "Model-specific image options."
                  },
                  "response_format": {
                    "type": "string",
                    "enum": [
                      "url",
                      "b64_json"
                    ],
                    "default": "url",
                    "description": "Response format: url returns image URLs; b64_json returns Base64 image data."
                  },
                  "images": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "description": "Optional reference images for image-to-image generation. Omit for text-to-image generation. Image limits depend on the selected model.",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "object",
                          "required": [
                            "image_url"
                          ],
                          "properties": {
                            "image_url": {
                              "type": "string",
                              "minLength": 1,
                              "description": "Image URL, data URL, or Base64 string."
                            }
                          },
                          "additionalProperties": false,
                          "x-apifox-orders": [
                            "image_url"
                          ]
                        }
                      ]
                    }
                  },
                  "n": {
                    "type": "integer",
                    "const": 1,
                    "default": 1,
                    "description": "Only 1 is supported."
                  }
                },
                "additionalProperties": false,
                "x-apifox-orders": [
                  "model",
                  "prompt",
                  "size",
                  "seed",
                  "output_format",
                  "safety_tolerance",
                  "response_format",
                  "images",
                  "n"
                ],
                "examples": [
                  {
                    "model": "flux-2-flex",
                    "prompt": "雨夜的未来城市，写实摄影",
                    "size": "1024x1024",
                    "n": 1,
                    "response_format": "url"
                  },
                  {
                    "model": "flux-2-flex",
                    "prompt": "将产品置于白色摄影棚，保留外观",
                    "size": "1024x1024",
                    "n": 1,
                    "response_format": "url",
                    "images": [
                      {
                        "image_url": "https://example.com/assets/product.png"
                      }
                    ]
                  }
                ]
              },
              "examples": {
                "text-to-image": {
                  "value": {
                    "model": "flux-2-flex",
                    "prompt": "雨夜的未来城市，写实摄影",
                    "size": "1024x1024",
                    "n": 1,
                    "response_format": "url"
                  }
                },
                "reference-image": {
                  "value": {
                    "model": "flux-2-flex",
                    "prompt": "将产品置于白色摄影棚，保留外观",
                    "size": "1024x1024",
                    "n": 1,
                    "response_format": "url",
                    "images": [
                      {
                        "image_url": "https://example.com/assets/product.png"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "created",
                    "data"
                  ],
                  "properties": {
                    "created": {
                      "type": "integer",
                      "description": "Creation timestamp."
                    },
                    "model": {
                      "type": "string"
                    },
                    "output_format": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string",
                            "description": "Image URL returned for response_format=url.",
                            "format": "uri"
                          },
                          "b64_json": {
                            "type": "string",
                            "description": "Base64 image data returned for response_format=b64_json."
                          },
                          "index": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "revised_prompt": {
                            "type": "string"
                          }
                        },
                        "oneOf": [
                          {
                            "required": [
                              "url"
                            ]
                          },
                          {
                            "required": [
                              "b64_json"
                            ]
                          }
                        ]
                      },
                      "minItems": 1
                    },
                    "size": {
                      "type": "string"
                    },
                    "quality": {
                      "type": "string"
                    },
                    "background": {
                      "type": "string"
                    },
                    "usage": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": true,
                  "title": "TikwayImageResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "operationId": "operation523577674"
      }
    }
  },
  "webhooks": {},
  "components": {
    "schemas": {},
    "responses": {},
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "https://api.tikway.ai",
      "description": "production environment"
    }
  ],
  "security": [
