{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikway Qwen Image API",
    "description": "Tikway standard image API.",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "Image generation"
    },
    {
      "name": "Image generation/Qwen"
    }
  ],
  "paths": {
    "/v1/images/generations": {
      "post": {
        "summary": "Image generation",
        "deprecated": false,
        "description": "qwen-image-3.0-pro supports text-to-image and image-to-image through POST /v1/images/generations, with up to 3 reference images in images. prompt_extend_mode=agent is available for text-to-image only. enable_thinking requires prompt_extend=true. n is not supported by this endpoint.",
        "tags": [
          "Image generation/Qwen"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "title": "TikwayImageRequest",
                "type": "object",
                "required": [
                  "model",
                  "prompt"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Required. Use a model ID or available alias returned by Get Models.",
                    "examples": [
                      "bailian/qwen-image-3.0-pro",
                      "qwen-image-3.0-pro"
                    ],
                    "minLength": 1
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Required. Describe the image to generate."
                  },
                  "size": {
                    "type": "string",
                    "pattern": "^(auto|[1-9][0-9]*x[1-9][0-9]*)$",
                    "default": "1024x1024",
                    "examples": [
                      "1024x1024",
                      "2048x2048",
                      "1536x1024"
                    ],
                    "description": "Output size as WIDTHxHEIGHT, or auto for the model default. Supported sizes depend on the selected model."
                  },
                  "images": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "description": "Optional reference images for image-to-image generation. Omit for text-to-image generation. Image limits depend on the selected model.",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "object",
                          "required": [
                            "image_url"
                          ],
                          "properties": {
                            "image_url": {
                              "type": "string",
                              "minLength": 1,
                              "description": "Image URL, data URL, or Base64 string."
                            }
                          },
                          "additionalProperties": false,
                          "x-apifox-orders": [
                            "image_url"
                          ]
                        }
                      ]
                    }
                  },
                  "prompt_extend": {
                    "type": "boolean",
                    "default": true,
                    "description": "Optional. Whether to enable intelligent prompt word rewriting."
                  },
                  "prompt_extend_mode": {
                    "type": "string",
                    "enum": [
                      "direct",
                      "agent"
                    ],
                    "default": "direct",
                    "description": "Optional. Prompt word rewriting mode. Direct supports Vincentian diagrams and Tusheng diagrams; agent only supports Vincentian diagrams."
                  },
                  "enable_thinking": {
                    "type": "boolean",
                    "default": true,
                    "description": "Optional. Whether to enable thinking mode. When set to true prompt_extend cannot be turned off explicitly."
                  },
                  "negative_prompt": {
                    "type": "string",
                    "description": "Optional. Describe what you don't want to appear in the results."
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647,
                    "description": "Optional. Random seed. Fixed seeds improve result reproducibility but do not guarantee pixel-level consistency."
                  },
                  "watermark": {
                    "type": "boolean",
                    "default": false,
                    "description": "Optional. Whether to add Qwen-Image watermark in the lower right corner of the generated image."
                  },
                  "response_format": {
                    "type": "string",
                    "description": "Response format: url returns image URLs; b64_json returns Base64 image data.",
                    "default": "url",
                    "enum": [
                      "b64_json",
                      "url"
                    ]
                  }
                },
                "allOf": [
                  {
                    "not": {
                      "required": [
                        "prompt_extend_mode"
                      ],
                      "properties": {
                        "prompt_extend_mode": {
                          "const": "agent"
                        }
                      },
                      "x-apifox-orders": [
                        "prompt_extend_mode"
                      ]
                    }
                  },
                  {
                    "not": {
                      "required": [
                        "enable_thinking",
                        "prompt_extend"
                      ],
                      "properties": {
                        "enable_thinking": {
                          "const": true
                        },
                        "prompt_extend": {
                          "const": false
                        }
                      },
                      "x-apifox-orders": [
                        "enable_thinking",
                        "prompt_extend"
                      ]
                    }
                  }
                ],
                "additionalProperties": false,
                "x-apifox-orders": [
                  "model",
                  "prompt",
                  "size",
                  "images",
                  "prompt_extend",
                  "prompt_extend_mode",
                  "enable_thinking",
                  "negative_prompt",
                  "seed",
                  "watermark",
                  "response_format"
                ]
              },
              "examples": {
                "text-to-image": {
                  "value": {
                    "model": "bailian/qwen-image-3.0-pro",
                    "prompt": "一张电影感的上海雨夜街景，霓虹灯倒映在湿润路面上，写实摄影",
                    "size": "1024x1024",
                    "prompt_extend": true,
                    "watermark": false
                  }
                },
                "reference-image": {
                  "value": {
                    "model": "bailian/qwen-image-3.0-pro",
                    "prompt": "把苹果改成蓝色，其余保持不变",
                    "size": "1024x1024",
                    "images": [
                      {
                        "image_url": "https://example.com/ref-apple.png"
                      }
                    ],
                    "prompt_extend": true,
                    "watermark": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The image was generated successfully. The gateway has downloaded the upstream temporary image and converted it to Base64 without the data URL prefix.",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Qwen image generation response",
                  "type": "object",
                  "required": [
                    "created",
                    "background",
                    "data"
                  ],
                  "properties": {
                    "created": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0,
                      "description": "The Unix timestamp (in seconds) when the gateway completed response conversion."
                    },
                    "background": {
                      "type": "string",
                      "const": "opaque",
                      "description": "The current Qwen path is fixed to return opaque."
                    },
                    "data": {
                      "type": "array",
                      "minItems": 1,
                      "description": "Generate a list of results.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "b64_json": {
                            "type": "string",
                            "minLength": 1,
                            "contentEncoding": "base64",
                            "description": "Base64 image downloaded and converted by the gateway."
                          },
                          "index": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Results index."
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "b64_json",
                          "index"
                        ]
                      }
                    },
                    "output_format": {
                      "type": "string",
                      "enum": [
                        "png",
                        "jpeg",
                        "webp"
                      ],
                      "description": "The format inferred by the gateway based on the Content-Type of the downloaded image. Omitted when no recognized type is provided by the upstream."
                    },
                    "size": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*x[1-9][0-9]*$",
                      "description": "Actual or requested output size. Omitted when neither the request nor the upstream response provides a size."
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "created": 1788451200,
                  "background": "opaque",
                  "data": [
                    {
                      "b64_json": "iVBORw0KGgoAAAANSUhEUgAA...",
                      "index": 0
                    }
                  ],
                  "output_format": "png",
                  "size": "1024x1024"
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "x-model-capabilities": {
          "bailian/qwen-image-3.0-pro": [
            "prompt",
            "size",
            "images",
            "prompt_extend",
            "prompt_extend_mode",
            "enable_thinking",
            "negative_prompt",
            "seed",
            "watermark",
            "response_format"
          ],
          "qwen-image-3.0-pro": [
            "prompt",
            "size",
            "images",
            "prompt_extend",
            "prompt_extend_mode",
            "enable_thinking",
            "negative_prompt",
            "seed",
            "watermark",
            "response_format"
          ]
        }
      }
    }
  },
  "webhooks": {},
  "components": {
    "schemas": {},
    "responses": {},
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "https://api.tikway.ai",
      "description": "production environment"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ]
}
