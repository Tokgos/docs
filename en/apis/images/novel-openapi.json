{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikway Novel AI Image API",
    "description": "Tikway standard image API.",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "Image generation"
    },
    {
      "name": "Image generation/Novel AI"
    }
  ],
  "paths": {
    "/v1/images/generations": {
      "post": {
        "summary": "Image generation",
        "deprecated": false,
        "description": "Use POST /v1/images/generations for text-to-image and image-to-image with diffusion-4-5-full or diffusion-4-5-curated. Supply source images and style or character references through images. n supports 1–4 outputs; only one ordinary source image is allowed. vibe_transfer and character_reference cannot be combined.",
        "tags": [
          "Image generation/Novel AI"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$id": "urn:tikway:schema:protocols:openai:images-generations:novelai-request:1",
                "title": "TikwayImageRequest",
                "description": "NovelAI image generation Request Body. The unified reference image uses images; the gateway is responsible for converting to model parameters.",
                "type": "object",
                "required": [
                  "model",
                  "prompt"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "examples": [
                      "diffusion-4-5-full",
                      "diffusion-4-5-curated"
                    ],
                    "description": "Required. Use a model ID or available alias returned by Get Models."
                  },
                  "images": {
                    "type": "array",
                    "description": "Optional reference images for image-to-image generation. Omit for text-to-image generation. Image limits depend on the selected model.",
                    "items": {
                      "type": "object",
                      "required": [
                        "image_url"
                      ],
                      "properties": {
                        "type": {
                          "enum": [
                            "image",
                            "vibe_transfer",
                            "character_reference",
                            null
                          ],
                          "description": "image or null is the image source image; the remaining values represent the NovelAI reference image type."
                        },
                        "image_url": {
                          "type": "string",
                          "minLength": 1,
                          "format": "uri"
                        },
                        "strength": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1,
                          "description": "Reference strength. The maximum value of the plot is 0.99."
                        },
                        "fidelity": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1,
                          "description": "Fidelity. The graph is converted to noise = 1 - fidelity."
                        },
                        "ref_type": {
                          "type": "string",
                          "enum": [
                            "character",
                            "style",
                            "character&style"
                          ],
                          "default": "character&style",
                          "description": "Only used by character_reference."
                        }
                      },
                      "additionalProperties": false,
                      "x-apifox-orders": [
                        "type",
                        "image_url",
                        "strength",
                        "fidelity",
                        "ref_type"
                      ]
                    },
                    "maxItems": 16
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32000,
                    "description": "Required. Describe the image to generate."
                  },
                  "negative_prompt": {
                    "type": "string",
                    "description": "Negative cue words."
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4,
                    "default": 1,
                    "description": "Number of generated images. Allowed counts depend on the selected model."
                  },
                  "size": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*x[1-9][0-9]*$",
                    "default": "1024x1024",
                    "description": "Output size as WIDTHxHEIGHT, or auto for the model default. Supported sizes depend on the selected model."
                  },
                  "seed": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ],
                    "description": "Random seed."
                  },
                  "steps": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 23,
                    "description": "Number of sampling steps."
                  },
                  "scale": {
                    "type": "number",
                    "default": 5,
                    "description": "Cue words guide intensity."
                  },
                  "quality_toggle": {
                    "type": "boolean",
                    "default": true,
                    "description": "Quality switch."
                  },
                  "sampler": {
                    "type": "string",
                    "enum": [
                      "Euler Ancestral",
                      "Euler",
                      "DPM++ 2S Ancestral",
                      "DPM++ 2M SDE",
                      "DPM++ 2M",
                      "DPM++ SDE"
                    ],
                    "default": "Euler Ancestral"
                  },
                  "noise_schedule": {
                    "type": "string",
                    "enum": [
                      "karras",
                      "exponential",
                      "polyexponential"
                    ],
                    "default": "karras"
                  },
                  "character_prompts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "prompt": {
                          "type": "string"
                        },
                        "uc": {
                          "type": "string"
                        },
                        "center": {
                          "type": "object",
                          "properties": {
                            "x": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "y": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          },
                          "additionalProperties": false,
                          "x-apifox-orders": [
                            "x",
                            "y"
                          ]
                        }
                      },
                      "additionalProperties": false,
                      "x-apifox-orders": [
                        "prompt",
                        "uc",
                        "center"
                      ]
                    }
                  },
                  "response_format": {
                    "type": "string",
                    "description": "Response format: url returns image URLs; b64_json returns Base64 image data.",
                    "default": "url",
                    "enum": [
                      "b64_json",
                      "url"
                    ]
                  }
                },
                "additionalProperties": false,
                "x-apifox-orders": [
                  "model",
                  "images",
                  "prompt",
                  "negative_prompt",
                  "n",
                  "size",
                  "seed",
                  "steps",
                  "scale",
                  "quality_toggle",
                  "sampler",
                  "noise_schedule",
                  "character_prompts",
                  "response_format"
                ]
              },
              "examples": {
                "text-to-image": {
                  "value": {
                    "model": "diffusion-4-5-full",
                    "prompt": "A serene Japanese garden at dawn, mist above a koi pond, cinematic lighting, highly detailed",
                    "negative_prompt": "lowres, blurry, text, watermark",
                    "size": "1024x1536",
                    "n": 1,
                    "steps": 28,
                    "scale": 5,
                    "sampler": "Euler Ancestral",
                    "noise_schedule": "karras"
                  }
                },
                "reference-image": {
                  "value": {
                    "model": "diffusion-4-5-full",
                    "prompt": "Turn this scene into an evening watercolor painting, warm lantern light, delicate brush strokes",
                    "negative_prompt": "text, watermark, distorted",
                    "size": "1024x1024",
                    "n": 1,
                    "images": [
                      {
                        "type": "image",
                        "image_url": "https://example.com/source.png",
                        "strength": 0.65,
                        "fidelity": 0.8
                      }
                    ]
                  }
                },
                "reference-image-3": {
                  "value": {
                    "model": "diffusion-4-5-full",
                    "prompt": "A futuristic city street in the rain, a lone traveler under an umbrella",
                    "negative_prompt": "text, watermark, blurry",
                    "size": "1024x1536",
                    "n": 1,
                    "images": [
                      {
                        "type": "vibe_transfer",
                        "image_url": "https://example.com/style-reference.png",
                        "strength": 0.7
                      }
                    ]
                  }
                },
                "reference-image-4": {
                  "value": {
                    "model": "diffusion-4-5-full",
                    "prompt": "The referenced character reads a book in a quiet library, soft afternoon sunlight",
                    "negative_prompt": "text, watermark, extra fingers, distorted face",
                    "size": "1024x1536",
                    "n": 1,
                    "images": [
                      {
                        "type": "character_reference",
                        "image_url": "https://example.com/character.png",
                        "ref_type": "character&style",
                        "strength": 0.8,
                        "fidelity": 0.5
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "created",
                    "data"
                  ],
                  "properties": {
                    "created": {
                      "type": "integer",
                      "description": "The Unix timestamp (in seconds) when the gateway completed image conversion."
                    },
                    "background": {
                      "type": "string",
                      "enum": [
                        "transparent",
                        "opaque"
                      ],
                      "description": "Background settings inferred from unified inbound requests; NovelAI raw responses are typically not echoed."
                    },
                    "data": {
                      "type": "array",
                      "minItems": 1,
                      "description": "Generated image list.",
                      "items": {
                        "type": "object",
                        "required": [
                          "b64_json",
                          "index"
                        ],
                        "properties": {
                          "b64_json": {
                            "type": "string",
                            "description": "The gateway downloads and converts image data into Base64."
                          },
                          "index": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "The index of the image in the results list."
                          }
                        }
                      }
                    },
                    "output_format": {
                      "type": "string",
                      "enum": [
                        "png",
                        "jpeg",
                        "webp"
                      ],
                      "description": "The format inferred from the downloaded image MIME type or request output_format."
                    },
                    "quality": {
                      "type": "string",
                      "enum": [
                        "low",
                        "medium",
                        "high"
                      ],
                      "description": "Unified quality field; if quality is requested, the gateway will map and echo it."
                    },
                    "size": {
                      "type": "string",
                      "description": "The size of the original request; NovelAI's original response is usually not echoed."
                    }
                  },
                  "examples": [
                    {
                      "created": 1713833628,
                      "background": "opaque",
                      "data": [
                        {
                          "b64_json": "...",
                          "index": 0
                        }
                      ],
                      "output_format": "png",
                      "size": "1024x768"
                    }
                  ]
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "x-model-capabilities": {
          "diffusion-4-5-full": [
            "prompt",
            "images",
            "negative_prompt",
            "n",
            "size",
            "seed",
            "steps",
            "scale",
            "quality_toggle",
            "sampler",
            "noise_schedule",
            "character_prompts",
            "hook_url",
            "response_format"
          ],
          "diffusion-4-5-curated": [
            "prompt",
            "images",
            "negative_prompt",
            "n",
            "size",
            "seed",
            "steps",
            "scale",
            "quality_toggle",
            "sampler",
            "noise_schedule",
            "character_prompts",
            "hook_url",
            "response_format"
          ]
        }
      }
    }
  },
  "webhooks": {},
  "components": {
    "schemas": {},
    "responses": {},
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "https://api.tikway.ai",
      "description": "production environment"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ]
}
