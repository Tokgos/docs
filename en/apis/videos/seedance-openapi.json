{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikway Seedance Video API",
    "description": "OpenAI-compatible asynchronous video generation interface for ByteDance’s Seedance model.",
    "version": "1.1.0"
  },
  "tags": [
    {
      "name": "video generation"
    },
    {
      "name": "Video generation/Seedance"
    }
  ],
  "paths": {
    "/v1/videos": {
      "post": {
        "summary": "Create a Seedance video",
        "deprecated": false,
        "description": "Create Seedance video tasks via unified `POST /v1/videos`. Model capabilities are subject to the actual callable range of the current Tikway gateway.\n\n| Model | Resolution | Duration | Supported Modes | Audio | Reference Limitations |\n| --- | --- | --- | --- | --- | --- |\n| `seedance-2.5` | 480p / 720p / 1080p | 4–30 seconds; edit/extend available -1 smart duration | Visibility, first frame, first and last frame, full-modal reference, edit, extend | Supported | Up to 50 reference items |\n| `seedance-2.0` | 480p / 720p / 1080p / 4K | 4–15 seconds; edit/extend available -1 smart duration | Visibility, first frame, first and last frame, full-modal reference, edit, extend | Supported | Up to 15 reference items |\n| `seedance-2.0-mini` | 480p / 720p | 4–15 seconds | Vincent, first frame, first and last frame | Supported | Does not support full-modal referencing, editing or extension |\n\nSource: [Volcan Ark Video Generation API](https://www.volcengine.com/docs/82379/1520758?lang=zh). The difference between the official website capabilities and the current unopened capabilities of the gateway can be found in this audit report.",
        "tags": [
          "Video generation/Seedance"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "SeedanceVideoCreateRequest",
                "description": "Create a Seedance video task. Parameters are narrowed according to the current Tikway gateway capabilities; for differences between models, see operation description and x-model-capabilities.",
                "type": "object",
                "required": [
                  "model"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "enum": [
                      "seedance-2.5",
                      "seedance-2.0",
                      "seedance-2.0-mini"
                    ],
                    "description": "Seedance model ID."
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Video generation or editing prompt words."
                  },
                  "duration": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": -1,
                        "maximum": 30
                      },
                      {
                        "type": "string",
                        "pattern": "^(?:-1|[4-9]|[12][0-9]|30)$"
                      }
                    ],
                    "description": "Video duration (seconds). 2.0 Mini is 4–15; 2.0 is 4–15; 2.5 is 4–30. When editing or extending a task, you can pass -1 to let the model determine the duration based on the input material."
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": [
                      "adaptive",
                      "16:9",
                      "9:16",
                      "1:1",
                      "4:3",
                      "3:4",
                      "21:9"
                    ],
                    "description": "Video aspect ratio. When producing videos, some models will automatically determine the proportions based on the input material."
                  },
                  "resolution": {
                    "type": "string",
                    "enum": [
                      "480p",
                      "720p",
                      "1080p",
                      "4K"
                    ],
                    "description": "Output resolution. Available values ​​for different models or modes are shown in the model capabilities table."
                  },
                  "frame_images": {
                    "type": "array",
                    "maxItems": 2,
                    "description": "The first frame or the last frame reference picture; at most one of the same type.",
                    "items": {
                      "type": "object",
                      "required": [
                        "type",
                        "image_url"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "first_frame",
                            "last_frame"
                          ],
                          "description": "Reference frame position."
                        },
                        "image_url": {
                          "type": "string",
                          "minLength": 1,
                          "format": "uri",
                          "description": "Reference image URL string."
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "input_references": {
                    "type": "array",
                    "maxItems": 50,
                    "description": "Full modal reference material. 2.0 Mini is not supported; 2.0 has a maximum of 15 items; 2.5 has a maximum of 50 items. Reference mode cannot be mixed with first and last frame modes.",
                    "items": {
                      "type": "object",
                      "oneOf": [
                        {
                          "required": [
                            "image_url"
                          ]
                        },
                        {
                          "required": [
                            "video_url"
                          ]
                        },
                        {
                          "required": [
                            "audio_url"
                          ]
                        }
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "image_url",
                            "video_url",
                            "audio_url"
                          ],
                          "description": "Optional. Material type; if provided, must be consistent with the corresponding URL field."
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "reference_image",
                            "reference_video",
                            "reference_audio",
                            "source_video",
                            "first_clip"
                          ],
                          "description": "Material usage. When omitted, normal reference material is inferred from the URL field."
                        },
                        "image_url": {
                          "type": "string",
                          "minLength": 1,
                          "format": "uri",
                          "description": "Image URL string."
                        },
                        "video_url": {
                          "type": "string",
                          "minLength": 1,
                          "format": "uri",
                          "description": "Video URL string."
                        },
                        "audio_url": {
                          "type": "string",
                          "minLength": 1,
                          "format": "uri",
                          "description": "Audio URL string."
                        },
                        "reference_voice": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Preset patch ID; only used by some models that support patch references."
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "generate_audio": {
                    "type": "boolean",
                    "description": "Supports audio generation; whether it is enabled by default is determined by the model and upstream account configuration."
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": -1,
                    "maximum": 2147483647,
                    "description": "Random seed. Fixed seeds can only improve reproducibility, but do not guarantee that the output will be completely consistent."
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://",
                    "description": "User task callback address. Called by Tikway after the task status changes, it is not directly passed to the model upstream."
                  },
                  "extra_body": {
                    "type": "object",
                    "description": "Seedance upstream extension parameters.",
                    "properties": {
                      "camera_fixed": {
                        "type": "boolean",
                        "description": "Whether to fix the camera."
                      },
                      "watermark": {
                        "type": "boolean",
                        "description": "Whether to add watermark."
                      },
                      "return_last_frame": {
                        "type": "boolean",
                        "description": "Whether to return the last frame in the result."
                      },
                      "omni_reference_task_type": {
                        "type": "string",
                        "enum": [
                          "auto",
                          "reference",
                          "edit",
                          "extend"
                        ],
                        "description": "Fully modal reference task type; editing and extension are set automatically by the gateway."
                      },
                      "output_format": {
                        "type": "string",
                        "enum": [
                          "mp4",
                          "mov"
                        ],
                        "default": "mp4"
                      },
                      "service_tier": {
                        "type": "string",
                        "enum": [
                          "default",
                          "flex"
                        ]
                      },
                      "priority": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false,
                "x-model-capabilities": [
                  {
                    "model": "seedance-2.5",
                    "resolution": "480p / 720p / 1080p",
                    "duration": "4–30 seconds; edit/extend available -1 smart duration",
                    "modes": "Vincent, first frame, first and last frame, full-modal reference, editing, extension",
                    "audio": "support",
                    "references": "Up to 50 references"
                  },
                  {
                    "model": "seedance-2.0",
                    "resolution": "480p / 720p / 1080p / 4K",
                    "duration": "4–15 seconds; edit/extend available -1 smart duration",
                    "modes": "Vincent, first frame, first and last frame, full-modal reference, editing, extension",
                    "audio": "support",
                    "references": "Up to 15 references"
                  },
                  {
                    "model": "seedance-2.0-mini",
                    "resolution": "480p / 720p",
                    "duration": "4–15 seconds",
                    "modes": "Vincent, first frame, first and last frame",
                    "audio": "support",
                    "references": "No support for fully modal referencing, editing or extension"
                  }
                ]
              },
              "examples": {
                "Text to video": {
                  "summary": "Vincent Video",
                  "value": {
                    "model": "seedance-2.5",
                    "prompt": "A golden retriever runs on the beach at sunset. The camera follows smoothly, and the picture has a natural and delicate film quality.",
                    "duration": 8,
                    "resolution": "1080p",
                    "aspect_ratio": "16:9",
                    "generate_audio": true
                  }
                },
                "First frame to video": {
                  "summary": "First frame of raw video",
                  "value": {
                    "model": "seedance-2.0-mini",
                    "prompt": "Keep the character's appearance and clothing consistent in the first frame, let the character walk forward naturally, and the camera advances slowly.",
                    "duration": 5,
                    "resolution": "720p",
                    "frame_images": [
                      {
                        "type": "first_frame",
                        "image_url": "https://example.com/assets/first-frame.jpg"
                      }
                    ]
                  }
                },
                "First and last frame to video": {
                  "summary": "First and last frame video",
                  "value": {
                    "model": "seedance-2.0",
                    "prompt": "Transition naturally from the first frame to the last frame, keeping the subject, composition and visual style coherent.",
                    "duration": 8,
                    "resolution": "1080p",
                    "frame_images": [
                      {
                        "type": "first_frame",
                        "image_url": "https://example.com/assets/first-frame.jpg"
                      },
                      {
                        "type": "last_frame",
                        "image_url": "https://example.com/assets/last-frame.jpg"
                      }
                    ]
                  }
                },
                "Multimodal reference": {
                  "summary": "Full modal reference",
                  "value": {
                    "model": "seedance-2.5",
                    "prompt": "Maintain the identity and visual style of the reference material to produce a coherent, cinematic short film.",
                    "duration": 10,
                    "resolution": "720p",
                    "input_references": [
                      {
                        "image_url": "https://example.com/assets/character.jpg",
                        "role": "reference_image"
                      },
                      {
                        "video_url": "https://example.com/assets/style.mp4",
                        "role": "reference_video"
                      },
                      {
                        "audio_url": "https://example.com/assets/voice.mp3",
                        "role": "reference_audio"
                      }
                    ]
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$id": "https://api.example.com/schemas/videos/create-response.json",
                  "title": "Create a video task response",
                  "description": "POST /v1/videos Response parameters after the video task is successfully created. The interface returns HTTP 202.",
                  "type": "object",
                  "required": [
                    "id",
                    "status",
                    "polling_url"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The unique identifier of the video generation task, used for subsequent query of task status.",
                      "examples": [
                        "9552de3d-171f-4cca-b492-7baa56523239"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "queue"
                      ],
                      "description": "Task creation status. pending means that the task has been created and is waiting for submission; queue means that the task has entered the generation queue.",
                      "examples": [
                        "queue"
                      ]
                    },
                    "polling_url": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://",
                      "description": "Video task query address, the client can poll the task status through GET request.",
                      "examples": [
                        "https://api.example.com/v1/videos/9552de3d-171f-4cca-b492-7baa56523239"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "id": "9552de3d-171f-4cca-b492-7baa56523239",
                  "status": "pending",
                  "polling_url": "https://api.tikway.ai/v1/videos/9552de3d-171f-4cca-b492-7baa56523239"
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/videos/{id}": {
      "get": {
        "summary": "Query Seedance video tasks",
        "deprecated": false,
        "description": "",
        "tags": [
          "Video generation/Seedance"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Unique identifier for the video generation task.",
            "required": true,
            "example": "8f7c2e41-5a93-4b16-9d72-3c84e1a6f205",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-debugger-mode",
            "in": "header",
            "description": "",
            "example": "true",
            "schema": {
              "type": "string",
              "default": "true"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$id": "https://api.example.com/schemas/videos/retrieve-response.json",
                  "title": "Query video task response",
                  "description": "Response parameters for GET /v1/videos/{id}. Data is returned only when the task status is completed.",
                  "type": "object",
                  "required": [
                    "created",
                    "id",
                    "model",
                    "prompt",
                    "status",
                    "usage"
                  ],
                  "properties": {
                    "created": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Video task creation time, Unix timestamp, unit is seconds.",
                      "examples": [
                        1789108566
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The unique identifier of the video generation task.",
                      "examples": [
                        "9552de3d-171f-4cca-b492-7baa56523239"
                      ]
                    },
                    "model": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The model ID used when creating the video task.",
                      "examples": [
                        "seedance-2.0-mini"
                      ]
                    },
                    "prompt": {
                      "type": "string",
                      "description": "Prompt word submitted when creating a video task.",
                      "examples": [
                        "A golden retriever runs on the beach at sunset. The camera follows steadily, and the picture presents a natural and delicate film quality."
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "queue",
                        "in_progress",
                        "completed",
                        "failed",
                        "cancelled",
                        "expired"
                      ],
                      "description": "Task status. pending means waiting for processing; queue means queuing; in_progress means generation or platform processing is in progress; completed means both video and OSS resources have been processed; failed means failure; cancelled means canceled; expired means expired.",
                      "examples": [
                        "in_progress"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "description": "Video task results. Returned only if status is completed.",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "video_url"
                            ],
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "video_url"
                                ],
                                "description": "Platform OSS video"
                              },
                              "video_url": {
                                "type": "string",
                                "format": "uri",
                                "description": "Platform OSS video address, valid for 24 hours"
                              }
                            },
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "native_url"
                            ],
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "native_url"
                                ],
                                "description": "Supplier original video"
                              },
                              "native_url": {
                                "type": "string",
                                "format": "uri",
                                "description": "The original video address returned by the supplier"
                              }
                            },
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "first_url",
                              "last_url"
                            ],
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "frame"
                                ],
                                "description": "Video first and last frames"
                              },
                              "first_url": {
                                "type": "string",
                                "format": "uri",
                                "description": "The address of the first frame of the video, valid for 24 hours"
                              },
                              "last_url": {
                                "type": "string",
                                "format": "uri",
                                "description": "Video last frame address, valid for 24 hours"
                              }
                            },
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "usage": {
                      "type": "object",
                      "description": "Usage information for video tasks.",
                      "required": [
                        "video_seconds"
                      ],
                      "properties": {
                        "video_seconds": {
                          "description": "The duration of the generated video, in seconds. May be null if it cannot be determined at the moment.",
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "examples": [
                            4
                          ]
                        }
                      },
                      "additionalProperties": false
                    },
                    "error": {
                      "type": "object",
                      "description": "Task failure information. Usually only returned if status is failed.",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "description": "Error code returned by the vendor or platform.",
                          "examples": [
                            "video_generation_failed"
                          ]
                        },
                        "message": {
                          "type": "string",
                          "description": "The specific reason why the task failed.",
                          "examples": [
                            "Video generation failed."
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "status": {
                            "const": "completed"
                          }
                        },
                        "required": [
                          "status"
                        ]
                      },
                      "then": {
                        "required": [
                          "data"
                        ]
                      },
                      "else": {
                        "not": {
                          "required": [
                            "data"
                          ]
                        }
                      }
                    }
                  ],
                  "additionalProperties": false
                },
                "examples": {
                  "In progress": {
                    "summary": "In progress",
                    "value": {
                      "created": 1789108566,
                      "id": "9552de3d-171f-4cca-b492-7baa56523239",
                      "model": "seedance-2.5",
                      "prompt": "A golden retriever runs on the beach at sunset. The camera follows steadily, and the sea breeze blows the hair. The picture presents a natural and delicate film texture.",
                      "status": "in_progress",
                      "usage": {
                        "video_seconds": 4
                      }
                    }
                  },
                  "Completed": {
                    "summary": "Completed",
                    "value": {
                      "created": 1789108566,
                      "id": "9552de3d-171f-4cca-b492-7baa56523239",
                      "model": "seedance-2.5",
                      "prompt": "A golden retriever runs on the beach at sunset. The camera follows steadily, and the sea breeze blows the hair. The picture presents a natural and delicate film texture.",
                      "status": "completed",
                      "data": [
                        {
                          "type": "video_url",
                          "video_url": "https://oss.example.com/temp/2026/09/11/video.mp4?expires=86400"
                        },
                        {
                          "type": "native_url",
                          "native_url": "https://provider.example.com/videos/video.mp4?expires=86400"
                        },
                        {
                          "type": "frame",
                          "first_url": "https://oss.example.com/temp/2026/09/11/video.mp4?x-oss-process=video%2Fsnapshot%2Ct_0%2Cf_jpg%2Cw_0%2Ch_0",
                          "last_url": "https://oss.example.com/temp/2026/09/11/video.mp4?x-oss-process=video%2Fsnapshot%2Ct_3999%2Cf_jpg%2Cw_0%2Ch_0"
                        }
                      ],
                      "usage": {
                        "video_seconds": 4
                      }
                    }
                  }
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "webhooks": {},
  "components": {
    "schemas": {},
    "responses": {},
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "https://api.tikway.ai",
      "description": "production environment"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ]
}
