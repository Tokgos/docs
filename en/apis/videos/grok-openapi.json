{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikway Grok Imagine Video Video API",
    "description": "xAI (via TTAPI) OpenAI-compatible asynchronous video generation interface for the Grok Imagine Video model.",
    "version": "1.1.0"
  },
  "tags": [
    {
      "name": "video generation"
    },
    {
      "name": "Video generation/Grok Imagine Video"
    }
  ],
  "paths": {
    "/v1/videos": {
      "post": {
        "summary": "Create a Grok Imagine Video video",
        "deprecated": false,
        "description": "Create Grok Imagine Video video tasks via unified `POST /v1/videos`. Model capabilities are subject to the actual callable range of the current Tikway gateway.\n\n| Model | Resolution | Duration | Supported Modes | Audio | Reference Limitations |\n| --- | --- | --- | --- | --- | --- |\n| `grok-imagine-video-1.5-fast` | 480p / 720p | 6–30 seconds | Vincent, up to 7 picture reference, first and last frames | Upstream defaults to sound; the current unified field cannot be turned off | Unofficial high-speed channel |\n| `grok-imagine-video-1.5` | 480p / 720p / 1080p | 1–15 seconds | The current gateway requires exactly 1 picture; can bring up to 3 preset sounds | Default is sound; the current unified field cannot be turned off | Does not support the last frame |\n| `grok-imagine-video` | 480p / 720p | Generate 1–15 seconds; extend 1–10 seconds | Vincent, multi-image reference, video extension | Upstream has sound by default; the current unified field cannot be turned off | End frame is not supported |\n\nSource: [xAI Video Generation Documentation](https://docs.x.ai/developers/model-capabilities/video/generation). The difference between the official website capabilities and the current unopened capabilities of the gateway can be found in this audit report.",
        "tags": [
          "Video generation/Grok Imagine Video"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "Grok Imagine VideoVideoCreateRequest",
                "description": "Create a Grok Imagine Video video task. Parameters are narrowed according to the current Tikway gateway capabilities; for differences between models, see operation description and x-model-capabilities.",
                "type": "object",
                "required": [
                  "model",
                  "prompt"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "enum": [
                      "grok-imagine-video-1.5",
                      "grok-imagine-video"
                    ],
                    "description": "Grok Imagine Video Model ID."
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Video generation or editing prompt words."
                  },
                  "duration": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30,
                    "description": "Model related: 6–30 seconds for 1.5 Fast; 1–15 seconds for 1.5 and Basic; 1–10 seconds for Basic video extension."
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": [
                      "2:3",
                      "3:2",
                      "1:1",
                      "9:16",
                      "16:9"
                    ],
                    "description": "Video aspect ratio. When producing videos, some models will automatically determine the proportions based on the input material."
                  },
                  "resolution": {
                    "type": "string",
                    "enum": [
                      "480p",
                      "720p",
                      "1080p"
                    ],
                    "description": "Output resolution. Available values ​​for different models or modes are shown in the model capabilities table."
                  },
                  "frame_images": {
                    "type": "array",
                    "maxItems": 2,
                    "description": "1.5 Fast supports the first and last frames; 1.5 and the basic version can only use one picture as the first frame and cannot pass last_frame.",
                    "items": {
                      "type": "object",
                      "required": [
                        "type",
                        "image_url"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "first_frame",
                            "last_frame"
                          ],
                          "description": "Reference frame position."
                        },
                        "image_url": {
                          "type": "string",
                          "minLength": 1,
                          "format": "uri",
                          "description": "Reference image URL string."
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "input_references": {
                    "type": "array",
                    "maxItems": 7,
                    "description": "The maximum number of picture references is 7; 1.5 current routing requires exactly 1 picture. The video is only available as an extension for the basic version. 1.5 Up to 3 reference_audio can be transmitted, and the default voice_id is filled in reference_voice; audio_url is only used as a unified protocol placeholder.",
                    "items": {
                      "type": "object",
                      "oneOf": [
                        {
                          "required": [
                            "image_url"
                          ]
                        },
                        {
                          "required": [
                            "video_url"
                          ]
                        },
                        {
                          "required": [
                            "audio_url"
                          ]
                        }
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "image_url",
                            "video_url",
                            "audio_url"
                          ],
                          "description": "Optional. Material type; if provided, must be consistent with the corresponding URL field."
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "reference_image",
                            "source_video",
                            "first_clip",
                            "reference_audio"
                          ],
                          "description": "Material usage. When omitted, normal reference material is inferred from the URL field."
                        },
                        "image_url": {
                          "type": "string",
                          "minLength": 1,
                          "format": "uri",
                          "description": "Image URL string."
                        },
                        "video_url": {
                          "type": "string",
                          "minLength": 1,
                          "format": "uri",
                          "description": "Video URL string."
                        },
                        "audio_url": {
                          "type": "string",
                          "minLength": 1,
                          "format": "uri",
                          "description": "Audio URL string."
                        },
                        "reference_voice": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Preset patch ID; only used by some models that support patch references."
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://",
                    "description": "User task callback address. Called by Tikway after the task status changes, it is not directly passed to the model upstream."
                  },
                  "extra_body": {
                    "type": "object",
                    "description": "Grok TTAPI extension parameters. It is recommended to use unified fields first.",
                    "properties": {},
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false,
                "x-model-capabilities": [
                  {
                    "model": "grok-imagine-video-1.5-fast",
                    "resolution": "480p / 720p",
                    "duration": "6–30 seconds",
                    "modes": "Vincent, up to 7 picture references, first and last frames",
                    "audio": "The upstream has sound by default; the current unified field cannot be turned off",
                    "references": "unofficial highway"
                  },
                  {
                    "model": "grok-imagine-video-1.5",
                    "resolution": "480p / 720p / 1080p",
                    "duration": "1–15 seconds",
                    "modes": "The current gateway requires exactly 1 picture; can bring up to 3 preset sounds",
                    "audio": "Sound is enabled by default; the current unified field cannot be turned off",
                    "references": "End frames are not supported"
                  },
                  {
                    "model": "grok-imagine-video",
                    "resolution": "480p / 720p",
                    "duration": "Generate 1–15 seconds; extend 1–10 seconds",
                    "modes": "Vincent, multiple picture reference, video extension",
                    "audio": "The upstream has sound by default; the current unified field cannot be turned off",
                    "references": "End frames are not supported"
                  }
                ]
              },
              "examples": {
                "Fast text to video": {
                  "summary": "Quick Vincent Video",
                  "value": {
                    "model": "grok-imagine-video-1.5-fast",
                    "prompt": "A golden retriever runs on the beach at sunset. The camera follows smoothly, and the picture has a natural and delicate film quality.",
                    "duration": 10,
                    "resolution": "720p",
                    "aspect_ratio": "16:9"
                  }
                },
                "1080p first frame to video": {
                  "summary": "1080p first frame raw video",
                  "value": {
                    "model": "grok-imagine-video-1.5",
                    "prompt": "Keep the character's appearance and clothing consistent in the first frame, let the character walk forward naturally, and the camera advances slowly.",
                    "duration": 10,
                    "resolution": "1080p",
                    "aspect_ratio": "16:9",
                    "frame_images": [
                      {
                        "type": "first_frame",
                        "image_url": "https://example.com/assets/first-frame.jpg"
                      }
                    ]
                  }
                },
                "First and last frame to video": {
                  "summary": "First and last frame video",
                  "value": {
                    "model": "grok-imagine-video-1.5-fast",
                    "prompt": "Transition naturally from the first frame to the last frame, keeping the subject, composition and visual style coherent.",
                    "duration": 10,
                    "resolution": "720p",
                    "aspect_ratio": "16:9",
                    "frame_images": [
                      {
                        "type": "first_frame",
                        "image_url": "https://example.com/assets/first-frame.jpg"
                      },
                      {
                        "type": "last_frame",
                        "image_url": "https://example.com/assets/last-frame.jpg"
                      }
                    ]
                  }
                },
                "Video extension": {
                  "summary": "video extension",
                  "value": {
                    "model": "grok-imagine-video",
                    "prompt": "Continue the camera movement, subject movement and lighting of the original video, allowing the scene to develop backwards naturally.",
                    "duration": 6,
                    "resolution": "720p",
                    "input_references": [
                      {
                        "video_url": "https://example.com/assets/source.mp4",
                        "role": "first_clip"
                      }
                    ]
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$id": "https://api.example.com/schemas/videos/create-response.json",
                  "title": "Create a video task response",
                  "description": "POST /v1/videos Response parameters after the video task is successfully created. The interface returns HTTP 202.",
                  "type": "object",
                  "required": [
                    "id",
                    "status",
                    "polling_url"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The unique identifier of the video generation task, used for subsequent query of task status.",
                      "examples": [
                        "9552de3d-171f-4cca-b492-7baa56523239"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "queue"
                      ],
                      "description": "Task creation status. pending means that the task has been created and is waiting for submission; queue means that the task has entered the generation queue.",
                      "examples": [
                        "queue"
                      ]
                    },
                    "polling_url": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://",
                      "description": "Video task query address, the client can poll the task status through GET request.",
                      "examples": [
                        "https://api.example.com/v1/videos/9552de3d-171f-4cca-b492-7baa56523239"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "id": "9552de3d-171f-4cca-b492-7baa56523239",
                  "status": "pending",
                  "polling_url": "https://api.tikway.ai/v1/videos/9552de3d-171f-4cca-b492-7baa56523239"
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/videos/{id}": {
      "get": {
        "summary": "Query Grok Imagine Video video tasks",
        "deprecated": false,
        "description": "",
        "tags": [
          "Video generation/Grok Imagine Video"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Unique identifier for the video generation task.",
            "required": true,
            "example": "8f7c2e41-5a93-4b16-9d72-3c84e1a6f205",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-debugger-mode",
            "in": "header",
            "description": "",
            "example": "true",
            "schema": {
              "type": "string",
              "default": "true"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$id": "https://api.example.com/schemas/videos/retrieve-response.json",
                  "title": "Query video task response",
                  "description": "Response parameters for GET /v1/videos/{id}. Data is returned only when the task status is completed.",
                  "type": "object",
                  "required": [
                    "created",
                    "id",
                    "model",
                    "prompt",
                    "status",
                    "usage"
                  ],
                  "properties": {
                    "created": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Video task creation time, Unix timestamp, unit is seconds.",
                      "examples": [
                        1789108566
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The unique identifier of the video generation task.",
                      "examples": [
                        "9552de3d-171f-4cca-b492-7baa56523239"
                      ]
                    },
                    "model": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The model ID used when creating the video task.",
                      "examples": [
                        "bytedance/seedance-2.0-mini"
                      ]
                    },
                    "prompt": {
                      "type": "string",
                      "description": "Prompt word submitted when creating a video task.",
                      "examples": [
                        "A golden retriever runs on the beach at sunset. The camera follows steadily, and the picture presents a natural and delicate film quality."
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "queue",
                        "in_progress",
                        "completed",
                        "failed",
                        "cancelled",
                        "expired"
                      ],
                      "description": "Task status. pending means waiting for processing; queue means queuing; in_progress means generation or platform processing is in progress; completed means both video and OSS resources have been processed; failed means failure; cancelled means canceled; expired means expired.",
                      "examples": [
                        "in_progress"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "description": "Video task results. Returned only if status is completed.",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "video_url"
                            ],
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "video_url"
                                ],
                                "description": "Platform OSS video"
                              },
                              "video_url": {
                                "type": "string",
                                "format": "uri",
                                "description": "Platform OSS video address, valid for 24 hours"
                              }
                            },
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "native_url"
                            ],
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "native_url"
                                ],
                                "description": "Supplier original video"
                              },
                              "native_url": {
                                "type": "string",
                                "format": "uri",
                                "description": "The original video address returned by the supplier"
                              }
                            },
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "first_url",
                              "last_url"
                            ],
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "frame"
                                ],
                                "description": "Video first and last frames"
                              },
                              "first_url": {
                                "type": "string",
                                "format": "uri",
                                "description": "The address of the first frame of the video, valid for 24 hours"
                              },
                              "last_url": {
                                "type": "string",
                                "format": "uri",
                                "description": "Video last frame address, valid for 24 hours"
                              }
                            },
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "usage": {
                      "type": "object",
                      "description": "Usage information for video tasks.",
                      "required": [
                        "video_seconds"
                      ],
                      "properties": {
                        "video_seconds": {
                          "description": "The duration of the generated video, in seconds. May be null if it cannot be determined at the moment.",
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "examples": [
                            4
                          ]
                        }
                      },
                      "additionalProperties": false
                    },
                    "error": {
                      "type": "object",
                      "description": "Task failure information. Usually only returned if status is failed.",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "description": "Error code returned by the vendor or platform.",
                          "examples": [
                            "video_generation_failed"
                          ]
                        },
                        "message": {
                          "type": "string",
                          "description": "The specific reason why the task failed.",
                          "examples": [
                            "Video generation failed."
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "status": {
                            "const": "completed"
                          }
                        },
                        "required": [
                          "status"
                        ]
                      },
                      "then": {
                        "required": [
                          "data"
                        ]
                      },
                      "else": {
                        "not": {
                          "required": [
                            "data"
                          ]
                        }
                      }
                    }
                  ],
                  "additionalProperties": false
                },
                "examples": {
                  "In progress": {
                    "summary": "In progress",
                    "value": {
                      "created": 1789108566,
                      "id": "9552de3d-171f-4cca-b492-7baa56523239",
                      "model": "grok-imagine-video-1.5-fast",
                      "prompt": "A golden retriever runs on the beach at sunset. The camera follows steadily, and the sea breeze blows the hair. The picture presents a natural and delicate film texture.",
                      "status": "in_progress",
                      "usage": {
                        "video_seconds": 4
                      }
                    }
                  },
                  "Completed": {
                    "summary": "Completed",
                    "value": {
                      "created": 1789108566,
                      "id": "9552de3d-171f-4cca-b492-7baa56523239",
                      "model": "grok-imagine-video-1.5-fast",
                      "prompt": "A golden retriever runs on the beach at sunset. The camera follows steadily, and the sea breeze blows the hair. The picture presents a natural and delicate film texture.",
                      "status": "completed",
                      "data": [
                        {
                          "type": "video_url",
                          "video_url": "https://oss.example.com/temp/2026/09/11/video.mp4?expires=86400"
                        },
                        {
                          "type": "native_url",
                          "native_url": "https://provider.example.com/videos/video.mp4?expires=86400"
                        },
                        {
                          "type": "frame",
                          "first_url": "https://oss.example.com/temp/2026/09/11/video.mp4?x-oss-process=video%2Fsnapshot%2Ct_0%2Cf_jpg%2Cw_0%2Ch_0",
                          "last_url": "https://oss.example.com/temp/2026/09/11/video.mp4?x-oss-process=video%2Fsnapshot%2Ct_3999%2Cf_jpg%2Cw_0%2Ch_0"
                        }
                      ],
                      "usage": {
                        "video_seconds": 4
                      }
                    }
                  }
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "webhooks": {},
  "components": {
    "schemas": {},
    "responses": {},
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "https://api.tikway.ai",
      "description": "production environment"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ]
}
