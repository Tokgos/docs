{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikway Veo Video API",
    "description": "OpenAI-compatible asynchronous video generation interface for Google's (via TTAPI) Veo model.",
    "version": "1.1.0"
  },
  "tags": [
    {
      "name": "video generation"
    },
    {
      "name": "Video generation/Veo"
    }
  ],
  "paths": {
    "/v1/videos": {
      "post": {
        "summary": "Create a Veo video",
        "deprecated": false,
        "description": "Create Veo video tasks via unified `POST /v1/videos`. Model capabilities are subject to the actual callable range of the current Tikway gateway.\n\n| Model | Resolution | Duration | Supported Modes | Audio | Reference Limitations |\n| --- | --- | --- | --- | --- | --- |\n| `veo-3.1-fast` | 720p / 1080p | Current gateway is fixed for 8 seconds | Vincent, first frame, first and last frame, up to 3 picture references | Always generated, cannot be turned off | Unified entrance that does not support video input/extension |\n| `veo-3.1-quality` | 720p / 1080p | Current gateway is fixed for 8 seconds | Vincent, first frame, first and last frame, up to 3 picture references | Always generated, cannot be turned off | Unified entry for video input/extension is not supported |\n| `veo-3.1-lite` | 720p / 1080p | The current gateway is fixed for 8 seconds | Vincent, first frame, first and last frame; does not support ordinary reference picture mode | Always generated, cannot be turned off | Unified entrance of video input/extension is not supported |\n\nSource: [Google Veo 3.1 API](https://ai.google.dev/gemini-api/docs/veo?hl=en). The difference between the official website capabilities and the current unopened capabilities of the gateway can be found in this audit report.",
        "tags": [
          "Video generation/Veo"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "VeoVideoCreateRequest",
                "description": "Create a Veo video task. Parameters are narrowed according to the current Tikway gateway capabilities; for differences between models, see operation description and x-model-capabilities.",
                "type": "object",
                "required": [
                  "model",
                  "prompt"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "enum": [
                      "veo-3.1-fast",
                      "veo-3.1-quality",
                      "veo-3.1-lite"
                    ],
                    "description": "Veo model ID."
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Video generation or editing prompt words."
                  },
                  "duration": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "const": 8
                      },
                      {
                        "type": "string",
                        "const": "8"
                      }
                    ],
                    "description": "The current Tikway route generates a fixed 8-second video. Google native Veo 3.1 also supports 4 seconds and 6 seconds, but the gateway is not currently open."
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": [
                      "16:9",
                      "9:16"
                    ],
                    "description": "Video aspect ratio. When producing videos, some models will automatically determine the proportions based on the input material."
                  },
                  "resolution": {
                    "type": "string",
                    "enum": [
                      "720p",
                      "1080p"
                    ],
                    "description": "Output resolution. Available values ​​for different models or modes are shown in the model capabilities table."
                  },
                  "frame_images": {
                    "type": "array",
                    "maxItems": 2,
                    "description": "The first frame or the last frame reference picture; at most one of the same type.",
                    "items": {
                      "type": "object",
                      "required": [
                        "type",
                        "image_url"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "first_frame",
                            "last_frame"
                          ],
                          "description": "Reference frame position."
                        },
                        "image_url": {
                          "type": "string",
                          "minLength": 1,
                          "format": "uri",
                          "description": "Reference image URL string."
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "input_references": {
                    "type": "array",
                    "maxItems": 3,
                    "description": "Maximum 3 reference images. Veo 3.1 Lite does not support normal reference image mode; please use frame_images for the first and last frames.",
                    "items": {
                      "type": "object",
                      "oneOf": [
                        {
                          "required": [
                            "image_url"
                          ]
                        }
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "image_url"
                          ],
                          "description": "Optional. Material type; if provided, must be consistent with the corresponding URL field."
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "reference_image"
                          ],
                          "description": "Material usage. When omitted, normal reference material is inferred from the URL field."
                        },
                        "image_url": {
                          "type": "string",
                          "minLength": 1,
                          "format": "uri",
                          "description": "Image URL string."
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://",
                    "description": "User task callback address. Called by Tikway after the task status changes, it is not directly passed to the model upstream."
                  },
                  "extra_body": {
                    "type": "object",
                    "description": "TTAPI Veo extension parameters. Usually no setting is required, the gateway will automatically select generation_type based on frame_images or input_references.",
                    "properties": {
                      "generation_type": {
                        "type": "string",
                        "enum": [
                          "frame",
                          "reference"
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false,
                "x-model-capabilities": [
                  {
                    "model": "veo-3.1-fast",
                    "resolution": "720p / 1080p",
                    "duration": "The current gateway is fixed for 8 seconds",
                    "modes": "Vincent, first frame, first and last frame, up to 3 pictures for reference",
                    "audio": "Always generated and cannot be closed",
                    "references": "Unified entry that does not support video input/extension"
                  },
                  {
                    "model": "veo-3.1-quality",
                    "resolution": "720p / 1080p",
                    "duration": "The current gateway is fixed for 8 seconds",
                    "modes": "Vincent, first frame, first and last frame, up to 3 pictures for reference",
                    "audio": "Always generated and cannot be closed",
                    "references": "Unified entry that does not support video input/extension"
                  },
                  {
                    "model": "veo-3.1-lite",
                    "resolution": "720p / 1080p",
                    "duration": "The current gateway is fixed for 8 seconds",
                    "modes": "Vincent, first frame, first and last frame; does not support ordinary reference picture mode",
                    "audio": "Always generated and cannot be closed",
                    "references": "Unified entry that does not support video input/extension"
                  }
                ]
              },
              "examples": {
                "Text to video": {
                  "summary": "Vincent Video",
                  "value": {
                    "model": "veo-3.1-fast",
                    "prompt": "A golden retriever runs on the beach at sunset. The camera follows smoothly, and the picture has a natural and delicate film quality.",
                    "duration": 8,
                    "resolution": "1080p",
                    "aspect_ratio": "16:9"
                  }
                },
                "First and last frame to video": {
                  "summary": "First and last frame video",
                  "value": {
                    "model": "veo-3.1-quality",
                    "prompt": "Transition naturally from the first frame to the last frame, keeping the subject, composition and visual style coherent.",
                    "duration": 8,
                    "resolution": "1080p",
                    "aspect_ratio": "16:9",
                    "frame_images": [
                      {
                        "type": "first_frame",
                        "image_url": "https://example.com/assets/first-frame.jpg"
                      },
                      {
                        "type": "last_frame",
                        "image_url": "https://example.com/assets/last-frame.jpg"
                      }
                    ]
                  }
                },
                "Reference to video": {
                  "summary": "Reference student video",
                  "value": {
                    "model": "veo-3.1-quality",
                    "prompt": "Maintain the identity and visual style of the reference material to produce a coherent, cinematic short film.",
                    "duration": 8,
                    "resolution": "720p",
                    "aspect_ratio": "9:16",
                    "input_references": [
                      {
                        "image_url": "https://example.com/assets/character.jpg",
                        "role": "reference_image"
                      },
                      {
                        "image_url": "https://example.com/assets/product.jpg",
                        "role": "reference_image"
                      }
                    ]
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$id": "https://api.example.com/schemas/videos/create-response.json",
                  "title": "Create a video task response",
                  "description": "POST /v1/videos Response parameters after the video task is successfully created. The interface returns HTTP 202.",
                  "type": "object",
                  "required": [
                    "id",
                    "status",
                    "polling_url"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The unique identifier of the video generation task, used for subsequent query of task status.",
                      "examples": [
                        "9552de3d-171f-4cca-b492-7baa56523239"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "queue"
                      ],
                      "description": "Task creation status. pending means that the task has been created and is waiting for submission; queue means that the task has entered the generation queue.",
                      "examples": [
                        "queue"
                      ]
                    },
                    "polling_url": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://",
                      "description": "Video task query address, the client can poll the task status through GET request.",
                      "examples": [
                        "https://api.example.com/v1/videos/9552de3d-171f-4cca-b492-7baa56523239"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "id": "9552de3d-171f-4cca-b492-7baa56523239",
                  "status": "pending",
                  "polling_url": "https://api.tikway.ai/v1/videos/9552de3d-171f-4cca-b492-7baa56523239"
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/videos/{id}": {
      "get": {
        "summary": "Query Veo video tasks",
        "deprecated": false,
        "description": "",
        "tags": [
          "Video generation/Veo"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Unique identifier for the video generation task.",
            "required": true,
            "example": "8f7c2e41-5a93-4b16-9d72-3c84e1a6f205",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-debugger-mode",
            "in": "header",
            "description": "",
            "example": "true",
            "schema": {
              "type": "string",
              "default": "true"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$id": "https://api.example.com/schemas/videos/retrieve-response.json",
                  "title": "Query video task response",
                  "description": "Response parameters for GET /v1/videos/{id}. Data is returned only when the task status is completed.",
                  "type": "object",
                  "required": [
                    "created",
                    "id",
                    "model",
                    "prompt",
                    "status",
                    "usage"
                  ],
                  "properties": {
                    "created": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Video task creation time, Unix timestamp, unit is seconds.",
                      "examples": [
                        1789108566
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The unique identifier of the video generation task.",
                      "examples": [
                        "9552de3d-171f-4cca-b492-7baa56523239"
                      ]
                    },
                    "model": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The model ID used when creating the video task.",
                      "examples": [
                        "bytedance/seedance-2.0-mini"
                      ]
                    },
                    "prompt": {
                      "type": "string",
                      "description": "Prompt word submitted when creating a video task.",
                      "examples": [
                        "A golden retriever runs on the beach at sunset. The camera follows steadily, and the picture presents a natural and delicate film quality."
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "queue",
                        "in_progress",
                        "completed",
                        "failed",
                        "cancelled",
                        "expired"
                      ],
                      "description": "Task status. pending means waiting for processing; queue means queuing; in_progress means generation or platform processing is in progress; completed means both video and OSS resources have been processed; failed means failure; cancelled means canceled; expired means expired.",
                      "examples": [
                        "in_progress"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "description": "Video task results. Returned only if status is completed.",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "video_url"
                            ],
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "video_url"
                                ],
                                "description": "Platform OSS video"
                              },
                              "video_url": {
                                "type": "string",
                                "format": "uri",
                                "description": "Platform OSS video address, valid for 24 hours"
                              }
                            },
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "native_url"
                            ],
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "native_url"
                                ],
                                "description": "Supplier original video"
                              },
                              "native_url": {
                                "type": "string",
                                "format": "uri",
                                "description": "The original video address returned by the supplier"
                              }
                            },
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "first_url",
                              "last_url"
                            ],
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "frame"
                                ],
                                "description": "Video first and last frames"
                              },
                              "first_url": {
                                "type": "string",
                                "format": "uri",
                                "description": "The address of the first frame of the video, valid for 24 hours"
                              },
                              "last_url": {
                                "type": "string",
                                "format": "uri",
                                "description": "Video last frame address, valid for 24 hours"
                              }
                            },
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "usage": {
                      "type": "object",
                      "description": "Usage information for video tasks.",
                      "required": [
                        "video_seconds"
                      ],
                      "properties": {
                        "video_seconds": {
                          "description": "The duration of the generated video, in seconds. May be null if it cannot be determined at the moment.",
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "examples": [
                            4
                          ]
                        }
                      },
                      "additionalProperties": false
                    },
                    "error": {
                      "type": "object",
                      "description": "Task failure information. Usually only returned if status is failed.",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "description": "Error code returned by the vendor or platform.",
                          "examples": [
                            "video_generation_failed"
                          ]
                        },
                        "message": {
                          "type": "string",
                          "description": "The specific reason why the task failed.",
                          "examples": [
                            "Video generation failed."
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "status": {
                            "const": "completed"
                          }
                        },
                        "required": [
                          "status"
                        ]
                      },
                      "then": {
                        "required": [
                          "data"
                        ]
                      },
                      "else": {
                        "not": {
                          "required": [
                            "data"
                          ]
                        }
                      }
                    }
                  ],
                  "additionalProperties": false
                },
                "examples": {
                  "In progress": {
                    "summary": "In progress",
                    "value": {
                      "created": 1789108566,
                      "id": "9552de3d-171f-4cca-b492-7baa56523239",
                      "model": "veo-3.1-fast",
                      "prompt": "A golden retriever runs on the beach at sunset. The camera follows steadily, and the sea breeze blows the hair. The picture presents a natural and delicate film texture.",
                      "status": "in_progress",
                      "usage": {
                        "video_seconds": 4
                      }
                    }
                  },
                  "Completed": {
                    "summary": "Completed",
                    "value": {
                      "created": 1789108566,
                      "id": "9552de3d-171f-4cca-b492-7baa56523239",
                      "model": "veo-3.1-fast",
                      "prompt": "A golden retriever runs on the beach at sunset. The camera follows steadily, and the sea breeze blows the hair. The picture presents a natural and delicate film texture.",
                      "status": "completed",
                      "data": [
                        {
                          "type": "video_url",
                          "video_url": "https://oss.example.com/temp/2026/09/11/video.mp4?expires=86400"
                        },
                        {
                          "type": "native_url",
                          "native_url": "https://provider.example.com/videos/video.mp4?expires=86400"
                        },
                        {
                          "type": "frame",
                          "first_url": "https://oss.example.com/temp/2026/09/11/video.mp4?x-oss-process=video%2Fsnapshot%2Ct_0%2Cf_jpg%2Cw_0%2Ch_0",
                          "last_url": "https://oss.example.com/temp/2026/09/11/video.mp4?x-oss-process=video%2Fsnapshot%2Ct_3999%2Cf_jpg%2Cw_0%2Ch_0"
                        }
                      ],
                      "usage": {
                        "video_seconds": 4
                      }
                    }
                  }
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "webhooks": {},
  "components": {
    "schemas": {},
    "responses": {},
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "https://api.tikway.ai",
      "description": "production environment"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ]
}
