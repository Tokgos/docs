{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikway Transcriptions API",
    "description": "OpenAI-compatible audio transcription through the Tikway gateway.",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "Speech transcription"
    }
  ],
  "paths": {
    "/v1/audio/transcriptions": {
      "post": {
        "summary": "Speech transcription",
        "deprecated": false,
        "description": "",
        "tags": [
          "Speech transcription"
        ],
        "parameters": [],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "encoding": {
                "file": {
                  "contentType": ""
                },
                "model": {
                  "contentType": ""
                },
                "language": {
                  "contentType": ""
                },
                "languages": {
                  "contentType": ""
                },
                "prompt": {
                  "contentType": ""
                },
                "keywords": {
                  "contentType": ""
                },
                "response_format": {
                  "contentType": ""
                },
                "temperature": {
                  "contentType": ""
                },
                "stream": {
                  "contentType": ""
                },
                "chunking_strategy": {
                  "contentType": ""
                },
                "known_speaker_names": {
                  "contentType": ""
                },
                "known_speaker_references": {
                  "contentType": ""
                }
              },
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "format": "binary",
                    "type": "string",
                    "description": "Audio file to be transcribed.",
                    "example": ""
                  },
                  "model": {
                    "format": "binary",
                    "type": "string",
                    "description": "Speech transcription model ID.",
                    "example": "gpt-4o-transcribe"
                  },
                  "language": {
                    "description": "Enter the audio language, ISO 639-1 language codes are recommended.",
                    "example": "zh",
                    "type": "string"
                  },
                  "languages": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Possible language codes.",
                    "example": "zh,en"
                  },
                  "prompt": {
                    "description": "Prompt words to guide transcription style, terminology, and context.",
                    "example": "Meeting Minutes Terminology: Tikway",
                    "type": "string"
                  },
                  "keywords": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "A word or phrase that needs to be identified.",
                    "example": "Tikway,API"
                  },
                  "response_format": {
                    "description": "Response format.",
                    "example": "json",
                    "type": "string"
                  },
                  "temperature": {
                    "description": "Sampling temperature.",
                    "example": "0",
                    "type": "string"
                  },
                  "stream": {
                    "type": "number",
                    "description": "Whether to use SSE streaming returns.",
                    "example": "false"
                  },
                  "chunking_strategy": {
                    "type": "boolean",
                    "description": "Chunking strategy.",
                    "example": "auto"
                  },
                  "known_speaker_names": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Known speaker name.",
                    "example": "Alice,Bob"
                  },
                  "known_speaker_references": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Audio Base64 data URL of known speaker.",
                    "example": "data:audio/wav;base64,UklGRg=="
                  }
                },
                "required": [
                  "file",
                  "model"
                ]
              },
              "example": {
                "file": "",
                "model": "gpt-4o-transcribe",
                "language": "zh",
                "languages": "zh,en",
                "prompt": "Meeting Minutes Terminology: Tikway",
                "keywords": "Tikway,API",
                "response_format": "json",
                "temperature": "0",
                "stream": "false",
                "chunking_strategy": "auto",
                "known_speaker_names": "Alice,Bob",
                "known_speaker_references": "data:audio/wav;base64,UklGRg=="
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "title": "AudioTranscriptionJsonResponse",
                  "description": "Non-streaming speech transcription JSON response. Compatible with ordinary transcription, detailed timestamp transcription and speaker separation results.",
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "task": {
                      "type": "string",
                      "const": "transcribe",
                      "description": "Task type. Verbose JSON and speaker-detached responses typically return this field."
                    },
                    "language": {
                      "type": "string",
                      "description": "Audio language detected or used."
                    },
                    "duration": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Audio duration, in seconds."
                    },
                    "text": {
                      "type": "string",
                      "description": "Transcribe the text completely."
                    },
                    "words": {
                      "type": "array",
                      "description": "Word-level timestamp, returned only when word granularity is requested.",
                      "items": {
                        "type": "object",
                        "additionalProperties": true,
                        "required": [
                          "word",
                          "start",
                          "end"
                        ],
                        "properties": {
                          "word": {
                            "type": "string"
                          },
                          "start": {
                            "type": "number",
                            "minimum": 0
                          },
                          "end": {
                            "type": "number",
                            "minimum": 0
                          }
                        }
                      }
                    },
                    "segments": {
                      "type": "array",
                      "description": "Transcribe the results in segments. verbose_json returns timestamp segments; diarized_json also returns speaker information.",
                      "items": {
                        "type": "object",
                        "additionalProperties": true,
                        "required": [
                          "start",
                          "end",
                          "text"
                        ],
                        "properties": {
                          "type": {
                            "type": "string",
                            "description": "Speaker separation segments are usually fixed to transcript.text.segment."
                          },
                          "id": {
                            "oneOf": [
                              {
                                "type": "integer"
                              },
                              {
                                "type": "string"
                              }
                            ]
                          },
                          "seek": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "start": {
                            "type": "number",
                            "minimum": 0
                          },
                          "end": {
                            "type": "number",
                            "minimum": 0
                          },
                          "text": {
                            "type": "string"
                          },
                          "speaker": {
                            "type": "string",
                            "description": "Speaker name or system-generated speaker label."
                          },
                          "tokens": {
                            "type": "array",
                            "items": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "temperature": {
                            "type": "number"
                          },
                          "avg_logprob": {
                            "type": "number"
                          },
                          "compression_ratio": {
                            "type": "number"
                          },
                          "no_speech_prob": {
                            "type": "number"
                          }
                        }
                      }
                    },
                    "logprobs": {
                      "type": "array",
                      "description": "May be returned when requesting include[]=logprobs.",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "token",
                          "logprob",
                          "bytes"
                        ],
                        "properties": {
                          "token": {
                            "type": "string"
                          },
                          "logprob": {
                            "type": "number"
                          },
                          "bytes": {
                            "type": "array",
                            "items": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 255
                            }
                          }
                        }
                      }
                    },
                    "usage": {
                      "description": "The token or audio duration usage returned by the upstream.",
                      "oneOf": [
                        {
                          "title": "TokenUsage",
                          "type": "object",
                          "additionalProperties": true,
                          "required": [
                            "type",
                            "input_tokens",
                            "output_tokens",
                            "total_tokens"
                          ],
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "tokens"
                            },
                            "input_tokens": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "input_token_details": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "text_tokens": {
                                  "type": "integer",
                                  "minimum": 0
                                },
                                "audio_tokens": {
                                  "type": "integer",
                                  "minimum": 0
                                }
                              }
                            },
                            "output_tokens": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "total_tokens": {
                              "type": "integer",
                              "minimum": 0
                            }
                          }
                        },
                        {
                          "title": "DurationUsage",
                          "type": "object",
                          "additionalProperties": true,
                          "required": [
                            "type",
                            "seconds"
                          ],
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "duration"
                            },
                            "seconds": {
                              "type": "number",
                              "minimum": 0
                            }
                          }
                        }
                      ]
                    }
                  },
                  "examples": [
                    {
                      "text": "Today's meeting mainly discussed the release time of the new version.",
                      "usage": {
                        "type": "tokens",
                        "input_tokens": 120,
                        "input_token_details": {
                          "text_tokens": 0,
                          "audio_tokens": 120
                        },
                        "output_tokens": 18,
                        "total_tokens": 138
                      }
                    }
                  ]
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "webhooks": {},
  "components": {
    "schemas": {},
    "responses": {},
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "https://api.tikway.ai",
      "description": "production environment"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ]
}
