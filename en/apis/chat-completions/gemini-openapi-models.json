{
  "openapi": "3.1.0",
  "info": {
    "title": "Gemini model list",
    "description": "List all callable platform models in the Gemini format, including aliases, architecture, and capabilities.",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "Chat completions"
    },
    {
      "name": "Chat completions/Gemini protocol"
    }
  ],
  "paths": {
    "/v1beta/models": {
      "get": {
        "summary": "Get Models",
        "deprecated": false,
        "description": "Return the same full callable model catalog as GET /v1/models across providers and text, image, video, audio, embedding, and decision models. No implicit protocol filtering is applied. The native response envelope and pagination remain available; provider, mode, and type filters are explicit.\n\nEach model includes aliases, architecture, capabilities.endpoints, capabilities.parameters, and capabilities.reasoning_efforts, matching the OpenAI list. Merge common with the endpoint parameter array for its complete parameter set. Catalog inclusion does not imply support for generation through this protocol; use capabilities.endpoints.",
        "operationId": "getModels",
        "tags": [
          "Chat completions/Gemini protocol"
        ],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Filter by model type, or omit to include all types. Supports text/image/video/music/embedding, ignoring case and surrounding whitespace. Separate multiple types with commas or repeat type to combine them with OR. Unknown or empty values return 400.",
            "required": false,
            "example": "image,video",
            "schema": {
              "type": "string",
              "minLength": 1,
              "examples": [
                "text",
                "image",
                "video",
                "music",
                "embedding",
                "image,video"
              ]
            }
          },
          {
            "name": "x-provider-route",
            "in": "header",
            "description": "Upstream routing preference: cost, stable, or fast.",
            "example": "cost",
            "schema": {
              "type": "string",
              "default": "cost"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The currently callable model catalog. Example capability values illustrate the response structure; use the values returned by the API.",
            "content": {
              "application/json": {
                "schema": {
                  "title": "GeminiModelsResponse",
                  "description": "HTTP 200 response for GET /v1beta/models. Includes the same model catalog as the OpenAI list, with Gemini pagination. Use capabilities.endpoints to identify callable APIs.",
                  "type": "object",
                  "required": [
                    "models"
                  ],
                  "properties": {
                    "models": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "name",
                          "baseModelId",
                          "version",
                          "displayName",
                          "description",
                          "inputTokenLimit",
                          "contextLength",
                          "supportedParameters",
                          "supportedGenerationMethods",
                          "thinking",
                          "aliases",
                          "architecture",
                          "capabilities"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "pattern": "^models/.+",
                            "description": "models/ followed by the full platform model ID, for example models/google/gemini-3.8-flash. The provider namespace is preserved to distinguish models with the same name.",
                            "minLength": 8
                          },
                          "baseModelId": {
                            "type": "string",
                            "description": "Base model ID without the provider namespace."
                          },
                          "version": {
                            "type": "string",
                            "description": "Version string derived from the model ID, or unknown when it cannot be determined."
                          },
                          "displayName": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "inputTokenLimit": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0,
                            "description": "Input token limit, or null when not configured."
                          },
                          "contextLength": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0,
                            "description": "Context token limit. Currently matches inputTokenLimit."
                          },
                          "outputTokenLimit": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Output token limit. Included when configured or derivable from parameter definitions; otherwise omitted."
                          },
                          "supportedParameters": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Native Gemini parameter names. Returns an empty array when no Gemini parameter configuration is available."
                          },
                          "supportedGenerationMethods": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Gemini methods supported by this model. Returns an empty array when Gemini protocol capabilities are unavailable. Use capabilities.endpoints to choose an API for models in the full catalog."
                          },
                          "thinking": {
                            "type": "boolean",
                            "description": "Whether a Gemini thinkingConfig parameter configuration is available."
                          },
                          "temperature": {
                            "type": "number",
                            "description": "Configured default temperature. Omitted when not configured or unavailable."
                          },
                          "maxTemperature": {
                            "type": "number",
                            "description": "Configured maximum temperature. Omitted when not configured or unavailable."
                          },
                          "topP": {
                            "type": "number",
                            "description": "Configured default topP. Omitted when not configured or unavailable."
                          },
                          "topK": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Configured default topK. Omitted when not configured or unavailable."
                          },
                          "aliases": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Available model aliases from platform configuration. Returns an empty array when none are configured."
                          },
                          "architecture": {
                            "type": "object",
                            "required": [
                              "input_modalities",
                              "output_modalities"
                            ],
                            "properties": {
                              "input_modalities": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "output_modalities": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            },
                            "description": "Input and output modalities derived from platform configuration and the endpoints available for this model.",
                            "additionalProperties": false
                          },
                          "capabilities": {
                            "type": "object",
                            "required": [
                              "reasoning_efforts",
                              "endpoints",
                              "parameters"
                            ],
                            "properties": {
                              "reasoning_efforts": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "Reasoning effort levels collected from the endpoint parameter configuration. Returns an empty array when no configurable levels are available."
                              },
                              "endpoints": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "minItems": 1,
                                "description": "Currently callable API paths for this model, from platform routing configuration."
                              },
                              "parameters": {
                                "type": "object",
                                "required": [
                                  "common"
                                ],
                                "properties": {
                                  "common": {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    }
                                  }
                                },
                                "additionalProperties": {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  }
                                },
                                "description": "common lists parameters shared by all callable endpoints. Each endpoint path lists only its additional parameters. Combine common with the endpoint array for its complete parameter set. For a model with one endpoint, all parameters may be in common.",
                                "examples": [
                                  {
                                    "/v1/videos": [],
                                    "common": [
                                      "seed",
                                      "model",
                                      "prompt",
                                      "duration",
                                      "extra_body",
                                      "resolution",
                                      "aspect_ratio",
                                      "callback_url",
                                      "frame_images",
                                      "input_references"
                                    ]
                                  }
                                ]
                              }
                            },
                            "description": "Endpoints, parameters, and reasoning effort levels defined by the platform. These fields match the metadata returned in the other protocol formats.",
                            "additionalProperties": false
                          }
                        },
                        "additionalProperties": true
                      }
                    },
                    "nextPageToken": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Included when another page is available. Pass it as pageToken in the next request. Omitted on the last page rather than returned as null."
                    }
                  },
                  "additionalProperties": false,
                  "examples": [
                    {
                      "models": [
                        {
                          "name": "models/happyhorse-1.0",
                          "baseModelId": "happyhorse-1.0",
                          "version": "1.0",
                          "displayName": "HappyHorse 1.0",
                          "description": "HappyHorse 1.0",
                          "inputTokenLimit": null,
                          "contextLength": null,
                          "supportedParameters": [],
                          "supportedGenerationMethods": [],
                          "thinking": false,
                          "aliases": [
                            "happyhorse-1.0",
                            "happyhorse-1.0-20260624"
                          ],
                          "architecture": {
                            "input_modalities": [
                              "text",
                              "image",
                              "video"
                            ],
                            "output_modalities": [
                              "video"
                            ]
                          },
                          "capabilities": {
                            "endpoints": [
                              "/v1/videos"
                            ],
                            "parameters": {
                              "/v1/videos": [],
                              "common": [
                                "seed",
                                "model",
                                "prompt",
                                "duration",
                                "extra_body",
                                "resolution",
                                "aspect_ratio",
                                "callback_url",
                                "frame_images",
                                "input_references"
                              ]
                            },
                            "reasoning_efforts": []
                          }
                        }
                      ]
                    }
                  ]
                },
                "example": {
                  "models": [
                    {
                      "name": "models/happyhorse-1.0",
                      "baseModelId": "happyhorse-1.0",
                      "version": "1.0",
                      "displayName": "HappyHorse 1.0",
                      "description": "HappyHorse 1.0",
                      "inputTokenLimit": null,
                      "contextLength": null,
                      "supportedParameters": [],
                      "supportedGenerationMethods": [],
                      "thinking": false,
                      "aliases": [
                        "happyhorse-1.0",
                        "happyhorse-1.0-20260624"
                      ],
                      "architecture": {
                        "input_modalities": [
                          "text",
                          "image",
                          "video"
                        ],
                        "output_modalities": [
                          "video"
                        ]
                      },
                      "capabilities": {
                        "endpoints": [
                          "/v1/videos"
                        ],
                        "parameters": {
                          "/v1/videos": [],
                          "common": [
                            "seed",
                            "model",
                            "prompt",
                            "duration",
                            "extra_body",
                            "resolution",
                            "aspect_ratio",
                            "callback_url",
                            "frame_images",
                            "input_references"
                          ]
                        },
                        "reasoning_efforts": []
                      }
                    }
                  ]
                }
              }
            },
            "headers": {}
          },
          "400": {
            "description": "type contains an unknown type or an empty value.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "param": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "code": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  }
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "webhooks": {},
  "components": {
    "schemas": {},
    "responses": {},
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [],
  "security": [
    {
      "bearer": []
    }
  ]
}
