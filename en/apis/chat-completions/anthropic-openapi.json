{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikway Anthropic Messages API",
    "description": "Anthropic Messages-compatible chat API through the Tikway gateway.",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "Chat completions"
    },
    {
      "name": "Chat completions/Anthropic protocol"
    }
  ],
  "paths": {
    "/v1/messages": {
      "post": {
        "summary": "Messages",
        "deprecated": false,
        "description": "",
        "tags": [
          "Chat completions/Anthropic protocol"
        ],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "max_tokens",
                  "messages"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "The Claude model ID used to generate the message, for example claude-opus-5."
                  },
                  "max_tokens": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "The maximum number of tokens to generate content. The model can be stopped before reaching the upper limit; set to 0 to only warm up the prompt cache without generating a reply."
                  },
                  "messages": {
                    "type": "array",
                    "maxItems": 100000,
                    "description": "Enter the conversation message. The model works in user and assistant turns; consecutive messages with the same role will be merged. If there is no system role, please use the top-level system for system prompt words.",
                    "items": {
                      "type": "object",
                      "required": [
                        "role",
                        "content"
                      ],
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "user",
                            "assistant"
                          ],
                          "description": "Message role. When the last item is assistant , the model will continue to be generated from its content."
                        },
                        "content": {
                          "description": "Message content. A string is equivalent to an array containing only one text block.",
                          "oneOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "required": [
                                  "type"
                                ],
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "enum": [
                                      "text",
                                      "image",
                                      "document",
                                      "tool_use",
                                      "tool_result",
                                      "thinking",
                                      "redacted_thinking",
                                      "search_result"
                                    ],
                                    "description": "Content block type."
                                  },
                                  "text": {
                                    "type": "string",
                                    "minLength": 1,
                                    "description": "text The text of the content block."
                                  },
                                  "source": {
                                    "type": "string",
                                    "description": "search_result source identifier."
                                  },
                                  "cache_control": {
                                    "type": "object",
                                    "description": "Prompt word cache breakpoint configuration.",
                                    "properties": {
                                      "type": {
                                        "type": "string",
                                        "enum": [
                                          "ephemeral"
                                        ]
                                      },
                                      "ttl": {
                                        "type": "string",
                                        "enum": [
                                          "5m",
                                          "1h"
                                        ],
                                        "description": "Cache validity period."
                                      }
                                    }
                                  },
                                  "citations": {
                                    "type": "object",
                                    "description": "Document reference configuration.",
                                    "properties": {
                                      "enabled": {
                                        "type": "boolean",
                                        "description": "Whether to enable citations."
                                      }
                                    }
                                  },
                                  "title": {
                                    "type": "string",
                                    "description": "search_result title."
                                  },
                                  "context": {
                                    "type": "string",
                                    "description": "Documentation adds context."
                                  },
                                  "id": {
                                    "type": "string",
                                    "description": "The unique call ID of the tool_use content block."
                                  },
                                  "name": {
                                    "type": "string",
                                    "description": "tool_use The name of the tool called."
                                  },
                                  "input": {
                                    "type": "object",
                                    "description": "JSON input parameters for tool_use.",
                                    "properties": {}
                                  },
                                  "tool_use_id": {
                                    "type": "string",
                                    "description": "The tool_use ID that tool_result responds to."
                                  },
                                  "content": {
                                    "description": "The result content of tool_result can be a string or an array of content blocks."
                                  },
                                  "is_error": {
                                    "type": "boolean",
                                    "description": "Whether tool_result indicates a tool execution error."
                                  },
                                  "thinking": {
                                    "type": "string",
                                    "description": "The thinking content returned by the previous response; this must remain intact when passed back."
                                  },
                                  "signature": {
                                    "type": "string",
                                    "description": "Signature of the thinking content block; must remain intact on postback."
                                  },
                                  "data": {
                                    "type": "string",
                                    "description": "Encrypted data for redacted_thinking; must be returned intact."
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  },
                  "system": {
                    "description": "System prompt word. The Messages API does not support system role messages, this field should be used.",
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "type",
                            "text"
                          ],
                          "properties": {
                            "type": {
                              "type": "string",
                              "enum": [
                                "text"
                              ]
                            },
                            "text": {
                              "type": "string",
                              "description": "System prompt word text."
                            },
                            "cache_control": {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "enum": [
                                    "ephemeral"
                                  ]
                                },
                                "ttl": {
                                  "type": "string",
                                  "enum": [
                                    "5m",
                                    "1h"
                                  ]
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  },
                  "stream": {
                    "type": "boolean",
                    "description": "Whether to stream message events as Server-Sent Events."
                  },
                  "stop_sequences": {
                    "type": "array",
                    "description": "Customize stop sequence; model generation stops when it reaches any sequence.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "temperature": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Sampling temperature. Higher values ​​make the output more random; usually adjusted with top_p, top_k."
                  },
                  "top_p": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Kernel sampling threshold."
                  },
                  "top_k": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "The number of candidate tokens with the highest probability retained during each sampling step."
                  },
                  "thinking": {
                    "description": "Extended thinking configuration. Optional enabled, adaptive, disabled, or passed in null. When think is enabled, think tokens count toward max_tokens.",
                    "oneOf": [
                      {
                        "title": "Enabled thinking",
                        "type": "object",
                        "required": [
                          "type",
                          "budget_tokens"
                        ],
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "enabled"
                            ]
                          },
                          "budget_tokens": {
                            "type": "integer",
                            "minimum": 1024,
                            "description": "Think about the token budget, which must be less than max_tokens."
                          },
                          "block_binding": {
                            "description": "How to handle when the returned thought block does not pass the dialog prefix check; omitted, null or empty objects use the default behavior.",
                            "type": [
                              "object",
                              "null"
                            ],
                            "properties": {
                              "prefix_mismatch_behavior": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "enum": [
                                  "error",
                                  "drop_block",
                                  null
                                ],
                                "default": "error",
                                "description": "error will return 400; drop_block will remove unmatched think blocks."
                              }
                            }
                          },
                          "display": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "enum": [
                              "summarized",
                              "omitted",
                              "updates",
                              null
                            ],
                            "default": "summarized",
                            "description": "Think about how the content is presented; omitted will hide the content but retain the signature for multiple rounds of conversation."
                          }
                        }
                      },
                      {
                        "title": "Adaptive thinking",
                        "type": "object",
                        "required": [
                          "type"
                        ],
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "adaptive"
                            ]
                          },
                          "block_binding": {
                            "description": "How to handle when the returned thought block does not pass the dialog prefix check; omitted, null or empty objects use the default behavior.",
                            "type": [
                              "object",
                              "null"
                            ],
                            "properties": {
                              "prefix_mismatch_behavior": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "enum": [
                                  "error",
                                  "drop_block",
                                  null
                                ],
                                "default": "error",
                                "description": "error will return 400; drop_block will remove unmatched think blocks."
                              }
                            }
                          },
                          "display": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "enum": [
                              "summarized",
                              "omitted",
                              "updates",
                              null
                            ],
                            "default": "summarized",
                            "description": "Think about how the content is presented; omitted will hide the content but retain the signature for multiple rounds of conversation."
                          }
                        }
                      },
                      {
                        "title": "Disabled thinking",
                        "type": "object",
                        "required": [
                          "type"
                        ],
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "disabled"
                            ]
                          }
                        }
                      },
                      {
                        "title": "No thinking configuration",
                        "type": "null"
                      }
                    ]
                  },
                  "tools": {
                    "type": "array",
                    "description": "A tool definition that can be called by Claude.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "description": "Tool name."
                        },
                        "description": {
                          "type": "string",
                          "description": "Description of tool usage."
                        },
                        "input_schema": {
                          "type": "object",
                          "description": "JSON Schema of tool input parameters.",
                          "properties": {}
                        },
                        "type": {
                          "type": "string",
                          "description": "Tool type; custom tools are usually custom or omitted."
                        },
                        "cache_control": {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "enum": [
                                "ephemeral"
                              ]
                            },
                            "ttl": {
                              "type": "string",
                              "enum": [
                                "5m",
                                "1h"
                              ]
                            }
                          }
                        }
                      }
                    }
                  },
                  "tool_choice": {
                    "type": "object",
                    "description": "Controls whether and how Claude selects tools.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "auto",
                          "any",
                          "tool",
                          "none"
                        ],
                        "description": "Tool selection mode."
                      },
                      "name": {
                        "type": "string",
                        "description": "The name of the tool that is forced to be called when type is tool."
                      },
                      "disable_parallel_tool_use": {
                        "type": "boolean",
                        "description": "Whether to disable parallel tool calls."
                      }
                    }
                  },
                  "output_config": {
                    "type": "object",
                    "description": "Output configuration.",
                    "properties": {
                      "effort": {
                        "type": "string",
                        "enum": [
                          "low",
                          "medium",
                          "high"
                        ],
                        "description": "Output reasoning/quality input level."
                      },
                      "format": {
                        "type": "object",
                        "description": "Structured output format.",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "json_schema"
                            ]
                          },
                          "schema": {
                            "type": "object",
                            "description": "Target JSON Schema.",
                            "properties": {}
                          }
                        }
                      }
                    }
                  },
                  "output_format": {
                    "type": "object",
                    "description": "JSON output format configuration.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "json_schema"
                        ]
                      },
                      "schema": {
                        "type": "object",
                        "description": "Target JSON Schema.",
                        "properties": {}
                      }
                    }
                  },
                  "metadata": {
                    "type": "object",
                    "description": "Request metadata.",
                    "properties": {
                      "user_id": {
                        "type": "string",
                        "description": "End user identification."
                      }
                    }
                  },
                  "service_tier": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "standard_only"
                    ],
                    "description": "Service level selection."
                  },
                  "speed": {
                    "type": "string",
                    "enum": [
                      "standard",
                      "fast"
                    ],
                    "description": "Inference speed mode."
                  },
                  "container": {
                    "description": "Code execution container configuration or container ID.",
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "skills": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    ]
                  },
                  "context_management": {
                    "type": "object",
                    "description": "Context management configuration.",
                    "properties": {}
                  },
                  "mcp_servers": {
                    "type": "array",
                    "description": "MCP server definition.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        },
                        "authorization_token": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "cache_control": {
                    "type": "object",
                    "description": "Request-level prompt word cache control.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "ephemeral"
                        ]
                      },
                      "ttl": {
                        "type": "string",
                        "enum": [
                          "5m",
                          "1h"
                        ]
                      }
                    }
                  },
                  "diagnostics": {
                    "type": "object",
                    "description": "Diagnostic information configuration.",
                    "properties": {}
                  },
                  "fallback_credit_token": {
                    "description": "Fallback service deduction token.",
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "properties": {}
                      }
                    ]
                  },
                  "fallbacks": {
                    "type": "object",
                    "description": "Model fallback configuration.",
                    "properties": {}
                  },
                  "inference_geo": {
                    "type": "string",
                    "description": "Reasoning about geographic preferences."
                  }
                },
                "examples": [
                  {
                    "model": "claude-opus-5",
                    "max_tokens": 1024,
                    "messages": [
                      {
                        "role": "user",
                        "content": "Hello, Claude"
                      }
                    ],
                    "stream": false
                  }
                ]
              },
              "examples": {
                "Text input": {
                  "value": {
                    "model": "claude-sonnet-4-6",
                    "max_tokens": 1024,
                    "system": "You are a helpful assistant.",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Write a short bedtime story about a unicorn."
                      }
                    ]
                  },
                  "summary": "Text input"
                },
                "Streaming output": {
                  "value": {
                    "model": "claude-sonnet-4-6",
                    "max_tokens": 1024,
                    "system": "You are a helpful assistant.",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Write a short bedtime story about a unicorn."
                      }
                    ],
                    "stream": true
                  },
                  "summary": "Streaming output"
                },
                "Image input": {
                  "value": {
                    "model": "claude-sonnet-4-6",
                    "max_tokens": 1024,
                    "system": "You are a helpful assistant.",
                    "messages": [
                      {
                        "role": "user",
                        "content": [
                          {
                            "type": "image",
                            "source": {
                              "type": "url",
                              "url": "https://uploads3.wikiart.org/00475/images/vincent-van-gogh/the-starry-night-1889.jpg"
                            }
                          },
                          {
                            "type": "text",
                            "text": "Describe this painting in Chinese, including its style, colors, and mood."
                          }
                        ]
                      }
                    ]
                  },
                  "summary": "Image input"
                },
                "Function calling": {
                  "value": {
                    "model": "claude-sonnet-4-6",
                    "max_tokens": 1024,
                    "tools": [
                      {
                        "name": "get_weather",
                        "description": "Get current weather for a city.",
                        "input_schema": {
                          "type": "object",
                          "properties": {
                            "city": {
                              "type": "string",
                              "description": "City name, such as Shanghai."
                            }
                          },
                          "required": [
                            "city"
                          ]
                        }
                      }
                    ],
                    "messages": [
                      {
                        "role": "user",
                        "content": "What's the weather in Shanghai today?"
                      }
                    ]
                  },
                  "summary": "function call"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "type",
                    "role",
                    "model",
                    "content",
                    "stop_reason",
                    "usage"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Message unique ID."
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "message"
                      ],
                      "description": "Object type, fixed to message."
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "assistant"
                      ],
                      "description": "Message role, fixed to assistant."
                    },
                    "model": {
                      "type": "string",
                      "description": "The actual Claude model ID used."
                    },
                    "content": {
                      "type": "array",
                      "description": "List of content blocks generated by Claude.",
                      "items": {
                        "type": "object",
                        "required": [
                          "type"
                        ],
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "text",
                              "thinking",
                              "redacted_thinking",
                              "tool_use",
                              "server_tool_use",
                              "web_search_tool_result",
                              "web_fetch_tool_result",
                              "code_execution_tool_result"
                            ],
                            "description": "Output content block type."
                          },
                          "text": {
                            "type": "string",
                            "description": "text Generated text for the content block."
                          },
                          "citations": {
                            "type": "array",
                            "description": "List of textual references.",
                            "items": {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "description": "Reference type."
                                },
                                "cited_text": {
                                  "type": "string",
                                  "description": "Quoted text."
                                },
                                "document_index": {
                                  "type": "integer",
                                  "description": "Source document index."
                                },
                                "document_title": {
                                  "type": "string",
                                  "description": "Source document title."
                                },
                                "start_char_index": {
                                  "type": "integer"
                                },
                                "end_char_index": {
                                  "type": "integer"
                                },
                                "url": {
                                  "type": "string"
                                },
                                "title": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "thinking": {
                            "type": "string",
                            "description": "Extended reflection text."
                          },
                          "signature": {
                            "type": "string",
                            "description": "Think about the content signature; it must remain the same the next time you pass it around."
                          },
                          "data": {
                            "type": "string",
                            "description": "Encrypted data for redacted_thinking."
                          },
                          "id": {
                            "type": "string",
                            "description": "Tool call ID."
                          },
                          "name": {
                            "type": "string",
                            "description": "The name of the called tool."
                          },
                          "input": {
                            "type": "object",
                            "description": "Tool call input parameters.",
                            "properties": {}
                          },
                          "content": {
                            "description": "Server tool call result content."
                          },
                          "tool_use_id": {
                            "type": "string",
                            "description": "The associated tool call ID."
                          },
                          "is_error": {
                            "type": "boolean",
                            "description": "Whether the server tool results are in error."
                          }
                        }
                      }
                    },
                    "stop_reason": {
                      "type": "string",
                      "enum": [
                        "end_turn",
                        "max_tokens",
                        "stop_sequence",
                        "tool_use",
                        "pause_turn",
                        "refusal",
                        "model_context_window_exceeded"
                      ],
                      "description": "Generate a stop reason."
                    },
                    "stop_sequence": {
                      "type": "string",
                      "description": "If the sequence ends due to a custom stop, it is a hit sequence."
                    },
                    "stop_details": {
                      "type": "object",
                      "description": "Structured information for rejection and other stopping situations.",
                      "properties": {
                        "type": {
                          "type": "string"
                        },
                        "category": {
                          "type": "string"
                        },
                        "explanation": {
                          "type": "string"
                        },
                        "recommended_model": {
                          "type": "string"
                        }
                      }
                    },
                    "usage": {
                      "type": "object",
                      "description": "Billing and current limiting word usage statistics.",
                      "required": [
                        "input_tokens",
                        "output_tokens"
                      ],
                      "properties": {
                        "input_tokens": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Enter the number of tokens."
                        },
                        "output_tokens": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Output the number of tokens."
                        },
                        "cache_creation_input_tokens": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "The number of input tokens used to create the cache."
                        },
                        "cache_read_input_tokens": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "The number of input tokens read from the cache."
                        },
                        "cache_creation": {
                          "type": "object",
                          "properties": {
                            "ephemeral_5m_input_tokens": {
                              "type": "integer"
                            },
                            "ephemeral_1h_input_tokens": {
                              "type": "integer"
                            }
                          }
                        },
                        "output_tokens_details": {
                          "type": "object",
                          "properties": {
                            "thinking_tokens": {
                              "type": "integer",
                              "description": "Think about word count."
                            }
                          }
                        },
                        "server_tool_use": {
                          "type": "object",
                          "properties": {
                            "web_search_requests": {
                              "type": "integer"
                            },
                            "web_fetch_requests": {
                              "type": "integer"
                            }
                          }
                        },
                        "service_tier": {
                          "type": "string",
                          "enum": [
                            "standard",
                            "priority",
                            "batch"
                          ],
                          "description": "Actual service level."
                        },
                        "speed": {
                          "type": "string",
