        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Model ID or configured alias."
                  },
                  "input": {
                    "type": "string",
                    "maxLength": 4096,
                    "description": "Text or input to process."
                  },
                  "voice": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "id"
                        ],
                        "additionalProperties": true
                      }
                    ],
                    "description": "Voice ID for the selected model."
                  },
                  "instructions": {
                    "type": "string",
                    "maxLength": 4096,
                    "description": "Instructions for the model."
                  },
                  "response_format": {
                    "type": "string",
                    "enum": [
                      "mp3",
                      "pcm",
                      "wav",
                      "opus"
                    ],
                    "default": "mp3",
                    "description": "Output format."
                  },
                  "speed": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 2,
                    "default": 1,
                    "description": "Speech speed."
                  },
                  "stream_format": {
                    "type": "string",
                    "enum": [
                      "audio",
                      "sse"
                    ],
                    "default": "audio",
                    "description": "Return audio bytes or server-sent events."
                  },
                  "extra_body": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "sample_rate": {
                        "type": "integer",
                        "enum": [
                          8000,
                          12000,
                          16000,
                          22050,
                          24000,
                          44100,
                          48000
                        ]
                      },
                      "volume": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "rate": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 2
                      },
                      "bit_rate": {
                        "type": "integer",
                        "minimum": 6,
                        "maximum": 510
                      },
                      "pitch": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 2
                      },
                      "enable_ssml": {
                        "type": "boolean"
                      },
                      "word_timestamp_enabled": {
                        "type": "boolean"
                      },
                      "seed": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 65535
                      },
                      "language_hints": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "instruction": {
                        "type": "string"
                      },
                      "enable_aigc_tag": {
                        "type": "boolean"
                      },
                      "aigc_propagator": {
                        "type": "string"
                      },
                      "aigc_propagate_id": {
                        "type": "string"
                      },
                      "hot_fix": {
                        "type": "object",
                        "properties": {
                          "pronunciation": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": {
                                "type": "string"
                              },
                              "properties": {}
                            }
                          },
                          "replace": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": {
                                "type": "string"
                              },
                              "properties": {}
                            }
                          }
                        },
                        "additionalProperties": true
                      },
                      "stream": {
                        "type": "boolean"
                      }
                    },
                    "description": "Provider-specific options."
                  },
                  "sample_rate": {
                    "type": "integer",
                    "enum": [
                      8000,
                      12000,
                      16000,
                      22050,
                      24000,
                      44100,
                      48000
                    ]
                  },
                  "volume": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "rate": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 2
                  },
                  "bit_rate": {
                    "type": "integer",
                    "minimum": 6,
                    "maximum": 510
                  },
                  "pitch": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 2
                  },
                  "enable_ssml": {
                    "type": "boolean"
                  },
                  "word_timestamp_enabled": {
                    "type": "boolean"
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "language_hints": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "instruction": {
                    "type": "string"
                  },
                  "enable_aigc_tag": {
                    "type": "boolean"
                  },
                  "aigc_propagator": {
                    "type": "string"
                  },
                  "aigc_propagate_id": {
                    "type": "string"
                  },
                  "hot_fix": {
                    "type": "object",
                    "properties": {
                      "pronunciation": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          },
                          "properties": {}
                        }
                      },
                      "replace": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          },
                          "properties": {}
                        }
                      }
                    },
                    "additionalProperties": true
                  },
                  "stream": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "model",
                  "input",
                  "voice"
                ],
                "additionalProperties": true
              }
            }
          }
        },
        "description": "Qwen Audio speech synthesis through the Tikway gateway."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
