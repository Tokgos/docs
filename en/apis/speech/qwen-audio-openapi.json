  "paths": {
    "/v1/audio/speech": {
      "post": {
        "summary": "Qwen Audio text to speech",
        "operationId": "createSpeech",
        "tags": [
          "Speech synthesis/Qwen Audio"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
