{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikway Embeddings API",
    "description": "OpenAI- and Gemini-compatible embedding APIs through the Tikway gateway.",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "vector embedding"
    }
  ],
  "paths": {
    "/v1/embeddings": {
      "post": {
        "summary": "GPT - vector",
        "deprecated": false,
        "description": "",
        "tags": [
          "vector embedding"
        ],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "EmbeddingRequest",
                "description": "Convert text or token ID to vector representation.",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Vector model ID.",
                    "examples": [
                      "openai/text-embedding-3-small",
                      "openai/text-embedding-3-large",
                      "bailian/text-embedding-v4",
                      "google/gemini-embedding-2-preview"
                    ]
                  },
                  "input": {
                    "description": "Requires input to generate vectors. Supports a single string, string array, token ID array or token ID two-dimensional array. The Gemini embedding model currently only supports single strings.",
                    "oneOf": [
                      {
                        "title": "single text",
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "title": "bulk text",
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 2048,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      {
                        "title": "Single Token array",
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 2048,
                        "items": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      {
                        "title": "Batch Token array",
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 2048,
                        "items": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 2048,
                          "items": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    ],
                    "examples": [
                      "OfoxAI is an LLM Gateway",
                      [
                        "first text",
                        "second text"
                      ]
                    ]
                  },
                  "encoding_format": {
                    "type": "string",
                    "enum": [
                      "float",
                      "base64"
                    ],
                    "default": "float",
                    "description": "Vector encoding format. float returns an array of floating point numbers; base64 returns Base64-encoded float32 data."
                  },
                  "dimensions": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Output vector dimension, only supported by some models. Gemini embedding models are limited to 128 to 3072 in the current gateway."
                  },
                  "user": {
                    "type": "string",
                    "description": "End user identification, used for upstream abuse monitoring."
                  }
                },
                "examples": [
                  {
                    "model": "openai/text-embedding-3-small",
                    "input": "OfoxAI is an LLM Gateway",
                    "encoding_format": "float"
                  },
                  {
                    "model": "bailian/text-embedding-v4",
                    "input": [
                      "first text",
                      "second text"
                    ],
                    "dimensions": 1024,
                    "encoding_format": "float"
                  }
                ]
              },
              "example": {
                "model": "openai/text-embedding-3-large",
                "input": "Hello, world!"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "title": "EmbeddingResponse",
                  "description": "OpenAI Embeddings compatible responses.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "object",
                    "data",
                    "model",
                    "usage"
                  ],
                  "properties": {
                    "object": {
                      "type": "string",
                      "const": "list",
                      "description": "Fixed to list."
                    },
                    "data": {
                      "type": "array",
                      "minItems": 1,
                      "description": "Enter the corresponding vector result list.",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "object",
                          "embedding",
                          "index"
                        ],
                        "properties": {
                          "object": {
                            "type": "string",
                            "const": "embedding"
                          },
                          "embedding": {
                            "description": "vector data. The specific type is determined by encoding_format in the request.",
                            "oneOf": [
                              {
                                "title": "Float vector",
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                  "type": "number"
                                }
                              },
                              {
                                "title": "Base64 vector",
                                "type": "string",
                                "minLength": 1,
                                "contentEncoding": "base64",
                                "description": "A Base64 string encoded in float32 little-endian order."
                              }
                            ]
                          },
                          "index": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "The index corresponding to the input content."
                          }
                        }
                      }
                    },
                    "model": {
                      "type": "string",
                      "description": "The actual model ID used."
                    },
                    "usage": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "prompt_tokens",
                        "total_tokens"
                      ],
                      "properties": {
                        "prompt_tokens": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Enter the number of tokens consumed."
                        },
                        "total_tokens": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "The total number of tokens in this request."
                        }
                      }
                    }
                  },
                  "examples": [
                    {
                      "object": "list",
                      "data": [
                        {
                          "object": "embedding",
                          "index": 0,
                          "embedding": [
                            0.0023,
                            -0.0091,
                            0.0156
                          ]
                        }
                      ],
                      "model": "openai/text-embedding-3-small",
                      "usage": {
                        "prompt_tokens": 8,
                        "total_tokens": 8
                      }
                    }
                  ]
                },
                "example": {
                  "data": [
                    {
                      "embedding": [
                        -0.005828857421875,
                        -0.0241241455078125,
                        -0.02203369140625
                      ],
                      "index": 0,
                      "object": "embedding"
                    }
                  ],
                  "model": "openai/text-embedding-3-large",
                  "object": "list",
                  "usage": {
                    "prompt_tokens": 4,
                    "total_tokens": 4
                  }
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1beta/models/google/{model}:embedContent": {
      "post": {
        "summary": "Gemini - vector",
        "deprecated": false,
        "description": "",
        "tags": [
          "vector embedding"
        ],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "contents"
                ],
                "properties": {
                  "contents": {
                    "type": "array",
                    "minItems": 1,
                    "description": "Current conversation content. A single-round request usually has only one Content; multi-round conversations include historical and latest requests in order.",
                    "items": {
                      "type": "object",
                      "required": [
                        "parts"
                      ],
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "user",
                            "model"
                          ],
                          "description": "Content roles. When omitted, it is usually treated as user."
                        },
                        "parts": {
                          "type": "array",
                          "minItems": 1,
                          "description": "List of content sections.",
                          "items": {
                            "type": "object",
                            "properties": {
                              "text": {
                                "type": "string",
                                "description": "Text input."
                              },
                              "inline_data": {
                                "type": "object",
                                "description": "Inline Base64 file data.",
                                "properties": {
                                  "mime_type": {
                                    "type": "string",
                                    "description": "MIME type, such as image/jpeg."
                                  },
                                  "data": {
                                    "type": "string",
                                    "description": "Base64 encoded data."
                                  }
                                }
                              },
                              "file_data": {
                                "type": "object",
                                "description": "A reference to the uploaded file in the File API.",
                                "properties": {
                                  "mime_type": {
                                    "type": "string",
                                    "description": "File MIME type."
                                  },
                                  "file_uri": {
                                    "type": "string",
                                    "description": "File URI."
                                  }
                                }
                              },
                              "function_call": {
                                "type": "object",
                                "description": "Function calls generated by the previous round of models.",
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "description": "function name."
                                  },
                                  "args": {
                                    "type": "object",
                                    "description": "function parameters.",
                                    "properties": {}
                                  }
                                }
                              },
                              "function_response": {
                                "type": "object",
                                "description": "The execution result of the client's function call.",
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "description": "function name."
                                  },
                                  "response": {
                                    "type": "object",
                                    "description": "Function execution return value.",
                                    "properties": {}
                                  }
                                }
                              },
                              "executable_code": {
                                "type": "object",
                                "description": "Executable code.",
                                "properties": {
                                  "language": {
                                    "type": "string",
                                    "description": "programming language."
                                  },
                                  "code": {
                                    "type": "string",
                                    "description": "code content."
                                  }
                                }
                              },
                              "code_execution_result": {
                                "type": "object",
                                "description": "Code execution results.",
                                "properties": {
                                  "outcome": {
                                    "type": "string",
                                    "description": "Execution result status."
                                  },
                                  "output": {
                                    "type": "string",
                                    "description": "Execute output."
                                  }
                                }
                              },
                              "thought": {
                                "type": "boolean",
                                "description": "Does this part belong to model thinking content?"
                              },
                              "thought_signature": {
                                "type": "string",
                                "description": "Think content signatures; keep them as is on postback."
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "systemInstruction": {
                    "type": "object",
                    "description": "System commands set by developers should currently use the plain text part.",
                    "required": [
                      "parts"
                    ],
                    "properties": {
                      "parts": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "text": {
                              "type": "string",
                              "description": "System command text."
                            }
                          }
                        }
                      }
                    }
                  },
                  "tools": {
                    "type": "array",
                    "description": "A list of tools that the model can use, such as function calls or code execution.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "function_declarations": {
                          "type": "array",
                          "description": "List of function declarations.",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string",
                                "description": "function name."
                              },
                              "description": {
                                "type": "string",
                                "description": "Description of function usage."
                              },
                              "parameters": {
                                "type": "object",
                                "description": "Function parameters JSON Schema.",
                                "properties": {}
                              },
                              "response": {
                                "type": "object",
                                "description": "Function responds to JSON Schema.",
                                "properties": {}
                              }
                            }
                          }
                        },
                        "code_execution": {
                          "type": "object",
                          "description": "Enable code execution tools.",
                          "properties": {}
                        },
                        "google_search": {
                          "type": "object",
                          "description": "Enable Google search tools.",
                          "properties": {}
                        },
                        "url_context": {
                          "type": "object",
                          "description": "Enable the URL context tool.",
                          "properties": {}
                        }
                      }
                    }
                  },
                  "toolConfig": {
                    "type": "object",
                    "description": "Tool call configuration.",
                    "properties": {
                      "functionCallingConfig": {
                        "type": "object",
                        "properties": {
                          "mode": {
                            "type": "string",
                            "enum": [
                              "AUTO",
                              "ANY",
                              "NONE",
                              "VALIDATED"
                            ],
                            "description": "Function calling pattern."
                          },
                          "allowedFunctionNames": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Function names that allow automatic calling."
                          }
                        }
                      }
                    }
                  },
                  "safetySettings": {
                    "type": "array",
                    "description": "Security filtering rules; the same category can be configured at most once, overriding the default threshold for that category.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "category": {
                          "type": "string",
                          "enum": [
                            "HARM_CATEGORY_HATE_SPEECH",
                            "HARM_CATEGORY_SEXUALLY_EXPLICIT",
                            "HARM_CATEGORY_DANGEROUS_CONTENT",
                            "HARM_CATEGORY_HARASSMENT",
                            "HARM_CATEGORY_CIVIC_INTEGRITY",
                            "HARM_CATEGORY_JAILBREAK"
                          ],
                          "description": "Security Category."
                        },
                        "threshold": {
                          "type": "string",
                          "description": "Blocking threshold."
                        },
                        "method": {
                          "type": "string",
                          "description": "Safety rating method."
                        }
                      }
                    }
                  },
                  "generationConfig": {
                    "type": "object",
                    "description": "Generate and output configurations.",
                    "properties": {
                      "temperature": {
                        "type": "number",
                        "description": "Sampling temperature."
                      },
                      "topP": {
                        "type": "number",
                        "description": "Kernel sampling threshold."
                      },
                      "topK": {
                        "type": "integer",
                        "description": "The number of highest probability candidates retained at each step."
                      },
                      "candidateCount": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Returns the number of candidate replies."
                      },
                      "maxOutputTokens": {
                        "type": "integer",
                        "description": "The maximum number of output tokens."
                      },
                      "stopSequences": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "Stop the sequence."
                      },
                      "responseMimeType": {
                        "type": "string",
                        "enum": [
                          "text/plain",
                          "application/json"
                        ],
                        "description": "Output MIME type."
                      },
                      "responseSchema": {
                        "type": "object",
                        "description": "The JSON Schema that application/json output should follow.",
                        "properties": {}
                      },
                      "responseJsonSchema": {
                        "type": "object",
                        "description": "The raw JSON Schema of the JSON output.",
                        "properties": {}
                      },
                      "responseModalities": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "TEXT",
                            "IMAGE",
                            "AUDIO"
                          ]
                        },
                        "description": "The requested output modal."
                      },
                      "thinkingConfig": {
                        "type": "object",
                        "properties": {
                          "thinkingBudget": {
                            "type": "integer",
                            "description": "Think about token budgeting."
                          },
                          "includeThoughts": {
                            "type": "boolean",
                            "description": "Whether to include a reflection summary in the response."
                          }
                        }
                      },
                      "mediaResolution": {
                        "type": "string",
                        "description": "Media input resolution settings."
                      }
                    }
                  },
                  "cachedContent": {
                    "type": "string",
                    "description": "The cached content name to use as context, in the format cachedContents/{cachedContent}."
                  },
                  "serviceTier": {
                    "type": "string",
                    "description": "Request service level."
                  },
                  "store": {
                    "type": "boolean",
                    "description": "Whether to log this request; if set, it will override the project-level log configuration."
                  }
                },
                "examples": [
                  {
                    "contents": [
                      {
                        "role": "user",
                        "parts": [
                          {
                            "text": "Write a story about a magic backpack."
                          }
                        ]
                      }
                    ],
                    "generationConfig": {
                      "temperature": 1,
                      "maxOutputTokens": 1024
                    }
                  }
                ]
              },
              "examples": {
                "Default": {
                  "value": {
                    "content": {
                      "parts": [
                        {
                          "text": "Hello, world!"
                        }
                      ]
                    }
                  },
                  "summary": "Default"
                },
                "Multimodal": {
                  "value": {
                    "contents": [
                      {
                        "parts": [
                          {
                            "text": "Tell me about this instrument"
                          },
                          {
                            "inline_data": {
                              "mime_type": "image/jpeg",
                              "data": "iVBORw0K..."
                            }
                          }
                        ]
                      }
                    ]
                  },
                  "summary": "multimodal"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Gemini API: models.generateContent normal response. Fully inline and suitable for importing into Apifox.",
                  "properties": {
                    "candidates": {
                      "type": "array",
                      "description": "A list of candidate responses generated by the model.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "index": {
                            "type": "integer",
                            "description": "Candidate reply index."
                          },
                          "content": {
                            "type": "object",
                            "description": "Candidate reply content.",
                            "properties": {
                              "role": {
                                "type": "string",
                                "enum": [
                                  "model"
                                ],
                                "description": "Role, fixed as model."
                              },
                              "parts": {
                                "type": "array",
                                "description": "Reply content part.",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "text": {
                                      "type": "string",
                                      "description": "Generated text."
                                    },
                                    "inline_data": {
                                      "type": "object",
                                      "description": "Media data generated inline.",
                                      "properties": {
                                        "mime_type": {
                                          "type": "string"
                                        },
                                        "data": {
                                          "type": "string",
                                          "description": "Base64 encoded data."
                                        }
                                      }
                                    },
                                    "file_data": {
                                      "type": "object",
                                      "properties": {
                                        "mime_type": {
                                          "type": "string"
                                        },
                                        "file_uri": {
                                          "type": "string"
                                        }
                                      }
                                    },
                                    "function_call": {
                                      "type": "object",
                                      "description": "The model request calls the function.",
                                      "properties": {
                                        "name": {
                                          "type": "string",
                                          "description": "function name."
                                        },
                                        "args": {
                                          "type": "object",
                                          "description": "function parameters.",
                                          "properties": {}
                                        },
                                        "id": {
                                          "type": "string",
                                          "description": "Function call ID."
                                        }
                                      }
                                    },
                                    "executable_code": {
                                      "type": "object",
                                      "properties": {
                                        "language": {
                                          "type": "string"
                                        },
                                        "code": {
                                          "type": "string"
                                        }
                                      }
                                    },
                                    "code_execution_result": {
                                      "type": "object",
                                      "properties": {
                                        "outcome": {
                                          "type": "string"
                                        },
                                        "output": {
                                          "type": "string"
                                        }
                                      }
                                    },
                                    "thought": {
                                      "type": "boolean",
                                      "description": "Whether it is the content of thinking."
                                    },
                                    "thought_signature": {
                                      "type": "string",
                                      "description": "Think about signing."
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "finishReason": {
                            "type": "string",
                            "description": "The ending reason for the candidate reply."
                          },
                          "finishMessage": {
                            "type": "string",
                            "description": "A description of the reason for ending."
                          },
                          "safetyRatings": {
                            "type": "array",
                            "description": "The security rating of the candidate reply.",
                            "items": {
                              "type": "object",
                              "properties": {
                                "category": {
                                  "type": "string"
                                },
                                "probability": {
                                  "type": "string"
                                },
                                "blocked": {
                                  "type": "boolean"
                                }
                              }
                            }
                          },
                          "citationMetadata": {
                            "type": "object",
                            "description": "Reference metadata.",
                            "properties": {}
                          },
                          "tokenCount": {
                            "type": "integer",
                            "description": "Number of candidate reply tokens."
                          },
                          "avgLogprobs": {
                            "type": "number",
                            "description": "Average log probability of candidate responses."
                          },
                          "logprobsResult": {
                            "type": "object",
                            "description": "Term log probability results.",
                            "properties": {}
                          },
                          "urlContextMetadata": {
                            "type": "object",
                            "description": "URL context metadata.",
                            "properties": {}
                          }
                        }
                      }
                    },
                    "promptFeedback": {
                      "type": "object",
                      "description": "Feedback when prompt words are blocked or filtered.",
                      "properties": {
                        "blockReason": {
                          "type": "string",
                          "description": "Blocking reasons."
                        },
                        "blockReasonMessage": {
                          "type": "string",
                          "description": "Description of the reason for blocking."
                        },
                        "safetyRatings": {
                          "type": "array",
                          "description": "Prompt word safety rating.",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "usageMetadata": {
                      "type": "object",
                      "description": "Word usage statistics.",
                      "properties": {
                        "promptTokenCount": {
                          "type": "integer",
                          "description": "Prompt word number."
                        },
                        "candidatesTokenCount": {
                          "type": "integer",
                          "description": "Number of candidate reply tokens."
                        },
                        "totalTokenCount": {
                          "type": "integer",
                          "description": "The total number of tokens."
                        },
                        "cachedContentTokenCount": {
                          "type": "integer",
                          "description": "The number of cached content tokens."
                        },
                        "thoughtsTokenCount": {
                          "type": "integer",
                          "description": "Think about word count."
                        },
                        "toolUsePromptTokenCount": {
                          "type": "integer",
                          "description": "Tool usage hint word token number."
                        }
                      }
                    },
                    "modelVersion": {
                      "type": "string",
                      "description": "The actual model version used."
                    },
                    "responseId": {
                      "type": "string",
                      "description": "Response unique ID."
                    }
                  },
                  "examples": [
                    {
                      "candidates": [
                        {
                          "index": 0,
                          "content": {
                            "role": "model",
                            "parts": [
                              {
                                "text": "Once upon a time, a magic backpack..."
                              }
                            ]
                          },
                          "finishReason": "STOP"
                        }
                      ],
                      "usageMetadata": {
                        "promptTokenCount": 10,
                        "candidatesTokenCount": 12,
                        "totalTokenCount": 22
                      },
                      "modelVersion": "gemini-2.0-flash"
                    }
                  ]
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
