    "/v1beta/models/{model}:generateContent": {
      "post": {
        "summary": "Gemini - 图片生成",
        "deprecated": false,
        "description": "",
        "tags": ["图片生成/Nano Banana"],
        "parameters": [
          {
            "name": "model",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "gemini",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["contents"],
                "properties": {
                  "contents": {
                    "type": "array",
                    "minItems": 1,
                    "description": "必填。纯文本为文生图；文本加 inlineData 为图像编辑。",
                    "items": {
                      "type": "object",
                      "required": ["parts"],
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": ["user", "model"],
                          "description": "通常为 user 或省略。"
                        },
                        "parts": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "properties": {
                              "text": {
                                "type": "string",
                                "description": "生成或编辑图片的提示词。"
                              },
                              "inlineData": {
                                "type": "object",
                                "description": "编辑时使用的 Base64 参考图。",
                                "required": ["mimeType", "data"],
                                "properties": {
                                  "mimeType": {
                                    "type": "string",
                                    "description": "图片 MIME 类型，例如 image/png。"
                                  },
                                  "data": {
                                    "type": "string",
                                    "description": "不带 data URL 前缀的 Base64 图片内容。"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "generationConfig": {
                    "type": "object",
                    "description": "Nano Banana 图像输出配置。",
                    "properties": {
                      "responseModalities": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["TEXT", "IMAGE"]
                        },
                        "description": "仅返回图片时设为 [\"IMAGE\"]。"
                      },
                      "responseFormat": {
                        "type": "object",
                        "properties": {
                          "image": {
                            "type": "object",
                            "properties": {
                              "aspectRatio": {
                                "type": "string",
                                "enum": [
                                  "1:1",
                                  "1:4",
                                  "1:8",
                                  "2:3",
                                  "3:2",
                                  "3:4",
                                  "4:1",
                                  "4:3",
                                  "4:5",
                                  "5:4",
                                  "8:1",
                                  "9:16",
                                  "16:9",
                                  "21:9"
                                ],
                                "description": "目标宽高比；可用范围依模型不同。"
                              },
                              "imageSize": {
                                "type": "string",
                                "enum": ["0.5K", "1K", "2K", "4K"],
                                "description": "目标分辨率；可用范围依模型不同。"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "examples": [
                  {
                    "contents": [
                      {
                        "parts": [
                          {
                            "text": "把这只猫放到星空下的餐厅，保持原有外观。"
                          },
                          {
                            "inlineData": {
                              "mimeType": "image/png",
                              "data": "<base64-image-data>"
                            }
                          }
                        ]
                      }
                    ],
                    "generationConfig": {
                      "responseModalities": ["IMAGE"],
                      "responseFormat": {
                        "image": {
                          "aspectRatio": "16:9",
                          "imageSize": "2K"
                        }
                      }
                    }
                  }
                ]
              },
              "example": {
                "model": "gemini-3-pro-image-preview",
                "prompt": "换成蓝色的苹果",
                "size": "1024x1024",
                "quality": "medium",
                "n": 1,
