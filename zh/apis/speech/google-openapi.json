{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikway Google 语音合成 API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.tikway.ai"
    }
  ],
  "tags": [
    {
      "name": "语音合成/Google"
    }
  ],
  "paths": {
    "/v1/audio/speech": {
      "post": {
        "summary": "Google - 文转语音",
        "description": "通过平台标准语音字段调用 Google TTS，仅输出 WAV/PCM 或统一 SSE 事件。Google 扩展仅保留 language_code，可放入 extra_body 或直接置于顶层，顶层优先。模型需已在目标平台配置。",
        "operationId": "createSpeech",
        "tags": [
          "语音合成/Google"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "音频字节或统一 SSE 音频事件；支持的媒体类型见下方列表。",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "example1": {
                    "summary": "成功示例",
                    "value": "data: {\"type\":\"speech.audio.delta\",\"audio\":\"UklGRigAAABXQVZFZm10IBAAAAABAAEAwF0AAIC7AAACABAAZGF0YQQAAAAAAAEA\"}\n\ndata: {\"type\":\"speech.audio.done\",\"usage\":{\"input_tokens\":4,\"output_tokens\":2,\"total_tokens\":6}}\n\n"
                  }
                }
              },
              "audio/wav": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "audio/pcm": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "code": {
                          "type": [
                            "string",
                            "integer",
                            "null"
                          ]
                        },
                        "param": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "code": {
                          "type": [
                            "string",
                            "integer",
                            "null"
                          ]
                        },
                        "param": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "code": {
                          "type": [
                            "string",
                            "integer",
                            "null"
                          ]
                        },
                        "param": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "502": {
            "description": "Upstream error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "code": {
                          "type": [
                            "string",
                            "integer",
                            "null"
                          ]
                        },
                        "param": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "其他网关错误；根据 HTTP 状态码和 error.message 排查。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "code": {
                          "type": [
                            "string",
                            "integer",
                            "null"
                          ]
                        },
                        "param": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "title": "Gemini 请求体",
                "description": "沿用平台标准语音字段；Google 扩展仅保留 language_code，支持 extra_body 和顶层两种写法，顶层同名字段优先。",
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "description": "平台已配置的 Google TTS 模型 ID 或别名。文档中的 models/ 前缀来自 Google 模型目录，平台示例使用 google/ 前缀。",
                    "examples": [
                      "google/gemini-3.8-flash-tts",
                      "google/gemini-3.8-flash-lite-tts",
                      "google/gemini-3.1-flash-tts-preview"
                    ]
                  },
                  "input": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "description": "待朗读文本。4096 字符是当前网关统一请求的限制，不等于 Google 上游的 Token 上下文长度。",
                    "examples": [
                      "你好，欢迎使用语音合成。"
                    ]
                  },
                  "voice": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "id"
                        ]
                      }
                    ],
                    "description": "当前模型可用的预置音色名称或音色 ID，也接受包含 id 的对象。3.1/2.5 使用对应的通用预置音色；3.8 可引用项目可用的扩展或自定义 ID。",
                    "examples": [
                      "Kore",
                      "Arlo",
                      {
                        "id": "Kore"
                      }
                    ]
                  },
                  "instructions": {
                    "type": "string",
                    "maxLength": 4096,
                    "description": "统一风格指令。3.8 将风格与朗读正文分开处理；2.5/3.1 使用旧版提示文本。"
                  },
                  "response_format": {
                    "type": "string",
                    "enum": [
                      "wav",
                      "pcm"
                    ],
                    "default": "wav",
                    "description": "当前 Google 适配仅支持 WAV/PCM。wav 返回带容器头的音频；pcm 返回无文件头的 16 位线性 PCM。采样率沿用上游音频，不能仅凭此字段指定。"
                  },
                  "speed": {
                    "type": "number",
                    "minimum": 0.25,
                    "maximum": 4,
                    "default": 1,
                    "description": "网关统一语速参数，范围沿用标准协议。Google 通过自然语言风格提示实现，属于近似控制，不保证精确倍速或固定音频时长。"
                  },
                  "stream_format": {
                    "type": "string",
                    "enum": [
                      "audio",
                      "sse"
                    ],
                    "default": "audio",
                    "description": "audio 返回音频字节；sse 返回统一 speech.audio.delta / speech.audio.done 事件。当前 Google 适配先接收完整合成结果再输出 SSE，不代表已启用上游低延迟流式合成。"
                  },
                  "extra_body": {
                    "type": "object",
                    "properties": {
                      "language_code": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Google 语言提示，使用 BCP-47 代码，如 cmn-CN、en-US。支持范围由模型决定；不从音色试听的 en-US 标签推断。"
                      }
                    },
                    "additionalProperties": false,
                    "description": "Google 专有扩展；推荐放在这里。也兼容同名字段直接放在 body 顶层，顶层优先，仅展开一层，不对嵌套对象做深度合并。"
                  },
                  "language_code": {
                    "type": "string",
                    "minLength": 1,
                    "description": "兼容顶层扩展；优先于 extra_body 中同名字段。Google 语言提示，使用 BCP-47 代码，如 cmn-CN、en-US。支持范围由模型决定；不从音色试听的 en-US 标签推断。"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "model",
                  "input",
                  "voice"
                ],
                "examples": [
                  {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Kore"
                  },
                  {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Zephyr",
                    "response_format": "wav"
                  },
                  {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Puck",
                    "response_format": "pcm"
                  },
                  {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Kore",
                    "extra_body": {
                      "language_code": "cmn-CN"
                    }
                  },
                  {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "Hello, welcome to the speech synthesis demo.",
                    "voice": "Charon",
                    "language_code": "en-US"
                  },
                  {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Kore",
                    "instructions": "用温和、清晰、自然的语气朗读。",
                    "response_format": "wav"
                  },
                  {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Kore",
                    "instructions": "清晰朗读，句子之间自然停顿。",
                    "speed": 0.9
                  },
                  {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Kore",
                    "stream_format": "sse"
                  },
                  {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": {
                      "id": "Kore"
                    }
                  },
                  {
                    "model": "google/gemini-3.8-flash-lite-tts",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Cleo"
                  },
                  {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Arlo",
                    "response_format": "wav"
                  },
                  {
                    "model": "google/gemini-3.1-flash-tts-preview",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Puck",
                    "instructions": "自然、清楚地朗读。"
                  },
                  {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "Hello, use the language configured at the body root.",
                    "voice": "Kore",
                    "language_code": "en-US",
                    "extra_body": {
                      "language_code": "cmn-CN"
                    }
                  }
                ]
              },
              "examples": {
                "gemini_minimal": {
                  "summary": "最小请求：默认 WAV",
                  "value": {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Kore"
                  }
                },
                "gemini_wav": {
                  "summary": "WAV：显式指定输出格式",
                  "value": {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Zephyr",
                    "response_format": "wav"
                  }
                },
                "gemini_pcm": {
                  "summary": "PCM：无文件头音频",
                  "value": {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Puck",
                    "response_format": "pcm"
                  }
                },
                "gemini_chinese_extra_body": {
                  "summary": "中文：language_code 放入 extra_body",
                  "value": {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Kore",
                    "extra_body": {
                      "language_code": "cmn-CN"
                    }
                  }
                },
                "gemini_english_root": {
                  "summary": "英文：language_code 放在顶层",
                  "value": {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "Hello, welcome to the speech synthesis demo.",
                    "voice": "Charon",
                    "language_code": "en-US"
                  }
                },
                "gemini_instructions": {
                  "summary": "风格：统一 instructions 参数",
                  "value": {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Kore",
                    "instructions": "用温和、清晰、自然的语气朗读。",
                    "response_format": "wav"
                  }
                },
                "gemini_speed": {
                  "summary": "语速：近似减慢朗读",
                  "description": "Google 通过自然语言提示控制速度，不保证精确倍速。",
                  "value": {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Kore",
                    "instructions": "清晰朗读，句子之间自然停顿。",
                    "speed": 0.9
                  }
                },
                "gemini_sse": {
                  "summary": "SSE：统一音频事件",
                  "description": "当前 Google 适配先完成音频合成，再封装为统一 SSE 事件。",
                  "value": {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Kore",
                    "stream_format": "sse"
                  }
                },
                "gemini_voice_object": {
                  "summary": "音色：包含 id 的标准对象",
                  "value": {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": {
                      "id": "Kore"
                    }
                  }
                },
                "gemini_lite": {
                  "summary": "3.8 Flash-Lite：预置音色 Cleo",
                  "value": {
                    "model": "google/gemini-3.8-flash-lite-tts",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Cleo"
                  }
                },
                "gemini_extended_voice": {
                  "summary": "3.8 Flash：目录音色 Arlo",
                  "value": {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Arlo",
                    "response_format": "wav"
                  }
                },
                "gemini_31_preview": {
                  "summary": "3.1 预览版：通用预置音色",
                  "value": {
                    "model": "google/gemini-3.1-flash-tts-preview",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Puck",
                    "instructions": "自然、清楚地朗读。"
                  }
                },
                "gemini_root_wins": {
                  "summary": "同名扩展：顶层语言优先",
                  "description": "实际使用顶层 language_code=en-US。",
                  "value": {
                    "model": "google/gemini-3.8-flash-tts",
                    "input": "Hello, use the language configured at the body root.",
                    "voice": "Kore",
                    "language_code": "en-US",
                    "extra_body": {
                      "language_code": "cmn-CN"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
