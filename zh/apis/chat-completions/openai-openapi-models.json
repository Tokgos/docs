{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAI 模型列表",
    "description": "获取平台全部可调用模型，以 OpenAI 协议返回，并包含 aliases、architecture 和 capabilities。",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "对话补全"
    },
    {
      "name": "对话补全/OpenAI 协议"
    }
  ],
  "paths": {
    "/v1/models": {
      "get": {
        "summary": "Get Models",
        "deprecated": false,
        "description": "获取当前网关具有可调用端点的模型目录。默认返回全部类型，可用 type 按 text、image、video、music、embedding 筛选；多个类型用逗号分隔，或重复传 type，结果取并集。\n\n响应兼容 OpenAI object=list/data 结构，并提供 aliases、architecture、capabilities 和视频模型的 video_attributes。capabilities.parameters.common 为所有可调用端点共有的参数，端点键下仅列该端点的额外参数；端点完整参数集为 common 与端点数组的并集。\n\n本条目描述普通 OpenAI 格式。携带 anthropic-version 请求头会切换为 Anthropic 模型列表格式，应使用对应协议客户端解析。",
        "operationId": "getModels",
        "tags": [
          "对话补全/OpenAI 协议"
        ],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "按模型类型筛选，省略返回全部。支持 text/image/video/music/embedding，忽略大小写和周围空格。多个类型逗号分隔或重复 type，未知或空值返回 400。",
            "required": false,
            "example": "image,video",
            "schema": {
              "type": "string",
              "minLength": 1,
              "examples": [
                "text",
                "image",
                "video",
                "music",
                "embedding",
                "image,video"
              ]
            }
          },
          {
            "name": "x-provider-route",
            "in": "header",
            "description": "上游速度cost、stable、fast",
            "example": "cost",
            "schema": {
              "type": "string",
              "default": "cost"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "当前可调用模型目录；示例能力值仅用于展示结构，实际以返回值为准。",
            "content": {
              "application/json": {
                "schema": {
                  "title": "OpenAIModelsResponse",
                  "description": "GET /v1/models 的 HTTP 200 响应。返回平台完整可调用模型目录；公共元数据来自平台配置。",
                  "type": "object",
                  "required": [
                    "object",
                    "data"
                  ],
                  "properties": {
                    "object": {
                      "type": "string",
                      "const": "list"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "aliases",
                          "context_length",
                          "architecture",
                          "capabilities",
                          "object",
                          "created",
                          "owned_by"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "平台模型 ID。存在供应商命名空间时完整保留，例如 google/gemini-3.8-flash。",
                            "minLength": 1
                          },
                          "name": {
                            "type": "string",
                            "description": "模型显示名称。"
                          },
                          "aliases": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "模型的可用别名，来自当前平台配置；未配置时返回空数组。"
                          },
                          "context_length": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0,
                            "description": "上下文 token 上限，未配置时为 null。"
                          },
                          "max_output_tokens": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "配置时返回的最大输出 token 数；未配置时省略。"
                          },
                          "architecture": {
                            "type": "object",
                            "required": [
                              "input_modalities",
                              "output_modalities"
                            ],
                            "properties": {
                              "input_modalities": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "output_modalities": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            },
                            "description": "模型可接受和可输出的模态，按平台配置及实际可调用端点生成。",
                            "additionalProperties": false
                          },
                          "capabilities": {
                            "type": "object",
                            "required": [
                              "reasoning_efforts",
                              "endpoints",
                              "parameters"
                            ],
                            "properties": {
                              "reasoning_efforts": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "按实际端点参数配置汇总的推理档位；无可配置档位时返回空数组。"
                              },
                              "endpoints": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "minItems": 1,
                                "description": "模型当前实际可调用的 API 路径，来自平台路由配置。"
                              },
                              "parameters": {
                                "type": "object",
                                "required": [
                                  "common"
                                ],
                                "properties": {
                                  "common": {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    }
                                  }
                                },
                                "additionalProperties": {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  }
                                },
                                "description": "common 为所有可调用端点共有的参数，各端点路径下只列额外参数。该端点的完整参数集为 common 与端点数组的并集；单端点模型的参数可全部位于 common。",
                                "examples": [
                                  {
                                    "/v1/videos": [],
                                    "common": [
                                      "seed",
                                      "model",
                                      "prompt",
                                      "duration",
                                      "extra_body",
                                      "resolution",
                                      "aspect_ratio",
                                      "callback_url",
                                      "frame_images",
                                      "input_references"
                                    ]
                                  }
                                ]
                              }
                            },
                            "description": "当前平台定义的端点、参数和推理档位。与其他协议格式中的这组字段一致。",
                            "additionalProperties": false
                          },
                          "object": {
                            "type": "string",
                            "const": "model"
                          },
                          "owned_by": {
                            "type": "string",
                            "description": "模型系列名称；未配置时使用模型 ID 的供应商命名空间。"
                          },
                          "video_attributes": {
                            "type": "object",
                            "required": [
                              "modes",
                              "resolutions",
                              "default_resolution",
                              "min_duration_seconds",
                              "max_duration_seconds",
                              "supports_audio",
                              "aspect_ratios"
                            ],
                            "properties": {
                              "modes": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "resolutions": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "default_resolution": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "min_duration_seconds": {
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              },
                              "max_duration_seconds": {
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              },
                              "supports_audio": {
                                "type": [
                                  "boolean",
                                  "null"
                                ]
                              },
                              "aspect_ratios": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            },
                            "description": "仅视频模型返回。未配置的标量为 null，列表可为空；具体输入组合仍须遵循模型 API 限制。",
                            "additionalProperties": false
                          },
                          "created": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "模型创建时间，Unix 秒；未配置时当前返回 0。",
                            "examples": [
                              0
                            ]
                          },
                          "top_provider": {
                            "type": "object",
                            "required": [
                              "max_completion_tokens"
                            ],
                            "properties": {
                              "max_completion_tokens": {
                                "type": "integer",
                                "minimum": 0,
                                "description": "与 max_output_tokens 相同的最大输出 token 数。"
                              }
                            },
                            "additionalProperties": false,
                            "description": "配置 max_output_tokens 时返回。"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  },
                  "additionalProperties": false,
                  "examples": [
                    {
                      "object": "list",
                      "data": [
                        {
                          "id": "happyhorse-1.0",
                          "name": "HappyHorse 1.0",
                          "aliases": [
                            "happyhorse-1.0",
                            "happyhorse-1.0-20260624"
                          ],
                          "architecture": {
                            "input_modalities": [
                              "text",
                              "image",
                              "video"
                            ],
                            "output_modalities": [
                              "video"
                            ]
                          },
                          "capabilities": {
                            "endpoints": [
                              "/v1/videos"
                            ],
                            "parameters": {
                              "/v1/videos": [],
                              "common": [
                                "seed",
                                "model",
                                "prompt",
                                "duration",
                                "extra_body",
                                "resolution",
                                "aspect_ratio",
                                "callback_url",
                                "frame_images",
                                "input_references"
                              ]
                            },
                            "reasoning_efforts": []
                          },
                          "context_length": null,
                          "object": "model",
                          "created": 0,
                          "owned_by": "HappyHorse",
                          "video_attributes": {
                            "modes": [],
                            "resolutions": [],
                            "default_resolution": null,
                            "min_duration_seconds": null,
                            "max_duration_seconds": null,
                            "supports_audio": null,
                            "aspect_ratios": []
                          }
                        }
                      ]
                    }
                  ]
                },
                "example": {
                  "object": "list",
                  "data": [
                    {
                      "id": "happyhorse-1.0",
                      "name": "HappyHorse 1.0",
                      "aliases": [
                        "happyhorse-1.0",
                        "happyhorse-1.0-20260624"
                      ],
                      "architecture": {
                        "input_modalities": [
                          "text",
                          "image",
                          "video"
                        ],
                        "output_modalities": [
                          "video"
                        ]
                      },
                      "capabilities": {
                        "endpoints": [
                          "/v1/videos"
                        ],
                        "parameters": {
                          "/v1/videos": [],
                          "common": [
                            "seed",
                            "model",
                            "prompt",
                            "duration",
                            "extra_body",
                            "resolution",
                            "aspect_ratio",
                            "callback_url",
                            "frame_images",
                            "input_references"
                          ]
                        },
                        "reasoning_efforts": []
                      },
                      "context_length": null,
                      "object": "model",
                      "created": 0,
                      "owned_by": "HappyHorse",
                      "video_attributes": {
                        "modes": [],
                        "resolutions": [],
                        "default_resolution": null,
                        "min_duration_seconds": null,
                        "max_duration_seconds": null,
                        "supports_audio": null,
                        "aspect_ratios": []
                      }
                    }
                  ]
                }
              }
            },
            "headers": {}
          },
          "400": {
            "description": "type 包含未知类型或空值。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "param": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "code": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  }
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "webhooks": {},
  "components": {
    "schemas": {},
    "responses": {},
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [],
  "security": [
    {
      "bearer": []
    }
  ]
}
