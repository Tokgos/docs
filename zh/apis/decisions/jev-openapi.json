                  {
                    "model": "typesafe/jev-latest",
                    "state": {
                      "ticket": {
                        "message": "发票抬头写错了，需要重新开票。",
                        "invoice_issued": true
                      }
                    },
                    "questions": {
                      "needs_reissue": {
                        "type": "noul",
                        "instructions": {
                          "question": "根据 ticket.message 和 ticket.invoice_issued，是否需要重新开具已开出的发票？"
                        },
                        "criteria": {
                          "true": "发票已经开出，且用户明确要求修改或重新开具。",
                          "false": "尚未开票，或用户没有要求修改已有发票。"
                        }
                      },
                      "department": {
                        "type": "choice",
                        "instructions": "根据 ticket.message 判断负责部门。",
                        "criteria": {
                          "billing": {
                            "scope": [
                              "开票",
                              "付款",
                              "退款"
                            ]
                          },
                          "technical": {
                            "scope": [
                              "功能故障",
                              "接口异常"
                            ]
                          }
                        }
                      }
                    }
                  }
                ]
              },
