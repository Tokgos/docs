        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "description": "模型 ID。本网关示例为 typesafe/jev-latest；TypeSafe 官方接口示例为 jev-latest。",
                    "examples": [
                      "typesafe/jev-latest",
                      "jev-latest"
                    ]
                  },
                  "state": {
                    "type": [
                      "string",
                      "object",
                      "array"
                    ],
                    "description": "所有问题共享的待评估材料，可以是纯文本、结构化记录或数组。",
                    "examples": [
                      "我被重复扣款了两次，请今天帮我处理退款，其他功能还能正常使用。",
                      {
                        "ticket": {
                          "message": "发票抬头写错了，需要重新开票。",
                          "invoice_issued": true
                        }
                      },
                      [
                        {
                          "role": "user",
                          "content": "已经联系三次了，请安排人工处理退款。"
                        }
                      ]
                    ]
                  },
                  "questions": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "const": "noul",
                              "type": "string",
                              "description": "判断一个是非问题，答案表示是的概率。"
                            },
                            "instructions": {
                              "type": [
                                "string",
                                "object",
                                "array"
                              ],
                              "description": "待判断的是非问题或命题。可使用结构化内容补充问题需要引用的数据。",
                              "examples": [
                                "用户是否明确要求当天处理？"
                              ]
                            },
                            "criteria": {
                              "type": "object",
                              "properties": {
                                "true": {
                                  "type": [
                                    "string",
                                    "object",
                                    "array"
                                  ],
                                  "description": "什么情况应判断为是。"
                                },
                                "false": {
                                  "type": [
                                    "string",
                                    "object",
                                    "array"
                                  ],
                                  "description": "什么情况应判断为否。"
                                }
                              },
                              "additionalProperties": false,
                              "description": "可选的判断标准，分别解释是和否的含义。",
                              "examples": [
                                {
                                  "true": "用户明确提到今天、当天或具体的紧迫期限。",
                                  "false": "用户没有表达处理期限。"
                                }
                              ]
                            }
                          },
                          "required": [
                            "type",
                            "instructions"
                          ],
                          "additionalProperties": true,
                          "title": "Noul：是非判断"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "const": "choice",
                              "type": "string",
                              "description": "从给定选项中选择一项。"
                            },
                            "instructions": {
                              "type": [
                                "string",
                                "object",
                                "array"
                              ],
                              "description": "需要模型作出的选择及判断要求。",
                              "examples": [
                                "应该交给哪个部门处理？"
                              ]
                            },
                            "criteria": {
                              "type": "object",
                              "minProperties": 2,
                              "maxProperties": 255,
                              "additionalProperties": {
                                "type": [
                                  "string",
                                  "object",
                                  "array",
                                  "null"
                                ]
                              },
                              "description": "以选项标识为键、选项说明为值的对象。本网关要求 2–255 个选项；不需要说明时可使用 null。",
                              "examples": [
                                {
                                  "billing": "账单、扣款和退款问题",
                                  "technical": "产品功能和技术故障",
                                  "other": null
                                }
                              ]
                            }
                          },
                          "required": [
                            "type",
                            "instructions",
                            "criteria"
                          ],
                          "additionalProperties": true,
                          "title": "Choice：选项判断"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "const": "score",
                              "type": "string",
                              "description": "根据有序等级评估输入。"
                            },
                            "instructions": {
                              "type": [
                                "string",
                                "object",
                                "array"
                              ],
                              "description": "需要评估的维度及评分要求。",
                              "examples": [
                                "按对正常使用的影响程度评估问题严重性。"
                              ]
                            },
                            "criteria": {
                              "type": "array",
                              "items": {
                                "type": [
                                  "string",
                                  "object",
                                  "array"
                                ]
                              },
                              "minItems": 2,
                              "maxItems": 10,
                              "description": "按从低到高的顺序排列的等级描述，序号从 0 开始，共 2–10 级。每级可使用文本、对象或数组。",
                              "examples": [
                                [
                                  "轻微问题，其他功能仍可正常使用。",
                                  "部分操作受阻，但存在临时替代方案。",
                                  "核心流程完全无法继续，且没有替代方案。"
                                ]
                              ]
                            }
                          },
                          "required": [
                            "type",
                            "instructions",
                            "criteria"
                          ],
                          "additionalProperties": true,
                          "title": "Score：等级评分"
                        }
                      ]
                    },
                    "description": "以自定义问题 ID 为键的对象。答案按相同 ID 返回；问题 ID 不会提供给模型，判断要求必须写在 instructions 中。",
                    "properties": {}
                  }
                },
                "required": [
                  "model",
                  "state",
                  "questions"
                ],
                "additionalProperties": true,
                "title": "Jev 原生请求 Body",
                "description": "用于 POST /v1/systemone，采用 TypeSafe 官方原生请求结构。调用本网关时使用模型广场中的 typesafe/jev-latest；直接调用 TypeSafe 官方接口时使用 jev-latest。字段依据 https://docs.typesafe.ai/api。",
                "examples": [
                  {
                    "model": "typesafe/jev-latest",
                    "state": "我被重复扣款了两次，请今天帮我处理退款，其他功能还能正常使用。",
                    "questions": {
                      "urgent": {
                        "type": "noul",
                        "instructions": "用户是否明确要求当天处理？",
                        "criteria": {
                          "true": "用户明确提到今天、当天或具体的紧迫期限。",
                          "false": "用户没有表达处理期限。"
                        }
                      },
                      "department": {
                        "type": "choice",
                        "instructions": "应该交给哪个部门处理？",
                        "criteria": {
                          "billing": "账单、扣款和退款问题",
                          "technical": "产品功能和技术故障"
                        }
                      },
                      "severity": {
                        "type": "score",
                        "instructions": "按对正常使用的影响程度评估问题严重性。",
                        "criteria": [
                          "轻微问题，其他功能仍可正常使用。",
                          "部分操作受阻，但存在临时替代方案。",
                          "核心流程完全无法继续，且没有替代方案。"
                        ]
                      }
                    }
                  },
                  {
                    "model": "typesafe/jev-latest",
                    "state": "请帮我取消下个月的自动续费。",
                    "questions": {
                      "cancel_subscription": {
                        "type": "noul",
                        "instructions": "用户是否要求取消订阅或关闭自动续费？"
                      }
                    }
                  },
                  {
                    "model": "typesafe/jev-latest",
                    "state": "发票抬头写错了，需要重新开票。",
                    "questions": {
                      "ticket_category": {
                        "type": "choice",
                        "instructions": "将工单分配到最合适的业务类别。",
                        "criteria": {
                          "invoice": "发票开具、修改或重开",
                          "refund": "退款或重复扣款",
                          "account": "登录、权限或账户资料",
                          "other": null
                        }
                      }
                    }
                  },
                  {
                    "model": "typesafe/jev-latest",
                    "state": "页面加载有点慢，但刷新后可以正常完成操作。",
                    "questions": {
                      "impact": {
                        "type": "score",
                        "instructions": "评估故障对完成操作的影响。",
                        "criteria": [
                          "体验下降，但操作仍可完成。",
                          "需要绕过故障才能完成操作。",
                          "操作无法完成。"
                        ]
                      }
