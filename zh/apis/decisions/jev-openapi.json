{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikway Jev 决策评估 API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.tikway.ai"
    }
  ],
  "tags": [
    {
      "name": "判断/Jev"
    }
  ],
  "paths": {
    "/v1/decisions": {
      "post": {
        "summary": "Jev - 决策评估",
        "description": "OpenAI Decisions 格式：input + questions 数组；answers 顺序与问题一致，支持 predicate、choice、score 及 refusal。支持通过端点配置调用 TypeSafe Jev。跨协议时问题 name 必须唯一；字符串和布尔选项转换成同一个键时返回参数错误。\n\n示例模型 ID 必须已在目标环境配置，并关联可用账号和端点。",
        "operationId": "createDecision",
        "tags": [
          "判断/Jev"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "类型化决策答案和用量。未返回输出 Token 的上游可省略 completion_tokens，转换为 TypeSafe 时补 0。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionsResponse"
                },
                "examples": {
                  "example1": {
                    "summary": "typesafe_backend",
                    "value": {
                      "model": "typesafe/jev-latest",
                      "answers": [
                        {
                          "name": "urgent",
                          "probability": 0.82,
                          "type": "predicate"
                        },
                        {
                          "choice": "billing",
                          "confidence": 1,
                          "name": "department",
                          "probabilities": [
                            {
                              "probability": 1,
                              "value": "billing"
                            },
                            {
                              "probability": 0,
                              "value": "technical"
                            }
                          ],
                          "type": "choice"
                        },
                        {
                          "confidence": 0.58,
                          "legend": {
                            "0": "Minor",
                            "1": "Workaround available",
                            "2": "Fully blocked"
                          },
                          "name": "severity",
                          "probabilities": [
                            {
                              "label": "Minor",
                              "probability": 0.74,
                              "value": 0
                            },
                            {
                              "label": "Workaround available",
                              "probability": 0.24,
                              "value": 1
                            },
                            {
                              "label": "Fully blocked",
                              "probability": 0.02,
                              "value": 2
                            }
                          ],
                          "score": 0.28,
                          "type": "score"
                        }
                      ],
                      "usage": {
                        "completion_tokens": 61,
                        "prompt_tokens": 375,
                        "total_tokens": 436
                      }
                    }
                  },
                  "example2": {
                    "summary": "openai",
                    "value": {
                      "model": "openai/gpt-6-luna",
                      "answers": [
                        {
                          "name": "urgent",
                          "probability": 0.82,
                          "type": "predicate"
                        },
                        {
                          "choice": "billing",
                          "confidence": 1,
                          "name": "department",
                          "probabilities": [
                            {
                              "probability": 1,
                              "value": "billing"
                            },
                            {
                              "probability": 0,
                              "value": "technical"
                            }
                          ],
                          "type": "choice"
                        },
                        {
                          "confidence": 0.58,
                          "legend": {
                            "0": "Minor",
                            "1": "Workaround available",
                            "2": "Fully blocked"
                          },
                          "name": "severity",
                          "probabilities": [
                            {
                              "label": "Minor",
                              "probability": 0.74,
                              "value": 0
                            },
                            {
                              "label": "Workaround available",
                              "probability": 0.24,
                              "value": 1
                            },
                            {
                              "label": "Fully blocked",
                              "probability": 0.02,
                              "value": 2
                            }
                          ],
                          "score": 0.28,
                          "type": "score"
                        }
                      ],
                      "usage": {
                        "completion_tokens_details": {},
                        "prompt_tokens": 383,
                        "prompt_tokens_details": {
                          "cache_write_tokens": 0,
                          "cached_tokens": 0
                        },
                        "total_tokens": 383
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
