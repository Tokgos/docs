{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikway FLUX 3 Video 视频 API",
    "description": "Black Forest Labs（经 TTAPI） FLUX 3 Video 模型的 OpenAI 兼容异步视频生成接口。",
    "version": "1.1.0"
  },
  "tags": [
    {
      "name": "视频生成"
    },
    {
      "name": "视频生成/FLUX 3 Video"
    }
  ],
  "paths": {
    "/v1/videos": {
      "post": {
        "summary": "创建 FLUX 3 Video 视频",
        "deprecated": false,
        "description": "通过统一的 `POST /v1/videos` 创建 FLUX 3 Video 视频任务。模型能力以当前 Tikway 网关实际可调用范围为准。\n\n| 模型 | 分辨率 | 时长 | 支持模式 | 音频 | 参考限制 |\n| --- | --- | --- | --- | --- | --- |\n| `flux-3-video` | HD / FHD（统一字段映射 480p/720p → HD，1080p → FHD） | 5–20 秒或 auto | 文生、1–10 关键帧、视频续写、草稿增强 | 支持，默认开启 | 不支持普通音频/视频风格参考 |\n\n官网能力与当前网关未开放能力之间的差异见本次审计报告。",
        "tags": [
          "视频生成/FLUX 3 Video"
        ],

        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "FLUX 3 VideoVideoCreateRequest",
                "description": "创建 FLUX 3 Video 视频任务。参数按当前 Tikway 网关能力收窄；模型之间的差异见 operation 描述与 x-model-capabilities。",
                "type": "object",
                "required": [
                  "model"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "enum": [
                      "flux-3-video"
                    ],
                    "description": "FLUX 3 Video 模型 ID。"
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "description": "视频生成或编辑提示词。"
                  },
                  "duration": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 5,
                        "maximum": 20
                      },
                      {
                        "type": "string",
                        "enum": [
                          "auto"
                        ]
                      }
                    ],
                    "description": "5–20 秒整数，或 auto 让模型按内容决定时长。"
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "21:9",
                      "2:1",
                      "16:9",
                      "4:3",
                      "1:1",
                      "3:4",
                      "9:16"
                    ],
                    "description": "视频宽高比。图生视频时，部分模型会按输入素材自动决定比例。"
                  },
                  "resolution": {
                    "type": "string",
                    "enum": [
                      "480p",
                      "720p",
                      "1080p"
                    ],
                    "description": "输出分辨率。不同模型或模式的可用值见模型能力表。"
                  },
                  "frame_images": {
                    "type": "array",
                    "maxItems": 2,
                    "description": "首帧/尾帧快捷写法。更多关键帧请通过 input_references 传 1–10 张 reference_image，或在 extra_body.keyframes 中指定带时间点的关键帧。",
                    "items": {
                      "type": "object",
                      "required": [
                        "type",
                        "image_url"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "first_frame",
                            "last_frame"
                          ],
                          "description": "参考帧位置。"
                        },
                        "image_url": {
                          "type": "string",
                          "minLength": 1,
                          "format": "uri",
                          "description": "参考图 URL 字符串。"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "input_references": {
                    "type": "array",
                    "maxItems": 10,
                    "description": "图生视频可传 1–10 张 reference_image 作为关键帧；视频续写必须且只能传 1 个 source_video 或 first_clip。",
                    "items": {
                      "type": "object",
                      "oneOf": [
                        {
                          "required": [
                            "image_url"
                          ]
                        },
                        {
                          "required": [
                            "video_url"
                          ]
                        }
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "image_url",
                            "video_url"
                          ],
                          "description": "可选。素材类型；若提供，必须与对应 URL 字段一致。"
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "reference_image",
                            "source_video",
                            "first_clip"
                          ],
                          "description": "素材用途。省略时按 URL 字段推断为普通参考素材。"
                        },
                        "image_url": {
                          "type": "string",
                          "minLength": 1,
                          "format": "uri",
                          "description": "图片 URL 字符串。"
                        },
                        "video_url": {
                          "type": "string",
                          "minLength": 1,
                          "format": "uri",
                          "description": "视频 URL 字符串。"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "generate_audio": {
                    "type": "boolean",
                    "description": "是否生成同步音频，默认 true。"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://",
                    "description": "用户任务回调地址。由 Tikway 在任务状态变化后调用，不直接传给模型上游。"
                  },
                  "extra_body": {
                    "type": "object",
                    "description": "FLUX 3 Video 原生扩展参数。",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": [
                          "text_to_video",
                          "image_to_video",
                          "video_to_video",
                          "draft_enhance"
                        ]
                      },
                      "keyframes": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "array",
                            "items": {}
                          }
                        ],
                        "description": "1–10 张图片，或按 [秒数, 图片 URL] 排列的定时关键帧。"
                      },
                      "start_video": {
                        "type": "string",
                        "format": "uri",
                        "description": "视频续写输入。"
                      },
                      "draft_cache": {
                        "type": "string",
                        "description": "草稿增强所需的缓存 URL 或 Base64。"
                      },
                      "version": {
                        "type": "string",
                        "enum": [
                          "latest"
                        ]
                      },
                      "safety_tolerance": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4,
                        "default": 2
                      },
                      "draft": {
                        "type": "boolean",
                        "default": false,
                        "description": "是否先生成低成本 HD 草稿。"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false,
                "x-model-capabilities": [
                  {
                    "model": "flux-3-video",
                    "resolution": "HD / FHD（统一字段映射 480p/720p → HD，1080p → FHD）",
                    "duration": "5–20 秒或 auto",
                    "modes": "文生、1–10 关键帧、视频续写、草稿增强",
                    "audio": "支持，默认开启",
                    "references": "不支持普通音频/视频风格参考"
                  }
                ]
              },
              "examples": {
                "文生视频": {
                  "summary": "文生视频",
                  "value": {
                    "model": "flux-3-video",
                    "prompt": "一只金毛寻回犬在日落时分的海滩上奔跑，镜头平稳跟随，画面具有自然细腻的电影质感。",
                    "duration": 8,
                    "resolution": "1080p",
                    "aspect_ratio": "16:9",
                    "generate_audio": true
                  }
                },
                "首尾帧生视频": {
                  "summary": "首尾帧生视频",
                  "value": {
                    "model": "flux-3-video",
                    "prompt": "从首帧自然过渡到尾帧，保持主体、构图与视觉风格连贯。",
                    "duration": 10,
                    "resolution": "720p",
                    "frame_images": [
                      {
                        "type": "first_frame",
                        "image_url": "https://example.com/assets/first-frame.jpg"
                      },
                      {
                        "type": "last_frame",
                        "image_url": "https://example.com/assets/last-frame.jpg"
                      }
                    ]
                  }
                },
                "多关键帧": {
                  "summary": "多关键帧",
                  "value": {
                    "model": "flux-3-video",
                    "prompt": "按三个关键画面生成连续的电影分镜。",
                    "duration": 12,
                    "resolution": "720p",
                    "input_references": [
                      {
                        "image_url": "https://example.com/assets/keyframe-1.jpg",
                        "role": "reference_image"
                      },
                      {
                        "image_url": "https://example.com/assets/keyframe-2.jpg",
                        "role": "reference_image"
                      },
                      {
                        "image_url": "https://example.com/assets/keyframe-3.jpg",
                        "role": "reference_image"
                      }
                    ]
                  }
                },
                "视频续写": {
                  "summary": "视频续写",
                  "value": {
                    "model": "flux-3-video",
                    "prompt": "延续原视频的镜头运动、主体动作与光线，让场景自然向后发展。",
                    "duration": 8,
                    "resolution": "1080p",
                    "input_references": [
                      {
                        "video_url": "https://example.com/assets/source.mp4",
                        "role": "first_clip"
                      }
                    ]
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$id": "https://api.example.com/schemas/videos/create-response.json",
                  "title": "创建视频任务响应",
                  "description": "POST /v1/videos 创建视频任务成功后的响应参数，接口返回 HTTP 202。",
                  "type": "object",
                  "required": [
                    "id",
                    "status",
                    "polling_url"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "视频生成任务的唯一标识，用于后续查询任务状态。",
                      "examples": [
                        "9552de3d-171f-4cca-b492-7baa56523239"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "queue"
                      ],
                      "description": "任务创建状态。pending 表示任务已创建、等待提交处理；queue 表示任务已进入生成队列。",
                      "examples": [
                        "queue"
                      ]
                    },
                    "polling_url": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://",
                      "description": "视频任务查询地址，客户端可通过 GET 请求轮询任务状态。",
                      "examples": [
                        "https://api.example.com/v1/videos/9552de3d-171f-4cca-b492-7baa56523239"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "id": "9552de3d-171f-4cca-b492-7baa56523239",
                  "status": "pending",
                  "polling_url": "https://api.tikway.ai/v1/videos/9552de3d-171f-4cca-b492-7baa56523239"
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/videos/{id}": {
      "get": {
        "summary": "查询 FLUX 3 Video 视频任务",
        "deprecated": false,
        "description": "",
        "tags": [
          "视频生成/FLUX 3 Video"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "视频生成任务的唯一标识符。",
            "required": true,
            "example": "8f7c2e41-5a93-4b16-9d72-3c84e1a6f205",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-debugger-mode",
            "in": "header",
            "description": "",
            "example": "true",
            "schema": {
              "type": "string",
              "default": "true"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$id": "https://api.example.com/schemas/videos/retrieve-response.json",
                  "title": "查询视频任务响应",
                  "description": "GET /v1/videos/{id} 的响应参数。只有任务状态为 completed 时才返回 data。",
                  "type": "object",
                  "required": [
                    "created",
                    "id",
                    "model",
                    "prompt",
                    "status",
                    "usage"
                  ],
                  "properties": {
                    "created": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "视频任务创建时间，Unix 时间戳，单位为秒。",
                      "examples": [
                        1789108566
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "视频生成任务的唯一标识。",
                      "examples": [
                        "9552de3d-171f-4cca-b492-7baa56523239"
                      ]
                    },
                    "model": {
                      "type": "string",
                      "minLength": 1,
                      "description": "创建视频任务时使用的模型 ID。",
                      "examples": [
                        "bytedance/seedance-2.0-mini"
                      ]
                    },
                    "prompt": {
                      "type": "string",
                      "description": "创建视频任务时提交的提示词。",
                      "examples": [
                        "一只金毛犬在日落时分的海滩上奔跑，镜头平稳跟随，画面呈现自然细腻的电影质感"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "queue",
                        "in_progress",
                        "completed",
                        "failed",
                        "cancelled",
                        "expired"
                      ],
                      "description": "任务状态。pending 表示等待处理；queue 表示排队中；in_progress 表示生成或平台处理进行中；completed 表示视频和 OSS 资源均已处理完成；failed 表示失败；cancelled 表示已取消；expired 表示已过期。",
                      "examples": [
                        "in_progress"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "description": "视频任务结果。仅当 status 为 completed 时返回。",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "video_url"
                            ],
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "video_url"
                                ],
                                "description": "平台 OSS 视频"
                              },
                              "video_url": {
                                "type": "string",
                                "format": "uri",
                                "description": "平台 OSS 视频地址，有效期为24小时"
                              }
                            },
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "native_url"
                            ],
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "native_url"
                                ],
                                "description": "供应商原始视频"
                              },
                              "native_url": {
                                "type": "string",
                                "format": "uri",
                                "description": "供应商返回的原始视频地址"
                              }
                            },
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "first_url",
                              "last_url"
                            ],
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "frame"
                                ],
                                "description": "视频首尾帧"
                              },
                              "first_url": {
                                "type": "string",
                                "format": "uri",
                                "description": "视频首帧地址，有效期为24小时"
                              },
                              "last_url": {
                                "type": "string",
                                "format": "uri",
                                "description": "视频尾帧地址，有效期为24小时"
                              }
                            },
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "usage": {
                      "type": "object",
                      "description": "视频任务的使用量信息。",
                      "required": [
                        "video_seconds"
                      ],
                      "properties": {
                        "video_seconds": {
                          "description": "生成视频的时长，单位为秒。暂时无法确定时可能为 null。",
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "examples": [
                            4
                          ]
                        }
                      },
                      "additionalProperties": false
                    },
                    "error": {
                      "type": "object",
                      "description": "任务失败信息。通常仅在 status 为 failed 时返回。",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "description": "供应商或平台返回的错误码。",
                          "examples": [
                            "video_generation_failed"
                          ]
                        },
                        "message": {
                          "type": "string",
                          "description": "任务失败的具体原因。",
                          "examples": [
                            "Video generation failed."
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "status": {
                            "const": "completed"
                          }
                        },
                        "required": [
                          "status"
                        ]
                      },
                      "then": {
                        "required": [
                          "data"
                        ]
                      },
                      "else": {
                        "not": {
                          "required": [
                            "data"
                          ]
                        }
                      }
                    }
                  ],
                  "additionalProperties": false
                },
                "examples": {
                  "进行中": {
                    "summary": "进行中",
                    "value": {
                      "created": 1789108566,
                      "id": "9552de3d-171f-4cca-b492-7baa56523239",
                      "model": "flux-3-video",
                      "prompt": "一只金毛犬在日落时分的海滩上奔跑，镜头平稳跟随，海风吹动毛发，画面呈现自然细腻的电影质感",
                      "status": "in_progress",
                      "usage": {
                        "video_seconds": 4
                      }
                    }
                  },
                  "已完成": {
                    "summary": "已完成",
                    "value": {
                      "created": 1789108566,
                      "id": "9552de3d-171f-4cca-b492-7baa56523239",
                      "model": "flux-3-video",
                      "prompt": "一只金毛犬在日落时分的海滩上奔跑，镜头平稳跟随，海风吹动毛发，画面呈现自然细腻的电影质感",
                      "status": "completed",
                      "data": [
                        {
                          "type": "video_url",
                          "video_url": "https://oss.example.com/temp/2026/09/11/video.mp4?expires=86400"
                        },
                        {
                          "type": "native_url",
                          "native_url": "https://provider.example.com/videos/video.mp4?expires=86400"
                        },
                        {
                          "type": "frame",
                          "first_url": "https://oss.example.com/temp/2026/09/11/video.mp4?x-oss-process=video%2Fsnapshot%2Ct_0%2Cf_jpg%2Cw_0%2Ch_0",
                          "last_url": "https://oss.example.com/temp/2026/09/11/video.mp4?x-oss-process=video%2Fsnapshot%2Ct_3999%2Cf_jpg%2Cw_0%2Ch_0"
                        }
                      ],
                      "usage": {
                        "video_seconds": 4
                      }
                    }
                  }
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "webhooks": {},
  "components": {
    "schemas": {},
    "responses": {},
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "https://api.tikway.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ]
}
