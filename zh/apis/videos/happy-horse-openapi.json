{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikway HappyHorse 视频 API",
    "description": "阿里云百炼 HappyHorse 模型的 OpenAI 兼容异步视频生成接口。",
    "version": "1.1.0"
  },
  "tags": [
    {
      "name": "视频生成"
    },
    {
      "name": "视频生成/HappyHorse"
    }
  ],
  "paths": {
    "/v1/videos": {
      "post": {
        "summary": "创建 HappyHorse 视频",
        "deprecated": false,
        "description": "通过统一的 `POST /v1/videos` 创建 HappyHorse 视频任务。模型能力以当前 Tikway 网关实际可调用范围为准。\n\n| 模型 | 分辨率 | 时长 | 支持模式 | 音频 | 参考限制 |\n| --- | --- | --- | --- | --- | --- |\n| `happyhorse-1.1` | 480p / 720p / 1080p | 3–15 秒 | 文生、首帧图生、1–9 图参考 | 上游生成有声视频；无开关 | 不支持尾帧、视频编辑或延长 |\n| `happyhorse-1.0` | 480p / 720p / 1080p；编辑仅 720p / 1080p | 3–15 秒；编辑跟随输入视频 | 文生、首帧图生、1–9 图参考、视频编辑 | 无 generate_audio；编辑可用 audio_setting | 不支持尾帧或视频延长 |\n\n来源：[阿里云视频生成与编辑模型](https://help.aliyun.com/en/model-studio/video-generate-edit-model/)。官网能力与当前网关未开放能力之间的差异见本次审计报告。",
        "tags": [
          "视频生成/HappyHorse"
        ],

        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "HappyHorseVideoCreateRequest",
                "description": "创建 HappyHorse 视频任务。参数按当前 Tikway 网关能力收窄；模型之间的差异见 operation 描述与 x-model-capabilities。",
                "type": "object",
                "required": [
                  "model"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "enum": [
                      "happyhorse-1.1",
                      "happyhorse-1.0"
                    ],
                    "description": "HappyHorse 模型 ID。"
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "description": "视频生成或编辑提示词。"
                  },
                  "duration": {
                    "type": "integer",
                    "minimum": 3,
                    "maximum": 15,
                    "description": "输出时长为 3–15 秒。视频编辑忽略该字段并沿用输入视频时长。"
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": [
                      "16:9",
                      "9:16",
                      "1:1",
                      "4:3",
                      "3:4",
                      "4:5",
                      "5:4",
                      "21:9",
                      "9:21"
                    ],
                    "description": "视频宽高比。图生视频时，部分模型会按输入素材自动决定比例。"
                  },
                  "resolution": {
                    "type": "string",
                    "enum": [
                      "480p",
                      "720p",
                      "1080p"
                    ],
                    "description": "输出分辨率。不同模型或模式的可用值见模型能力表。"
                  },
                  "frame_images": {
                    "type": "array",
                    "maxItems": 1,
                    "description": "仅支持一张首帧图，不支持尾帧或首尾帧插值。",
                    "items": {
                      "type": "object",
                      "required": [
                        "type",
                        "image_url"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "first_frame"
                          ],
                          "description": "参考帧位置。"
                        },
                        "image_url": {
                          "type": "string",
                          "minLength": 1,
                          "format": "uri",
                          "description": "参考图 URL 字符串。"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "input_references": {
                    "type": "array",
                    "maxItems": 9,
                    "description": "参考生视频仅接受 1–9 张 reference_image。happyhorse-1.0 视频编辑接受 1 个 source_video 和最多 5 张 reference_image。",
                    "items": {
                      "type": "object",
                      "oneOf": [
                        {
                          "required": [
                            "image_url"
                          ]
                        },
                        {
                          "required": [
                            "video_url"
                          ]
                        }
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "image_url",
                            "video_url"
                          ],
                          "description": "可选。素材类型；若提供，必须与对应 URL 字段一致。"
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "reference_image",
                            "source_video"
                          ],
                          "description": "素材用途。省略时按 URL 字段推断为普通参考素材。"
                        },
                        "image_url": {
                          "type": "string",
                          "minLength": 1,
                          "format": "uri",
                          "description": "图片 URL 字符串。"
                        },
                        "video_url": {
                          "type": "string",
                          "minLength": 1,
                          "format": "uri",
                          "description": "视频 URL 字符串。"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": -1,
                    "maximum": 2147483647,
                    "description": "随机种子。固定种子只能提高可复现性，不保证输出完全一致。"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://",
                    "description": "用户任务回调地址。由 Tikway 在任务状态变化后调用，不直接传给模型上游。"
                  },
                  "extra_body": {
                    "type": "object",
                    "description": "HappyHorse 上游扩展参数。",
                    "properties": {
                      "watermark": {
                        "type": "boolean",
                        "description": "是否添加 HappyHorse 水印。"
                      },
                      "audio_setting": {
                        "type": "string",
                        "enum": [
                          "auto",
                          "origin"
                        ],
                        "description": "仅视频编辑：自动处理音频或保留原音频。"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false,
                "x-model-capabilities": [
                  {
                    "model": "happyhorse-1.1",
                    "resolution": "480p / 720p / 1080p",
                    "duration": "3–15 秒",
                    "modes": "文生、首帧图生、1–9 图参考",
                    "audio": "上游生成有声视频；无开关",
                    "references": "不支持尾帧、视频编辑或延长"
                  },
                  {
                    "model": "happyhorse-1.0",
                    "resolution": "480p / 720p / 1080p；编辑仅 720p / 1080p",
                    "duration": "3–15 秒；编辑跟随输入视频",
                    "modes": "文生、首帧图生、1–9 图参考、视频编辑",
                    "audio": "无 generate_audio；编辑可用 audio_setting",
                    "references": "不支持尾帧或视频延长"
                  }
                ]
              },
              "examples": {
                "文生视频": {
                  "summary": "文生视频",
                  "value": {
                    "model": "happyhorse-1.1",
                    "prompt": "一只金毛寻回犬在日落时分的海滩上奔跑，镜头平稳跟随，画面具有自然细腻的电影质感。",
                    "duration": 5,
                    "resolution": "1080p",
                    "aspect_ratio": "16:9"
                  }
                },
                "首帧生视频": {
                  "summary": "首帧生视频",
                  "value": {
                    "model": "happyhorse-1.1",
                    "prompt": "保持首帧中的人物外观与服装一致，让人物自然向前行走，镜头缓慢推进。",
                    "duration": 5,
                    "resolution": "720p",
                    "frame_images": [
                      {
                        "type": "first_frame",
                        "image_url": "https://example.com/assets/first-frame.jpg"
                      }
                    ]
                  }
                },
                "参考生视频": {
                  "summary": "参考生视频",
                  "value": {
                    "model": "happyhorse-1.1",
                    "prompt": "保持参考素材中的人物身份与视觉风格，生成一段连贯的电影感短片。",
                    "duration": 8,
                    "resolution": "720p",
                    "input_references": [
                      {
                        "image_url": "https://example.com/assets/character-front.jpg",
                        "role": "reference_image"
                      },
                      {
                        "image_url": "https://example.com/assets/character-side.jpg",
                        "role": "reference_image"
                      }
                    ]
                  }
                },
                "视频编辑": {
                  "summary": "视频编辑",
                  "value": {
                    "model": "happyhorse-1.0",
                    "prompt": "把人物服装替换成参考图中的外套，保持原视频动作和镜头不变。",
                    "resolution": "720p",
                    "input_references": [
                      {
                        "video_url": "https://example.com/assets/source.mp4",
                        "role": "source_video"
                      },
                      {
                        "image_url": "https://example.com/assets/coat.jpg",
                        "role": "reference_image"
                      }
                    ],
                    "extra_body": {
                      "audio_setting": "origin",
                      "watermark": false
                    }
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$id": "https://api.example.com/schemas/videos/create-response.json",
                  "title": "创建视频任务响应",
                  "description": "POST /v1/videos 创建视频任务成功后的响应参数，接口返回 HTTP 202。",
                  "type": "object",
                  "required": [
                    "id",
                    "status",
                    "polling_url"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "视频生成任务的唯一标识，用于后续查询任务状态。",
                      "examples": [
                        "9552de3d-171f-4cca-b492-7baa56523239"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "queue"
                      ],
                      "description": "任务创建状态。pending 表示任务已创建、等待提交处理；queue 表示任务已进入生成队列。",
                      "examples": [
                        "queue"
                      ]
                    },
                    "polling_url": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://",
                      "description": "视频任务查询地址，客户端可通过 GET 请求轮询任务状态。",
                      "examples": [
                        "https://api.example.com/v1/videos/9552de3d-171f-4cca-b492-7baa56523239"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "id": "9552de3d-171f-4cca-b492-7baa56523239",
                  "status": "pending",
                  "polling_url": "https://api.tikway.ai/v1/videos/9552de3d-171f-4cca-b492-7baa56523239"
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/videos/{id}": {
      "get": {
        "summary": "查询 HappyHorse 视频任务",
        "deprecated": false,
        "description": "",
        "tags": [
          "视频生成/HappyHorse"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "视频生成任务的唯一标识符。",
            "required": true,
            "example": "8f7c2e41-5a93-4b16-9d72-3c84e1a6f205",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-debugger-mode",
            "in": "header",
            "description": "",
            "example": "true",
            "schema": {
              "type": "string",
              "default": "true"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$id": "https://api.example.com/schemas/videos/retrieve-response.json",
                  "title": "查询视频任务响应",
                  "description": "GET /v1/videos/{id} 的响应参数。只有任务状态为 completed 时才返回 data。",
                  "type": "object",
                  "required": [
                    "created",
                    "id",
                    "model",
                    "prompt",
                    "status",
                    "usage"
                  ],
                  "properties": {
                    "created": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "视频任务创建时间，Unix 时间戳，单位为秒。",
                      "examples": [
                        1789108566
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "视频生成任务的唯一标识。",
                      "examples": [
                        "9552de3d-171f-4cca-b492-7baa56523239"
                      ]
                    },
                    "model": {
                      "type": "string",
                      "minLength": 1,
                      "description": "创建视频任务时使用的模型 ID。",
                      "examples": [
                        "bytedance/seedance-2.0-mini"
                      ]
                    },
                    "prompt": {
                      "type": "string",
                      "description": "创建视频任务时提交的提示词。",
                      "examples": [
                        "一只金毛犬在日落时分的海滩上奔跑，镜头平稳跟随，画面呈现自然细腻的电影质感"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "queue",
                        "in_progress",
                        "completed",
                        "failed",
                        "cancelled",
                        "expired"
                      ],
                      "description": "任务状态。pending 表示等待处理；queue 表示排队中；in_progress 表示生成或平台处理进行中；completed 表示视频和 OSS 资源均已处理完成；failed 表示失败；cancelled 表示已取消；expired 表示已过期。",
                      "examples": [
                        "in_progress"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "description": "视频任务结果。仅当 status 为 completed 时返回。",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "video_url"
                            ],
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "video_url"
                                ],
                                "description": "平台 OSS 视频"
                              },
                              "video_url": {
                                "type": "string",
                                "format": "uri",
                                "description": "平台 OSS 视频地址，有效期为24小时"
                              }
                            },
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "native_url"
                            ],
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "native_url"
                                ],
                                "description": "供应商原始视频"
                              },
                              "native_url": {
                                "type": "string",
                                "format": "uri",
                                "description": "供应商返回的原始视频地址"
                              }
                            },
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "first_url",
                              "last_url"
                            ],
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "frame"
                                ],
                                "description": "视频首尾帧"
                              },
                              "first_url": {
                                "type": "string",
                                "format": "uri",
                                "description": "视频首帧地址，有效期为24小时"
                              },
                              "last_url": {
                                "type": "string",
                                "format": "uri",
                                "description": "视频尾帧地址，有效期为24小时"
                              }
                            },
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "usage": {
                      "type": "object",
                      "description": "视频任务的使用量信息。",
                      "required": [
                        "video_seconds"
                      ],
                      "properties": {
                        "video_seconds": {
                          "description": "生成视频的时长，单位为秒。暂时无法确定时可能为 null。",
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "examples": [
                            4
                          ]
                        }
                      },
                      "additionalProperties": false
                    },
                    "error": {
                      "type": "object",
                      "description": "任务失败信息。通常仅在 status 为 failed 时返回。",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "description": "供应商或平台返回的错误码。",
                          "examples": [
                            "video_generation_failed"
                          ]
                        },
                        "message": {
                          "type": "string",
                          "description": "任务失败的具体原因。",
                          "examples": [
                            "Video generation failed."
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "status": {
                            "const": "completed"
                          }
                        },
                        "required": [
                          "status"
                        ]
                      },
                      "then": {
                        "required": [
                          "data"
                        ]
                      },
                      "else": {
                        "not": {
                          "required": [
                            "data"
                          ]
                        }
                      }
                    }
                  ],
                  "additionalProperties": false
                },
                "examples": {
                  "进行中": {
                    "summary": "进行中",
                    "value": {
                      "created": 1789108566,
                      "id": "9552de3d-171f-4cca-b492-7baa56523239",
                      "model": "happyhorse-1.1",
                      "prompt": "一只金毛犬在日落时分的海滩上奔跑，镜头平稳跟随，海风吹动毛发，画面呈现自然细腻的电影质感",
                      "status": "in_progress",
                      "usage": {
                        "video_seconds": 4
                      }
                    }
                  },
                  "已完成": {
                    "summary": "已完成",
                    "value": {
                      "created": 1789108566,
                      "id": "9552de3d-171f-4cca-b492-7baa56523239",
                      "model": "happyhorse-1.1",
                      "prompt": "一只金毛犬在日落时分的海滩上奔跑，镜头平稳跟随，海风吹动毛发，画面呈现自然细腻的电影质感",
                      "status": "completed",
                      "data": [
                        {
                          "type": "video_url",
                          "video_url": "https://oss.example.com/temp/2026/09/11/video.mp4?expires=86400"
                        },
                        {
                          "type": "native_url",
                          "native_url": "https://provider.example.com/videos/video.mp4?expires=86400"
                        },
                        {
                          "type": "frame",
                          "first_url": "https://oss.example.com/temp/2026/09/11/video.mp4?x-oss-process=video%2Fsnapshot%2Ct_0%2Cf_jpg%2Cw_0%2Ch_0",
                          "last_url": "https://oss.example.com/temp/2026/09/11/video.mp4?x-oss-process=video%2Fsnapshot%2Ct_3999%2Cf_jpg%2Cw_0%2Ch_0"
                        }
                      ],
                      "usage": {
                        "video_seconds": 4
                      }
                    }
                  }
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "webhooks": {},
  "components": {
    "schemas": {},
    "responses": {},
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "https://api.tikway.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ]
}
