{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikway Flux 图片生成 API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.tikway.ai"
    }
  ],
  "tags": [
    {
      "name": "图片生成/Flux"
    }
  ],
  "paths": {
    "/v1/images/generations": {
      "post": {
        "summary": "图片生成",
        "description": "Flux 通过 `POST /v1/images/generations` 支持文生图和图生图。参考图统一使用 `images`，最多 4 张；输出尺寸使用 `size`，每次生成一张图片。`seed`、`output_format` 和 `safety_tolerance` 为所选模型支持的可选参数，能力以 Get Models 为准。",
        "operationId": "operation523577674",
        "tags": [
          "图片生成/Flux"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "同步返回统一 Images 结果；response_format 决定返回 url 或 b64_json。",
            "content": {
              "application/json": {
                "schema": {
                  "title": "TikwayImageResponse",
                  "type": "object",
                  "required": [
                    "created",
                    "data"
                  ],
                  "properties": {
                    "created": {
                      "type": "integer",
                      "description": "Unix 时间戳（秒）。"
                    },
                    "model": {
                      "type": "string",
                      "description": "返回时为请求使用的模型 ID。"
                    },
                    "data": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "oneOf": [
                          {
                            "required": [
                              "url"
                            ]
                          },
                          {
                            "required": [
                              "b64_json"
                            ]
                          }
                        ],
                        "properties": {
                          "url": {
                            "type": "string",
                            "format": "uri",
                            "description": "response_format=url 时返回的图片地址。"
                          },
                          "b64_json": {
                            "type": "string",
                            "description": "response_format=b64_json 时返回的纯 Base64 图片内容。"
                          },
                          "index": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "revised_prompt": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "size": {
                      "type": "string"
                    },
                    "output_format": {
                      "type": "string"
                    },
                    "quality": {
                      "type": "string"
                    },
                    "background": {
                      "type": "string"
                    },
                    "usage": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": true,
                  "examples": [
                    {
                      "created": 1791878400,
                      "data": [
                        {
                          "url": "https://example.com/generated.png",
                          "index": 0
                        }
                      ]
                    },
                    {
                      "created": 1791878400,
                      "data": [
                        {
                          "b64_json": "aW1hZ2U=",
                          "index": 0
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "title": "TikwayFluxImageGenerationRequest",
                "type": "object",
                "required": [
                  "model",
                  "prompt"
                ],
                "description": "Tikway 标准图片生成请求，参考图统一使用 images。",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "examples": [
                      "flux-2-flex",
                      "flux-2-max",
                      "flux-pro-1.1",
                      "flux-dev"
                    ],
                    "description": "必填。使用 Get Models 返回的模型 ID 或可用别名。"
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "size": {
                    "type": "string",
                    "pattern": "^(auto|[1-9][0-9]*x[1-9][0-9]*)$",
                    "description": "输出尺寸，使用 WIDTHxHEIGHT；auto 使用模型默认尺寸。支持的尺寸范围以所选模型为准。"
                  },
                  "seed": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ],
                    "description": "随机种子；转换器归一为字符串。"
                  },
                  "output_format": {
                    "type": "string",
                    "enum": [
                      "jpeg",
                      "png"
                    ]
                  },
                  "safety_tolerance": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      }
                    ],
                    "description": "Flux 原生安全容忍度；可用范围随模型变化。"
                  },
                  "response_format": {
                    "type": "string",
                    "enum": [
                      "url",
                      "b64_json"
                    ],
                    "default": "url",
                    "description": "Tikway 图片交付格式，url 返回图片链接，b64_json 返回纯 Base64。默认 url；该字段由网关消费，不作为上游模型参数。"
                  },
                  "images": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "description": "可选。图生图参考图，最多 4 张；省略时为文生图。",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "object",
                          "required": [
                            "image_url"
                          ],
                          "properties": {
                            "image_url": {
                              "type": "string",
                              "minLength": 1,
                              "description": "图片 URL、data URL 或 Base64 字符串。"
                            }
                          },
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "n": {
                    "type": "integer",
                    "const": 1,
                    "default": 1,
                    "description": "每次生成一张图片，只支持 1。"
                  }
                },
                "additionalProperties": false,
                "examples": [
                  {
                    "model": "flux-2-flex",
                    "prompt": "雨夜的未来城市，写实摄影",
                    "size": "1024x1024",
                    "n": 1,
                    "response_format": "url"
                  },
                  {
                    "model": "flux-2-flex",
                    "prompt": "将产品置于白色摄影棚，保留外观",
                    "size": "1024x1024",
                    "n": 1,
                    "response_format": "url",
                    "images": [
                      {
                        "image_url": "https://example.com/assets/product.png"
                      }
                    ]
                  }
                ]
              },
              "examples": {
                "文生图": {
                  "summary": "文生图",
                  "value": {
                    "model": "flux-2-flex",
                    "prompt": "雨夜的未来城市，写实摄影",
                    "size": "1024x1024",
                    "n": 1,
                    "response_format": "url"
                  }
                },
                "图生图": {
                  "summary": "图生图",
                  "value": {
                    "model": "flux-2-flex",
                    "prompt": "将产品置于白色摄影棚，保留外观",
                    "size": "1024x1024",
                    "n": 1,
                    "response_format": "url",
                    "images": [
                      {
                        "image_url": "https://example.com/assets/product.png"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
