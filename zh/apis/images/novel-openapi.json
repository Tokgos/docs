{
  "openapi": "3.1.0",
  "info": {
    "title": "Mintlify",
    "description": "Qwen-Image 3.0 Pro 的 OpenAI 兼容图片生成与参考图编辑接口。",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "图片生成"
    },
    {
      "name": "图片生成/Novel AI"
    }
  ],
  "paths": {
    "/v1/images/generations": {
      "post": {
        "summary": "图片生成",
        "deprecated": false,
        "description": "",
        "tags": [
          "图片生成/Novel AI"
        ],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$id": "urn:tikway:schema:protocols:openai:images-generations:novelai-request:1",
                "title": "NovelAIImageGenerationRequest",
                "description": "NovelAI 图片生成 Request Body。统一参考图使用 images；网关负责转换为 TTAPI NovelAI 原生参数。",
                "type": "object",
                "required": [
                  "model",
                  "prompt"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "examples": [
                      "nai-diffusion-4-5-full",
                      "nai-diffusion-4-5-curated"
                    ]
                  },
                  "images": {
                    "type": "array",
                    "description": "统一参考图。type 缺失或为 null 时表示图生图源图。",
                    "items": {
                      "type": "object",
                      "required": [
                        "image_url"
                      ],
                      "properties": {
                        "type": {
                          "enum": [
                            "image",
                            "vibe_transfer",
                            "character_reference",
                            null
                          ],
                          "description": "image 或 null 为图生图源图；其余值表示 NovelAI 参考图类型。"
                        },
                        "image_url": {
                          "type": "string",
                          "minLength": 1,
                          "format": "uri"
                        },
                        "strength": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1,
                          "description": "参考强度。图生图最大值为 0.99。"
                        },
                        "fidelity": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1,
                          "description": "保真度。图生图会转换为 noise = 1 - fidelity。"
                        },
                        "ref_type": {
                          "type": "string",
                          "enum": [
                            "character",
                            "style",
                            "character&style"
                          ],
                          "default": "character&style",
                          "description": "仅 character_reference 使用。"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32000,
                    "description": "正向提示词。"
                  },
                  "negative_prompt": {
                    "type": "string",
                    "description": "负向提示词。"
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4,
                    "default": 1,
                    "description": "生成图片数量。"
                  },
                  "size": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*x[1-9][0-9]*$",
                    "default": "1024x1024",
                    "description": "输出尺寸，网关转换为 width 和 height。"
                  },
                  "seed": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ],
                    "description": "随机种子。"
                  },
                  "steps": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 23,
                    "description": "采样步数。"
                  },
                  "scale": {
                    "type": "number",
                    "default": 5,
                    "description": "提示词引导强度。"
                  },
                  "quality_toggle": {
                    "type": "boolean",
                    "default": true,
                    "description": "质量开关。"
                  },
                  "sampler": {
                    "type": "string",
                    "enum": [
                      "Euler Ancestral",
                      "Euler",
                      "DPM++ 2S Ancestral",
                      "DPM++ 2M SDE",
                      "DPM++ 2M",
                      "DPM++ SDE"
                    ],
                    "default": "Euler Ancestral"
                  },
                  "noise_schedule": {
                    "type": "string",
                    "enum": [
                      "karras",
                      "exponential",
                      "polyexponential"
                    ],
                    "default": "karras"
                  },
                  "character_prompts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "prompt": {
                          "type": "string"
                        },
                        "uc": {
                          "type": "string"
                        },
                        "center": {
                          "type": "object",
                          "properties": {
                            "x": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "y": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "response_format": {
                    "type": "string",
                    "description": "固定返回 Base64 图片，使响应符合本接口的 Response Schema。",
                    "default": "b64_json",
                    "enum": [
                      "b64_json",
                      "url"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "examples": {
                "文生图": {
                  "value": {
                    "model": "diffusion-4-5-full",
                    "prompt": "A serene Japanese garden at dawn, mist above a koi pond, cinematic lighting, highly detailed",
                    "negative_prompt": "lowres, blurry, text, watermark",
                    "size": "1024x1536",
                    "n": 1,
                    "steps": 28,
                    "scale": 5,
                    "sampler": "k_euler_ancestral",
                    "noise_schedule": "karras"
                  },
                  "summary": "文生图"
                },
                "图生图": {
                  "value": {
                    "model": "diffusion-4-5-full",
                    "prompt": "Turn this scene into an evening watercolor painting, warm lantern light, delicate brush strokes",
                    "negative_prompt": "text, watermark, distorted",
                    "size": "1024x1024",
                    "n": 1,
                    "images": [
                      {
                        "type": "image",
                        "image_url": "https://example.com/source.png",
                        "strength": 0.65,
                        "fidelity": 0.8
                      }
                    ]
                  },
                  "summary": "图生图"
                },
                "风格参考": {
                  "value": {
                    "model": "diffusion-4-5-full",
                    "prompt": "A futuristic city street in the rain, a lone traveler under an umbrella",
                    "negative_prompt": "text, watermark, blurry",
                    "size": "1024x1536",
                    "n": 1,
                    "images": [
                      {
                        "type": "vibe_transfer",
                        "image_url": "https://example.com/style-reference.png",
                        "strength": 0.7
                      }
                    ]
                  },
                  "summary": "风格参考"
                },
                "角色参考": {
                  "value": {
                    "model": "diffusion-4-5-full",
                    "prompt": "The referenced character reads a book in a quiet library, soft afternoon sunlight",
                    "negative_prompt": "text, watermark, extra fingers, distorted face",
                    "size": "1024x1536",
                    "n": 1,
                    "images": [
                      {
                        "type": "character_reference",
                        "image_url": "https://example.com/character.png",
                        "ref_type": "character&style",
                        "strength": 0.8,
                        "fidelity": 0.5
                      }
                    ]
                  },
                  "summary": "角色参考"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "created",
                    "data"
                  ],
                  "properties": {
                    "created": {
                      "type": "integer",
                      "description": "网关完成图片转换时的 Unix 时间戳（秒）。"
                    },
                    "background": {
                      "type": "string",
                      "enum": [
                        "transparent",
                        "opaque"
                      ],
                      "description": "根据统一入站请求推断的背景设置；NovelAI 原始响应通常不回显。"
                    },
                    "data": {
                      "type": "array",
                      "minItems": 1,
                      "description": "生成的图片列表。",
                      "items": {
                        "type": "object",
                        "required": [
                          "b64_json",
                          "index"
                        ],
                        "properties": {
                          "b64_json": {
                            "type": "string",
                            "description": "网关下载并转成 Base64 的图片数据。"
                          },
                          "index": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "图片在结果列表中的索引。"
                          }
                        }
                      }
                    },
                    "output_format": {
                      "type": "string",
                      "enum": [
                        "png",
                        "jpeg",
                        "webp"
                      ],
                      "description": "从下载图片 MIME 类型或请求 output_format 推断出的格式。"
                    },
                    "quality": {
                      "type": "string",
                      "enum": [
                        "low",
                        "medium",
                        "high"
                      ],
                      "description": "统一质量字段；若请求提供 quality，网关会映射后回显。"
                    },
                    "size": {
                      "type": "string",
                      "description": "原始请求的 size；NovelAI 原始响应通常不回显。"
                    }
                  },
                  "examples": [
                    {
                      "created": 1713833628,
                      "background": "opaque",
                      "data": [
                        {
                          "b64_json": "...",
                          "index": 0
                        }
                      ],
                      "output_format": "png",
                      "size": "1024x768"
                    }
                  ]
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "webhooks": {},
  "components": {
    "schemas": {},
    "responses": {},
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "https://api.tikway.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ]
}