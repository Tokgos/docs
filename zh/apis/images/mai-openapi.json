{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikway MAI Image Image API",
    "description": "Tikway 标准图片接口。",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "图片生成"
    },
    {
      "name": "图片生成/MAI Image"
    }
  ],
  "paths": {
    "/v1/images/generations": {
      "post": {
        "summary": "生成图片",
        "deprecated": false,
        "description": "`microsoft/mai-image-2.5-pro` 通过生成接口支持文生图和图生图。参考图使用可选 `images`，最多 1 张；每次生成一张 PNG。`size` 的宽、高均至少 768，总像素不超过 1,048,576。",
        "tags": [
          "图片生成/MAI Image"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "title": "TikwayMaiImageGenerationRequest",
                "description": "MAI Image 文生图与图生图的标准请求。",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "model",
                  "prompt"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "必填。使用 Get Models 返回的模型 ID 或可用别名。",
                    "examples": [
                      "microsoft/mai-image-2.5-pro"
                    ],
                    "minLength": 1
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "description": "必填。图片提示词，原生模型上下文上限 32,000 tokens。",
                    "examples": [
                      "一座漂浮在云海上的未来城市，日出时分，电影级光影，建筑细节丰富"
                    ]
                  },
                  "size": {
                    "type": "string",
                    "default": "1024x1024",
                    "pattern": "^[1-9][0-9]*x[1-9][0-9]*$",
                    "description": "兼容尺寸 WIDTHxHEIGHT。MAI Image 2.5 Pro 的宽、高均至少 768，且总像素不超过 1,048,576。"
                  },
                  "response_format": {
                    "type": "string",
                    "description": "返回形式：url 返回图片地址，b64_json 返回图片 Base64。",
                    "default": "url",
                    "enum": [
                      "b64_json",
                      "url"
                    ]
                  },
                  "images": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "description": "可选。单张图生图参考图，支持 JPEG 或 PNG；省略时为文生图。",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "object",
                          "required": [
                            "image_url"
                          ],
                          "properties": {
                            "image_url": {
                              "type": "string",
                              "minLength": 1,
                              "description": "图片 URL、data URL 或 Base64 字符串。"
                            }
                          },
                          "additionalProperties": false,
                          "x-apifox-orders": [
                            "image_url"
                          ]
                        }
                      ]
                    }
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "background"
                      ],
                      "properties": {
                        "background": {
                          "const": "transparent"
                        }
                      },
                      "x-apifox-orders": [
                        "background"
                      ]
                    },
                    "then": {
                      "required": [
                        "output_format"
                      ],
                      "properties": {
                        "output_format": {
                          "const": "png"
                        }
                      },
                      "x-apifox-orders": [
                        "output_format"
                      ]
                    }
                  }
                ],
                "examples": [
                  {
                    "model": "microsoft/mai-image-2.5-pro",
                    "prompt": "雨夜的未来城市，写实摄影",
                    "size": "1024x1024",
                    "response_format": "url"
                  },
                  {
                    "model": "microsoft/mai-image-2.5-pro",
                    "prompt": "将产品置于白色摄影棚，保留外观",
                    "size": "1024x1024",
                    "response_format": "url",
                    "images": [
                      {
                        "image_url": "https://example.com/assets/product.png"
                      }
                    ]
                  }
                ],
                "x-apifox-orders": [
                  "model",
                  "prompt",
                  "images",
                  "size",
                  "response_format"
                ]
              },
              "examples": {
                "文生图": {
                  "value": {
                    "model": "microsoft/mai-image-2.5-pro",
                    "prompt": "雨夜的未来城市，写实摄影",
                    "size": "1024x1024",
                    "response_format": "url"
                  }
                },
                "图生图": {
                  "value": {
                    "model": "microsoft/mai-image-2.5-pro",
                    "prompt": "将产品置于白色摄影棚，保留外观",
                    "size": "1024x1024",
                    "response_format": "url",
                    "images": [
                      {
                        "image_url": "https://example.com/assets/product.png"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "created": {
                      "type": "integer",
                      "description": "图片创建时间的 Unix 时间戳，单位为秒。",
                      "examples": [
                        1788480000
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "index": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "结果索引。"
                          },
                          "b64_json": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Base64 编码图片；response_format=b64_json 时返回。"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri",
                            "description": "临时图片链接；response_format=url 时返回。"
                          }
                        },
                        "additionalProperties": false,
                        "oneOf": [
                          {
                            "required": [
                              "b64_json"
                            ]
                          },
                          {
                            "required": [
                              "url"
                            ]
                          }
                        ]
                      },
                      "description": "生成结果列表。"
                    },
                    "model": {
                      "type": "string",
                      "description": "实际执行请求的模型标识。"
                    },
                    "output_format": {
                      "type": "string",
                      "description": "实际输出格式。"
                    },
                    "size": {
                      "type": "string",
                      "description": "实际生成尺寸。"
                    },
                    "usage": {
                      "type": "object",
                      "properties": {
                        "input_tokens": {
                          "type": "integer",
                          "description": "输入 token 数。"
                        },
                        "input_tokens_details": {
                          "type": "object",
                          "properties": {
                            "text_tokens": {
                              "type": "integer",
                              "description": "提示词消耗的 token 数。"
                            }
                          },
                          "required": [
                            "text_tokens"
                          ]
                        },
                        "output_tokens": {
                          "type": "integer",
                          "description": "输出 token 数。"
                        },
                        "output_tokens_details": {
                          "type": "object",
                          "properties": {
                            "image_tokens": {
                              "type": "integer",
                              "description": "输出图片消耗的token数。"
                            }
                          },
                          "required": [
                            "image_tokens"
                          ]
                        },
                        "total_tokens": {
                          "type": "integer",
                          "description": "总 token 数。"
                        }
                      },
                      "required": [
                        "input_tokens",
                        "input_tokens_details",
                        "output_tokens",
                        "output_tokens_details",
                        "total_tokens"
                      ],
                      "description": "本次生成的用量信息。"
                    }
                  },
                  "required": [
                    "created",
                    "data",
                    "model",
                    "output_format",
                    "size",
                    "usage"
                  ],
                  "title": "Microsoft MAI Image 2.5 图片生成响应",
                  "description": "统一转换后的 OpenAI Images 响应。"
                },
                "example": {
                  "created": 1788923928,
                  "data": [
                    {
                      "index": 0,
                      "b64_json": "iVBORw0KGgoAAAANSUhEUgAA..."
                    }
                  ],
                  "model": "microsoft/mai-image-2.5-pro",
                  "output_format": "png",
                  "size": "1024x1024",
                  "usage": {
                    "input_tokens": 36,
                    "input_tokens_details": {
                      "text_tokens": 36
                    },
                    "output_tokens": 1024,
                    "output_tokens_details": {
                      "image_tokens": 1024
                    },
                    "total_tokens": 1060
                  }
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "x-model-capabilities": {
          "microsoft/mai-image-2.5-pro": [
            "prompt",
            "size",
            "response_format"
          ]
        }
      }
    }
  },
  "webhooks": {},
  "components": {
    "schemas": {},
    "responses": {},
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "https://api.tikway.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ]
}
