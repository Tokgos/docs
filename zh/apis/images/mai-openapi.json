{
  "openapi": "3.1.0",
  "info": {
    "title": "Mintlify",
    "description": "Qwen-Image 3.0 Pro 的 OpenAI 兼容图片生成与参考图编辑接口。",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "图片生成"
    },
    {
      "name": "图片生成/MAI Image"
    }
  ],
  "paths": {
    "/v1/images/generations": {
      "post": {
        "summary": "生成图片",
        "deprecated": false,
        "description": "`microsoft/mai-image-2.5-pro` 支持文生图。当前网关暴露 `model`、`prompt`、`size` 和兼容 `response_format`；模型只生成 1 张 PNG。尺寸的宽、高均至少 768，总像素不超过 1,048,576。",
        "tags": [
          "图片生成/MAI Image"
        ],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "DoubaoSeedream50ProGenerationRequest",
                "description": "使用 Doubao Seedream 5.0 Pro 根据文字生成图片。",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "model",
                  "prompt"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "必填。MAI Image 2.5 Pro 的 Forward 模型 ID。",
                    "enum": [
                      "microsoft/mai-image-2.5-pro"
                    ]
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "description": "必填。图片提示词，原生模型上下文上限 32,000 tokens。",
                    "examples": [
                      "一座漂浮在云海上的未来城市，日出时分，电影级光影，建筑细节丰富"
                    ]
                  },
                  "size": {
                    "type": "string",
                    "default": "1024x1024",
                    "pattern": "^[1-9]\\d*x[1-9]\\d*$",
                    "description": "OFOX 兼容尺寸 WIDTHxHEIGHT。MAI Image 2.5 Pro 的宽、高均至少 768，且总像素不超过 1,048,576。"
                  },
                  "response_format": {
                    "type": "string",
                    "description": "OFOX 兼容响应格式。MAI 原生输出始终为单张 PNG Base64；建议使用 b64_json。",
                    "default": "b64_json",
                    "enum": [
                      "b64_json",
                      "url"
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "background"
                      ],
                      "properties": {
                        "background": {
                          "const": "transparent"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "output_format"
                      ],
                      "properties": {
                        "output_format": {
                          "const": "png"
                        }
                      }
                    }
                  }
                ],
                "examples": [
                  {
                    "model": "microsoft/mai-image-2.5-pro",
                    "prompt": "A cinematic mountain landscape at sunset.",
                    "size": "1024x1024",
                    "response_format": "b64_json"
                  }
                ]
              },
              "example": {
                "model": "microsoft/mai-image-2.5-pro",
                "prompt": "日落时分的群山景色，夕阳映照山峦与天空，光影柔和，画面自然细腻，具有电影感。",
                "size": "1024x1024"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "created": {
                      "type": "integer",
                      "description": "图片创建时间的 Unix 时间戳，单位为秒。",
                      "examples": [
                        1788480000
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "index": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "结果索引。"
                          },
                          "b64_json": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Base64 编码图片；response_format=b64_json 时返回。"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri",
                            "description": "临时图片链接；response_format=url 时返回。"
                          }
                        },
                        "additionalProperties": false,
                        "oneOf": [
                          {
                            "required": [
                              "b64_json"
                            ]
                          },
                          {
                            "required": [
                              "url"
                            ]
                          }
                        ]
                      },
                      "description": "生成结果列表。"
                    },
                    "model": {
                      "type": "string",
                      "description": "实际执行请求的模型标识。"
                    },
                    "output_format": {
                      "type": "string",
                      "description": "实际输出格式。"
                    },
                    "size": {
                      "type": "string",
                      "description": "实际生成尺寸。"
                    },
                    "usage": {
                      "type": "object",
                      "properties": {
                        "input_tokens": {
                          "type": "integer",
                          "description": "输入 token 数。"
                        },
                        "input_tokens_details": {
                          "type": "object",
                          "properties": {
                            "text_tokens": {
                              "type": "integer",
                              "description": "提示词消耗的 token 数。"
                            }
                          },
                          "required": [
                            "text_tokens"
                          ]
                        },
                        "output_tokens": {
                          "type": "integer",
                          "description": "输出 token 数。"
                        },
                        "output_tokens_details": {
                          "type": "object",
                          "properties": {
                            "image_tokens": {
                              "type": "integer",
                              "description": "输出图片消耗的token数。"
                            }
                          },
                          "required": [
                            "image_tokens"
                          ]
                        },
                        "total_tokens": {
                          "type": "integer",
                          "description": "总 token 数。"
                        }
                      },
                      "required": [
                        "input_tokens",
                        "input_tokens_details",
                        "output_tokens",
                        "output_tokens_details",
                        "total_tokens"
                      ],
                      "description": "本次生成的用量信息。"
                    }
                  },
                  "required": [
                    "created",
                    "data",
                    "model",
                    "output_format",
                    "size",
                    "usage"
                  ],
                  "title": "Microsoft MAI Image 2.5 图片生成响应",
                  "description": "统一转换后的 OpenAI Images 响应。"
                },
                "example": {
                  "created": 1788923928,
                  "data": [
                    {
                      "index": 0,
                      "b64_json": "iVBORw0KGgoAAAANSUhEUgAA..."
                    }
                  ],
                  "model": "microsoft/mai-image-2.5-pro",
                  "output_format": "png",
                  "size": "1024x1024",
                  "usage": {
                    "input_tokens": 36,
                    "input_tokens_details": {
                      "text_tokens": 36
                    },
                    "output_tokens": 1024,
                    "output_tokens_details": {
                      "image_tokens": 1024
                    },
                    "total_tokens": 1060
                  }
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "x-model-capabilities": {
          "microsoft/mai-image-2.5-pro": [
            "prompt",
            "size",
            "response_format"
          ]
        }
      }
    },
    "/v1/images/edits": {
      "post": {
        "summary": "图片编辑",
        "deprecated": false,
        "description": "`microsoft/mai-image-2.5-pro` 支持单张 JPEG/PNG 图片编辑。`model`、`images` 和 `prompt` 必填；输出固定为单张 PNG。",
        "tags": [
          "图片生成/MAI Image"
        ],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "images",
                  "prompt"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "必填。MAI Image 2.5 Pro 的 Forward 模型 ID。",
                    "enum": [
                      "microsoft/mai-image-2.5-pro"
                    ]
                  },
                  "images": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "description": "必填。单张 JPEG 或 PNG 源图。Forward JSON 兼容形式使用一项 file_id/image_url 对象。",
                    "items": {
                      "type": "object",
                      "properties": {
                        "file_id": {
                          "type": "string",
                          "description": "已上传至 Files API 的源图文件 ID。"
                        },
                        "image_url": {
                          "type": "string",
                          "description": "完整图片 URL，或 Base64 data URL。"
                        }
                      }
                    }
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "description": "必填。期望如何编辑或扩展图像的文字描述。"
                  },
                  "size": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "auto",
                      "1024x1024",
                      "1536x1024",
                      "1024x1536",
                      null
                    ],
                    "description": "兼容输出尺寸。MAI 原生编辑接口不提供独立尺寸参数，是否生效取决于 OFOX 上游。"
                  },
                  "response_format": {
                    "type": "string",
                    "description": "OFOX 兼容响应格式。MAI 原生输出固定为单张 PNG Base64；建议使用 b64_json。",
                    "default": "b64_json",
                    "enum": [
                      "b64_json",
                      "url"
                    ]
                  }
                },
                "examples": [
                  {
                    "model": "microsoft/mai-image-2.5-pro",
                    "images": [
                      {
                        "image_url": "https://example.com/source-image.png"
                      }
                    ],
                    "prompt": "Turn this image into a clean futuristic product shot.",
                    "size": "1024x1024",
                    "response_format": "b64_json"
                  }
                ]
              },
              "example": {
                "model": "microsoft/mai-image-2.5-pro",
                "prompt": "Keep the apple unchanged and replace only its background with a misty enchanted forest under soft cinematic lighting.",
                "size": "1024x1024",
                "images": [
                  {
                    "image_url": "https://gd-hbimg.huaban.com/cb36fdfc6ee4707de3ec666d6bc202fb99d9bef326a10d-oQHn3b_fw658"
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "created",
                    "data"
                  ],
                  "properties": {
                    "created": {
                      "type": "integer",
                      "description": "编辑结果创建时的 Unix 时间戳（秒）。"
                    },
                    "background": {
                      "type": "string",
                      "enum": [
                        "transparent",
                        "opaque"
                      ],
                      "description": "实际采用的输出背景。"
                    },
                    "data": {
                      "type": "array",
                      "description": "编辑后的图像列表。",
                      "items": {
                        "type": "object",
                        "properties": {
                          "b64_json": {
                            "type": "string",
                            "description": "Base64 编码的图片内容。GPT Image 模型默认返回。"
                          },
                          "revised_prompt": {
                            "type": "string",
                            "description": "DALL·E 3 的实际修订提示词；本编辑接口通常不返回该字段。"
                          },
                          "url": {
                            "type": "string",
                            "description": "生成图片 URL。DALL·E 使用 URL 返回格式时提供，通常有效 60 分钟。"
                          }
                        }
                      }
                    },
                    "output_format": {
                      "type": "string",
                      "enum": [
                        "png",
                        "webp",
                        "jpeg"
                      ],
                      "description": "实际输出格式。"
                    },
                    "quality": {
                      "type": "string",
                      "enum": [
                        "low",
                        "medium",
                        "high",
                        "auto"
                      ],
                      "description": "实际使用的输出质量。"
                    },
                    "size": {
                      "type": "string",
                      "description": "实际生成的图片尺寸。"
                    },
                    "usage": {
                      "type": "object",
                      "description": "GPT Image 模型的 token 用量。",
                      "properties": {
                        "input_tokens": {
                          "type": "integer",
                          "description": "输入文本和图像的 token 数。"
                        },
                        "input_tokens_details": {
                          "type": "object",
                          "properties": {
                            "image_tokens": {
                              "type": "integer",
                              "description": "输入图像 token 数。"
                            },
                            "text_tokens": {
                              "type": "integer",
                              "description": "输入文本 token 数。"
                            }
                          }
                        },
                        "output_tokens": {
                          "type": "integer",
                          "description": "输出 token 数。"
                        },
                        "output_tokens_details": {
                          "type": "object",
                          "properties": {
                            "image_tokens": {
                              "type": "integer",
                              "description": "输出图像 token 数。"
                            },
                            "text_tokens": {
                              "type": "integer",
                              "description": "输出文本 token 数。"
                            }
                          }
                        },
                        "total_tokens": {
                          "type": "integer",
                          "description": "输入和输出 token 总数。"
                        }
                      }
                    }
                  },
                  "examples": [
                    {
                      "created": 1713833628,
                      "data": [
                        {
                          "b64_json": "..."
                        }
                      ],
                      "usage": {
                        "total_tokens": 100,
                        "input_tokens": 50,
                        "output_tokens": 50,
                        "input_tokens_details": {
                          "text_tokens": 10,
                          "image_tokens": 40
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "created": 1713833628,
                  "data": [
                    {
                      "b64_json": "..."
                    }
                  ],
                  "usage": {
                    "total_tokens": 100,
                    "input_tokens": 50,
                    "output_tokens": 50,
                    "input_tokens_details": {
                      "text_tokens": 10,
                      "image_tokens": 40
                    }
                  }
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "x-model-capabilities": {
          "microsoft/mai-image-2.5-pro": [
            "images",
            "prompt",
            "size",
            "response_format"
          ]
        }
      }
    }
  },
  "webhooks": {},
  "components": {
    "schemas": {},
    "responses": {},
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "https://api.tikway.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ]
}
