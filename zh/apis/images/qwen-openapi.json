{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikway Qwen Image API",
    "description": "Tikway 标准图片接口。",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "图片生成"
    },
    {
      "name": "图片生成/Qwen"
    }
  ],
  "paths": {
    "/v1/images/generations": {
      "post": {
        "summary": "图片生成",
        "deprecated": false,
        "description": "`qwen-image-3.0-pro`（以及 `bailian/` 别名）在同一端点支持文生图和最多 3 张参考图的图生图。\n\n支持：`model`、`prompt`、`size`、`images`、`prompt_extend`、`prompt_extend_mode`、`enable_thinking`、`negative_prompt`、`seed`、`watermark`、`response_format`。\n\n官方兼容接口还支持 `n=1..6`，但当前网关会明确拒绝 Qwen 的 `n`，因此本规范不暴露该字段。`prompt_extend_mode=agent` 仅支持文生图；`enable_thinking` 仅在 `prompt_extend=true` 时生效。",
        "tags": [
          "图片生成/Qwen"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "title": "Qwen-Image 3.0 Pro 请求体",
                "type": "object",
                "required": [
                  "model",
                  "prompt"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "必填。使用 Get Models 返回的模型 ID 或可用别名。",
                    "examples": [
                      "bailian/qwen-image-3.0-pro",
                      "qwen-image-3.0-pro"
                    ],
                    "minLength": 1
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "description": "必填。图片生成指令，支持中文和英文。官方建议不超过约 4,500 tokens。"
                  },
                  "size": {
                    "type": "string",
                    "pattern": "^(auto|[1-9][0-9]*x[1-9][0-9]*)$",
                    "default": "1024x1024",
                    "examples": [
                      "1024x1024",
                      "2048x2048",
                      "1536x1024"
                    ],
                    "description": "可选。输出尺寸，格式为 WIDTHxHEIGHT，例如 1024x1024。省略或传 auto 时，网关向上游发送 1024x1024；官方像素面积范围为 512×512 到 2048×2048，宽高比 1:8～8:1。"
                  },
                  "images": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "description": "可选。图生图参考图，最多 3 张；省略时为文生图。",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "object",
                          "required": [
                            "image_url"
                          ],
                          "properties": {
                            "image_url": {
                              "type": "string",
                              "minLength": 1,
                              "description": "图片 URL、data URL 或 Base64 字符串。"
                            }
                          },
                          "additionalProperties": false,
                          "x-apifox-orders": [
                            "image_url"
                          ]
                        }
                      ]
                    }
                  },
                  "prompt_extend": {
                    "type": "boolean",
                    "default": true,
                    "description": "可选。是否启用智能提示词改写。"
                  },
                  "prompt_extend_mode": {
                    "type": "string",
                    "enum": [
                      "direct",
                      "agent"
                    ],
                    "default": "direct",
                    "description": "可选。提示词改写模式。direct 支持文生图和图生图；agent 仅支持文生图。"
                  },
                  "enable_thinking": {
                    "type": "boolean",
                    "default": true,
                    "description": "可选。是否启用思考模式。设为 true 时不能显式关闭 prompt_extend。"
                  },
                  "negative_prompt": {
                    "type": "string",
                    "description": "可选。描述不希望出现在结果中的内容。"
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647,
                    "description": "可选。随机种子。固定种子可提高结果复现性，但不保证像素级一致。"
                  },
                  "watermark": {
                    "type": "boolean",
                    "default": false,
                    "description": "可选。是否在生成图片右下角添加 Qwen-Image 水印。"
                  },
                  "response_format": {
                    "type": "string",
                    "description": "Tikway 图片交付格式，url 返回图片链接，b64_json 返回纯 Base64。默认 url；该字段由网关消费，不作为上游模型参数。",
                    "default": "url",
                    "enum": [
                      "b64_json",
                      "url"
                    ]
                  }
                },
                "allOf": [
                  {
                    "not": {
                      "required": [
                        "prompt_extend_mode"
                      ],
                      "properties": {
                        "prompt_extend_mode": {
                          "const": "agent"
                        }
                      },
                      "x-apifox-orders": [
                        "prompt_extend_mode"
                      ]
                    }
                  },
                  {
                    "not": {
                      "required": [
                        "enable_thinking",
                        "prompt_extend"
                      ],
                      "properties": {
                        "enable_thinking": {
                          "const": true
                        },
                        "prompt_extend": {
                          "const": false
                        }
                      },
                      "x-apifox-orders": [
                        "enable_thinking",
                        "prompt_extend"
                      ]
                    }
                  }
                ],
                "additionalProperties": false,
                "x-apifox-orders": [
                  "model",
                  "prompt",
                  "size",
                  "images",
                  "prompt_extend",
                  "prompt_extend_mode",
                  "enable_thinking",
                  "negative_prompt",
                  "seed",
                  "watermark",
                  "response_format"
                ]
              },
              "examples": {
                "文生图": {
                  "value": {
                    "model": "bailian/qwen-image-3.0-pro",
                    "prompt": "一张电影感的上海雨夜街景，霓虹灯倒映在湿润路面上，写实摄影",
                    "size": "1024x1024",
                    "prompt_extend": true,
                    "watermark": false
                  }
                },
                "图生图": {
                  "value": {
                    "model": "bailian/qwen-image-3.0-pro",
                    "prompt": "把苹果改成蓝色，其余保持不变",
                    "size": "1024x1024",
                    "images": [
                      {
                        "image_url": "https://example.com/ref-apple.png"
                      }
                    ],
                    "prompt_extend": true,
                    "watermark": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "图片生成成功。网关已下载上游临时图片并转换为不带 data URL 前缀的 Base64。",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Qwen 图片生成响应",
                  "type": "object",
                  "required": [
                    "created",
                    "background",
                    "data"
                  ],
                  "properties": {
                    "created": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0,
                      "description": "网关完成响应转换时的 Unix 时间戳（秒）。"
                    },
                    "background": {
                      "type": "string",
                      "const": "opaque",
                      "description": "当前 Qwen 路径固定返回 opaque。"
                    },
                    "data": {
                      "type": "array",
                      "minItems": 1,
                      "description": "生成结果列表。",
                      "items": {
                        "type": "object",
                        "properties": {
                          "b64_json": {
                            "type": "string",
                            "minLength": 1,
                            "contentEncoding": "base64",
                            "description": "网关下载并转换后的 Base64 图片。"
                          },
                          "index": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "结果索引。"
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "b64_json",
                          "index"
                        ]
                      }
                    },
                    "output_format": {
                      "type": "string",
                      "enum": [
                        "png",
                        "jpeg",
                        "webp"
                      ],
                      "description": "网关根据下载图片的 Content-Type 推断出的格式。上游未提供可识别类型时省略。"
                    },
                    "size": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*x[1-9][0-9]*$",
                      "description": "实际或请求的输出尺寸。请求与上游响应均未提供尺寸时省略。"
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "created": 1788451200,
                  "background": "opaque",
                  "data": [
                    {
                      "b64_json": "iVBORw0KGgoAAAANSUhEUgAA...",
                      "index": 0
                    }
                  ],
                  "output_format": "png",
                  "size": "1024x1024"
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "x-model-capabilities": {
          "bailian/qwen-image-3.0-pro": [
            "prompt",
            "size",
            "images",
            "prompt_extend",
            "prompt_extend_mode",
            "enable_thinking",
            "negative_prompt",
            "seed",
            "watermark",
            "response_format"
          ],
          "qwen-image-3.0-pro": [
            "prompt",
            "size",
            "images",
            "prompt_extend",
            "prompt_extend_mode",
            "enable_thinking",
            "negative_prompt",
            "seed",
            "watermark",
            "response_format"
          ]
        }
      }
    }
  },
  "webhooks": {},
  "components": {
    "schemas": {},
    "responses": {},
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "https://api.tikway.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ]
}
