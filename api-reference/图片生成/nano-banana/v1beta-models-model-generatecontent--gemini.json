{
  "openapi": "3.1.0",
  "info": {
    "title": "Mintlify",
    "description": "",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "",
      "description": "开发环境"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "图片生成"
    },
    {
      "name": "图片生成/Nano Banana"
    }
  ],
  "paths": {
    "/v1beta/models/{model}:generateContent": {
      "post": {
        "summary": "Gemini - 图片生成",
        "deprecated": false,
        "description": "",
        "tags": [
          "图片生成/Nano Banana",
          "图片生成"
        ],
        "parameters": [
          {
            "name": "model",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "contents"
                ],
                "properties": {
                  "contents": {
                    "type": "array",
                    "minItems": 1,
                    "description": "必填。纯文本为文生图；文本加 inlineData 为图像编辑。",
                    "items": {
                      "type": "object",
                      "required": [
                        "parts"
                      ],
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "user",
                            "model"
                          ],
                          "description": "通常为 user 或省略。"
                        },
                        "parts": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "properties": {
                              "text": {
                                "type": "string",
                                "description": "生成或编辑图片的提示词。"
                              },
                              "inlineData": {
                                "type": "object",
                                "description": "编辑时使用的 Base64 参考图。",
                                "required": [
                                  "mimeType",
                                  "data"
                                ],
                                "properties": {
                                  "mimeType": {
                                    "type": "string",
                                    "description": "图片 MIME 类型，例如 image/png。"
                                  },
                                  "data": {
                                    "type": "string",
                                    "description": "不带 data URL 前缀的 Base64 图片内容。"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "generationConfig": {
                    "type": "object",
                    "description": "Nano Banana 图像输出配置。",
                    "properties": {
                      "responseModalities": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "TEXT",
                            "IMAGE"
                          ]
                        },
                        "description": "仅返回图片时设为 [\"IMAGE\"]。"
                      },
                      "responseFormat": {
                        "type": "object",
                        "properties": {
                          "image": {
                            "type": "object",
                            "properties": {
                              "aspectRatio": {
                                "type": "string",
                                "enum": [
                                  "1:1",
                                  "1:4",
                                  "1:8",
                                  "2:3",
                                  "3:2",
                                  "3:4",
                                  "4:1",
                                  "4:3",
                                  "4:5",
                                  "5:4",
                                  "8:1",
                                  "9:16",
                                  "16:9",
                                  "21:9"
                                ],
                                "description": "目标宽高比；可用范围依模型不同。"
                              },
                              "imageSize": {
                                "type": "string",
                                "enum": [
                                  "0.5K",
                                  "1K",
                                  "2K",
                                  "4K"
                                ],
                                "description": "目标分辨率；可用范围依模型不同。"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "examples": [
                  {
                    "contents": [
                      {
                        "parts": [
                          {
                            "text": "把这只猫放到星空下的餐厅，保持原有外观。"
                          },
                          {
                            "inlineData": {
                              "mimeType": "image/png",
                              "data": "<base64-image-data>"
                            }
                          }
                        ]
                      }
                    ],
                    "generationConfig": {
                      "responseModalities": [
                        "IMAGE"
                      ],
                      "responseFormat": {
                        "image": {
                          "aspectRatio": "16:9",
                          "imageSize": "2K"
                        }
                      }
                    }
                  }
                ]
              },
              "example": {
                "model": "gemini-3-pro-image-preview",
                "prompt": "换成蓝色的苹果",
                "size": "1024x1024",
                "quality": "medium",
                "n": 1,
                "images": [
                  {
                    "image_url": "https://tse4.mm.bing.net/th/id/OIP.BUyCY__2XCH8Z1pYX5IPvQHaE7?r=0&rs=1&pid=ImgDetMain&o=7&rm=3"
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "created",
                    "data"
                  ],
                  "properties": {
                    "created": {
                      "type": "integer",
                      "description": "编辑结果创建时的 Unix 时间戳（秒）。"
                    },
                    "background": {
                      "type": "string",
                      "enum": [
                        "transparent",
                        "opaque"
                      ],
                      "description": "实际采用的输出背景。"
                    },
                    "data": {
                      "type": "array",
                      "description": "编辑后的图像列表。",
                      "items": {
                        "type": "object",
                        "properties": {
                          "b64_json": {
                            "type": "string",
                            "description": "Base64 编码的图片内容。GPT Image 模型默认返回。"
                          },
                          "revised_prompt": {
                            "type": "string",
                            "description": "DALL·E 3 的实际修订提示词；本编辑接口通常不返回该字段。"
                          },
                          "url": {
                            "type": "string",
                            "description": "生成图片 URL。DALL·E 使用 URL 返回格式时提供，通常有效 60 分钟。"
                          }
                        }
                      }
                    },
                    "output_format": {
                      "type": "string",
                      "enum": [
                        "png",
                        "webp",
                        "jpeg"
                      ],
                      "description": "实际输出格式。"
                    },
                    "quality": {
                      "type": "string",
                      "enum": [
                        "low",
                        "medium",
                        "high",
                        "auto"
                      ],
                      "description": "实际使用的输出质量。"
                    },
                    "size": {
                      "type": "string",
                      "description": "实际生成的图片尺寸。"
                    },
                    "usage": {
                      "type": "object",
                      "description": "GPT Image 模型的 token 用量。",
                      "properties": {
                        "input_tokens": {
                          "type": "integer",
                          "description": "输入文本和图像的 token 数。"
                        },
                        "input_tokens_details": {
                          "type": "object",
                          "properties": {
                            "image_tokens": {
                              "type": "integer",
                              "description": "输入图像 token 数。"
                            },
                            "text_tokens": {
                              "type": "integer",
                              "description": "输入文本 token 数。"
                            }
                          }
                        },
                        "output_tokens": {
                          "type": "integer",
                          "description": "输出 token 数。"
                        },
                        "output_tokens_details": {
                          "type": "object",
                          "properties": {
                            "image_tokens": {
                              "type": "integer",
                              "description": "输出图像 token 数。"
                            },
                            "text_tokens": {
                              "type": "integer",
                              "description": "输出文本 token 数。"
                            }
                          }
                        },
                        "total_tokens": {
                          "type": "integer",
                          "description": "输入和输出 token 总数。"
                        }
                      }
                    }
                  },
                  "examples": [
                    {
                      "created": 1713833628,
                      "data": [
                        {
                          "b64_json": "..."
                        }
                      ],
                      "usage": {
                        "total_tokens": 100,
                        "input_tokens": 50,
                        "output_tokens": 50,
                        "input_tokens_details": {
                          "text_tokens": 10,
                          "image_tokens": 40
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "created": 1713833628,
                  "data": [
                    {
                      "b64_json": "..."
                    }
                  ],
                  "usage": {
                    "total_tokens": 100,
                    "input_tokens": 50,
                    "output_tokens": 50,
                    "input_tokens_details": {
                      "text_tokens": 10,
                      "image_tokens": 40
                    }
                  }
                }
              }
            },
            "headers": {}
          }
        },
        "security": [],
        "x-group": "Nano Banana"
      }
    }
  },
  "components": {
    "schemas": {},
    "responses": {},
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
