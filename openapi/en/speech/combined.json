{
  "openapi": "3.1.0",
  "info": {
    "title": "Speech API",
    "description": "Use OpenAI request fields with OpenAI, Google, Qwen-Audio and Qwen-TTS. Provider extensions are accepted inside extra_body or directly at the body root. The DashScope Client selects the native speech operation and converts requests and responses internally. Models only need /v1/audio/speech; native multimodal and SpeechSynthesizer endpoint associations are unnecessary. DashScope Qwen3-TTS/Qwen-TTS always uses the official dashscope.aliyuncs.com service; keep the account's existing MaaS Base URL.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.tikway.ai"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/audio/speech": {
      "post": {
        "operationId": "createSpeech",
        "summary": "Create speech",
        "description": "Use OpenAI request fields with OpenAI, Google, Qwen-Audio and Qwen-TTS. Provider extensions are accepted inside extra_body or directly at the body root. The DashScope Client selects the native speech operation and converts requests and responses internally. Models only need /v1/audio/speech; native multimodal and SpeechSynthesizer endpoint associations are unnecessary. DashScope Qwen3-TTS/Qwen-TTS always uses the official dashscope.aliyuncs.com service; keep the account's existing MaaS Base URL.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Qualified model ID or unique alias. Example models must be configured in the catalog."
                  },
                  "input": {
                    "type": "string",
                    "maxLength": 4096,
                    "description": "Text to synthesize. OpenAI limit: 4096 characters; native Qwen-TTS limit: 600 characters."
                  },
                  "voice": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "id"
                        ],
                        "additionalProperties": true
                      }
                    ],
                    "description": "Voice name or {\"id\":\"voice_1234\"}. OpenAI voices include alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer, verse, marin and cedar. Google accepts prebuilt names, voice_ IDs or voicekey_ keys; Qwen uses model-specific voices."
                  },
                  "instructions": {
                    "type": "string",
                    "maxLength": 4096,
                    "description": "Style instructions. Gemini 3.8 uses speech_metadata.style without altering the transcript; 2.5/3.1 use the legacy text prompt. Qwen-Audio/CosyVoice map to instruction. Unsupported by Qwen-TTS."
                  },
                  "response_format": {
                    "type": "string",
                    "enum": [
                      "mp3",
                      "opus",
                      "aac",
                      "flac",
                      "wav",
                      "pcm"
                    ],
                    "description": "OpenAI defaults to mp3 and supports all listed formats. Qwen-Audio defaults to mp3 and supports mp3/pcm/wav/opus. Google defaults to wav and supports wav/pcm. Qwen-TTS returns wav. Unsupported formats are rejected; no implicit transcoding is performed. Gemini 3.8 WAV is preserved; pcm extracts the PCM payload. Legacy PCM is wrapped once only when wav is requested."
                  },
                  "speed": {
                    "type": "number",
                    "minimum": 0.25,
                    "maximum": 4,
                    "default": 1,
                    "description": "OpenAI range 0.25–4, default 1. Qwen-Audio maps to rate (0.5–2). Google uses a natural-language instruction, with model-dependent results. Qwen-TTS accepts only 1."
                  },
                  "stream_format": {
                    "type": "string",
                    "enum": [
                      "audio",
                      "sse"
                    ],
                    "default": "audio",
                    "description": "audio returns audio bytes. sse returns speech.audio.delta (Base64 audio) and speech.audio.done (usage). OpenAI tts-1/tts-1-hd do not support SSE. Google synthesis and WAV packaging buffer complete audio first."
                  },
                  "extra_body": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "sample_rate": {
                        "type": "integer",
                        "enum": [
                          8000,
                          12000,
                          16000,
                          22050,
                          24000,
                          44100,
                          48000
                        ],
                        "description": "Qwen-Audio sample rate; opus excludes 22050 and 44100."
                      },
                      "volume": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "rate": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 2,
                        "description": "Native Qwen-Audio rate; speed takes precedence when both are supplied."
                      },
                      "bit_rate": {
                        "type": "integer",
                        "minimum": 6,
                        "maximum": 510
                      },
                      "pitch": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 2
                      },
                      "enable_ssml": {
                        "type": "boolean"
                      },
                      "word_timestamp_enabled": {
                        "type": "boolean",
                        "description": "Native Qwen-Audio option; unified speech responses expose audio and usage, without native timestamp events."
                      },
                      "seed": {
                        "type": "integer",
                        "description": "Qwen-Audio range 0–65535; Google uses model-specific limits."
                      },
                      "language_hints": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "instruction": {
                        "type": "string",
                        "description": "Native Qwen-Audio instruction; instructions takes precedence."
                      },
                      "enable_aigc_tag": {
                        "type": "boolean"
                      },
                      "aigc_propagator": {
                        "type": "string"
                      },
                      "aigc_propagate_id": {
                        "type": "string"
                      },
                      "hot_fix": {
                        "type": "object",
                        "properties": {
                          "pronunciation": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": {
                                "type": "string"
                              }
                            }
                          },
                          "replace": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "required": [],
                        "additionalProperties": true
                      },
                      "language_type": {
                        "type": "string",
                        "enum": [
                          "Auto",
                          "Chinese",
                          "English",
                          "German",
                          "Italian",
                          "Portuguese",
                          "Spanish",
                          "Japanese",
                          "Korean",
                          "French",
                          "Russian"
                        ],
                        "description": "Qwen-TTS language."
                      },
                      "speech_config": {
                        "type": "object",
                        "properties": {
                          "languageCode": {
                            "type": "string"
                          },
                          "voiceConfig": {
                            "type": "object",
                            "properties": {
                              "voice": {
                                "type": "string"
                              },
                              "prebuiltVoiceConfig": {
                                "type": "object",
                                "properties": {
                                  "voiceName": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "voiceName"
                                ]
                              }
                            },
                            "additionalProperties": true
                          },
                          "multiSpeakerVoiceConfig": {
                            "type": "object",
                            "properties": {
                              "speakerVoiceConfigs": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 2,
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "speaker": {
                                      "type": "string"
                                    },
                                    "voiceConfig": {
                                      "type": "object",
                                      "properties": {
                                        "voice": {
                                          "type": "string"
                                        },
                                        "prebuiltVoiceConfig": {
                                          "type": "object",
                                          "properties": {
                                            "voiceName": {
                                              "type": "string"
                                            }
                                          },
                                          "required": [
                                            "voiceName"
                                          ]
                                        }
                                      },
                                      "additionalProperties": true
                                    }
                                  },
                                  "required": [
                                    "speaker",
                                    "voiceConfig"
                                  ]
                                }
                              }
                            },
                            "required": [
                              "speakerVoiceConfigs"
                            ]
                          }
                        },
                        "additionalProperties": true
                      },
                      "generation_config": {
                        "type": "object",
                        "additionalProperties": true
                      },
                      "language_code": {
                        "type": "string",
                        "description": "Google BCP-47 language code."
                      },
                      "multi_speaker_voice_config": {
                        "type": "object",
                        "properties": {
                          "speakerVoiceConfigs": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 2,
                            "items": {
                              "type": "object",
                              "properties": {
                                "speaker": {
                                  "type": "string"
                                },
                                "voiceConfig": {
                                  "type": "object",
                                  "properties": {
                                    "voice": {
                                      "type": "string"
                                    },
                                    "prebuiltVoiceConfig": {
                                      "type": "object",
                                      "properties": {
                                        "voiceName": {
                                          "type": "string"
                                        }
                                      },
                                      "required": [
                                        "voiceName"
                                      ]
                                    }
                                  },
                                  "additionalProperties": true
                                }
                              },
                              "required": [
                                "speaker",
                                "voiceConfig"
                              ]
                            }
                          }
                        },
                        "required": [
                          "speakerVoiceConfigs"
                        ]
                      },
                      "temperature": {
                        "type": "number"
                      },
                      "stream": {
                        "type": "boolean",
                        "description": "Extension: request native Qwen streaming; stream_format selects audio or SSE delivery."
                      },
                      "speech_metadata": {
                        "type": "object",
                        "properties": {
                          "speaker": {
                            "type": "string"
                          },
                          "style": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true,
                        "description": "Per-turn style and speaker metadata for Gemini 3.8."
                      },
                      "contents": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "properties": {
                            "role": {
                              "type": "string",
                              "enum": [
                                "user"
                              ]
                            },
                            "parts": {
                              "type": "array",
                              "minItems": 1,
                              "items": {
                                "type": "object",
                                "properties": {
                                  "text": {
                                    "type": "string"
                                  },
                                  "speech_metadata": {
                                    "type": "object",
                                    "properties": {
                                      "speaker": {
                                        "type": "string"
                                      },
                                      "style": {
                                        "type": "string"
                                      }
                                    },
                                    "additionalProperties": true
                                  }
                                },
                                "required": [
                                  "text"
                                ]
                              }
                            }
                          },
                          "required": [
                            "parts"
                          ]
                        },
                        "description": "Native Google text turns for multiple speakers; overrides generated contents. Text only."
                      }
                    },
                    "description": "Google/Qwen extensions. Also accepted at the body root; root fields win and only one level is flattened."
                  },
                  "sample_rate": {
                    "type": "integer",
                    "enum": [
                      8000,
                      12000,
                      16000,
                      22050,
                      24000,
                      44100,
                      48000
                    ],
                    "description": "Qwen-Audio sample rate; opus excludes 22050 and 44100."
                  },
                  "volume": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "rate": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 2,
                    "description": "Native Qwen-Audio rate; speed takes precedence when both are supplied."
                  },
                  "bit_rate": {
                    "type": "integer",
                    "minimum": 6,
                    "maximum": 510
                  },
                  "pitch": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 2
                  },
                  "enable_ssml": {
                    "type": "boolean"
                  },
                  "word_timestamp_enabled": {
                    "type": "boolean",
                    "description": "Native Qwen-Audio option; unified speech responses expose audio and usage, without native timestamp events."
                  },
                  "seed": {
                    "type": "integer",
                    "description": "Qwen-Audio range 0–65535; Google uses model-specific limits."
                  },
                  "language_hints": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "instruction": {
                    "type": "string",
                    "description": "Native Qwen-Audio instruction; instructions takes precedence."
                  },
                  "enable_aigc_tag": {
                    "type": "boolean"
                  },
                  "aigc_propagator": {
                    "type": "string"
                  },
                  "aigc_propagate_id": {
                    "type": "string"
                  },
                  "hot_fix": {
                    "type": "object",
                    "properties": {
                      "pronunciation": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      },
                      "replace": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "required": [],
                    "additionalProperties": true
                  },
                  "language_type": {
                    "type": "string",
                    "enum": [
                      "Auto",
