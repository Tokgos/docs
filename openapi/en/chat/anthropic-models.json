{
  "openapi": "3.1.0",
  "info": {
    "title": "Anthropic model list",
    "description": "List all callable platform models in the Anthropic format, including aliases, architecture, and capabilities.",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "Chat completions"
    },
    {
      "name": "Chat completions/Anthropic protocol"
    }
  ],
  "paths": {
    "/anthropic/v1/models": {
      "get": {
        "summary": "Get Models",
        "deprecated": false,
        "description": "Return the same full callable model catalog as GET /v1/models across providers and text, image, video, audio, embedding, and decision models. No implicit protocol filtering is applied. The native response envelope and pagination remain available; provider, mode, and type filters are explicit.\n\nEach model includes aliases, architecture, capabilities.endpoints, capabilities.parameters, and capabilities.reasoning_efforts, matching the OpenAI list. Merge common with the endpoint parameter array for its complete parameter set. Catalog inclusion does not imply support for generation through this protocol; use capabilities.endpoints.\n\nGET /v1/models with anthropic-version also returns this presentation.",
        "operationId": "getModels",
        "tags": [
          "Chat completions/Anthropic protocol"
        ],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Filter by model type, or omit to include all types. Supports text/image/video/music/embedding, ignoring case and surrounding whitespace. Separate multiple types with commas or repeat type to combine them with OR. Unknown or empty values return 400.",
            "required": false,
            "example": "image,video",
            "schema": {
              "type": "string",
              "minLength": 1,
              "examples": [
                "text",
                "image",
                "video",
                "music",
                "embedding",
                "image,video"
              ]
            }
          },
          {
            "name": "x-provider-route",
            "in": "header",
            "description": "Upstream routing preference: cost, stable, or fast.",
            "example": "cost",
            "schema": {
              "type": "string",
              "default": "cost"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The currently callable model catalog. Example capability values illustrate the response structure; use the values returned by the API.",
            "content": {
              "application/json": {
                "schema": {
                  "title": "AnthropicModelsResponse",
                  "description": "HTTP 200 response for GET /anthropic/v1/models. GET /v1/models with anthropic-version uses the same structure. Includes the same model catalog as the OpenAI list, with Anthropic cursor pagination.",
                  "type": "object",
                  "required": [
                    "data",
                    "first_id",
                    "has_more",
                    "last_id"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "type",
                          "id",
                          "allowed_fallback_models",
                          "capabilities",
                          "created_at",
                          "display_name",
                          "description",
                          "context_length",
                          "supported_parameters",
                          "max_input_tokens",
                          "max_tokens",
                          "aliases",
                          "architecture"
                        ],
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "model"
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Full platform model ID, including the provider namespace."
                          },
                          "display_name": {
                            "type": "string",
                            "description": "Model display name."
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Model release time. Returns 1970-01-01T00:00:00Z when not configured."
                          },
                          "description": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "context_length": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0,
                            "description": "Context token limit, or null when not configured."
                          },
                          "max_input_tokens": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0,
                            "description": "Maximum input tokens. Currently matches context_length."
                          },
                          "max_tokens": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0,
                            "description": "Maximum output tokens. Returns null when not configured and cannot be derived from parameter configuration."
                          },
                          "supported_parameters": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Native Anthropic parameter names. Returns an empty array when no Anthropic parameter configuration is available. See capabilities.parameters for the callable endpoint parameters."
                          },
                          "allowed_fallback_models": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Allowed fallback model IDs. Currently returns an empty array."
                          },
                          "aliases": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Available model aliases from platform configuration. Returns an empty array when none are configured."
                          },
                          "architecture": {
                            "type": "object",
                            "required": [
                              "input_modalities",
                              "output_modalities"
                            ],
                            "properties": {
                              "input_modalities": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "output_modalities": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            },
                            "description": "Input and output modalities derived from platform configuration and the endpoints available for this model.",
                            "additionalProperties": false
                          },
                          "capabilities": {
                            "type": "object",
                            "required": [
                              "reasoning_efforts",
                              "endpoints",
                              "parameters",
                              "batch",
                              "citations",
                              "code_execution",
                              "compaction",
                              "context_management",
                              "effort",
                              "image_input",
                              "pdf_input",
                              "structured_outputs",
                              "thinking"
                            ],
                            "properties": {
                              "reasoning_efforts": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "Reasoning effort levels collected from the endpoint parameter configuration. Returns an empty array when no configurable levels are available."
                              },
                              "endpoints": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "minItems": 1,
                                "description": "Currently callable API paths for this model, from platform routing configuration."
                              },
                              "parameters": {
                                "type": "object",
                                "required": [
                                  "common"
                                ],
                                "properties": {
                                  "common": {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    }
                                  }
                                },
                                "additionalProperties": {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  }
                                },
                                "description": "common lists parameters shared by all callable endpoints. Each endpoint path lists only its additional parameters. Combine common with the endpoint array for its complete parameter set. For a model with one endpoint, all parameters may be in common.",
                                "examples": [
                                  {
                                    "/v1/videos": [],
                                    "common": [
                                      "seed",
                                      "model",
                                      "prompt",
                                      "duration",
                                      "extra_body",
                                      "resolution",
                                      "aspect_ratio",
                                      "callback_url",
                                      "frame_images",
                                      "input_references"
                                    ]
                                  }
                                ]
                              },
