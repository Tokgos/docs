{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikway Jev decision evaluation API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.tikway.ai"
    }
  ],
  "tags": [
    {
      "name": "Decisions/Jev"
    }
  ],
  "paths": {
    "/v1/decisions": {
      "post": {
        "summary": "Jev decision evaluation",
        "operationId": "createDecision",
        "tags": [
          "Decisions/Jev"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionsResponse"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Response"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Model ID or configured alias."
                  },
                  "state": {
                    "type": [
                      "string",
                      "object",
                      "array"
                    ],
                    "description": "Material shared by all questions."
                  },
                  "questions": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "const": "noul",
                              "type": "string"
                            },
                            "instructions": {
                              "type": [
                                "string",
                                "object",
                                "array"
                              ]
                            },
                            "criteria": {
                              "type": "object",
                              "properties": {
                                "true": {
                                  "type": [
                                    "string",
                                    "object",
                                    "array"
                                  ]
                                },
                                "false": {
                                  "type": [
                                    "string",
                                    "object",
                                    "array"
                                  ]
                                }
                              },
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "type",
                            "instructions"
                          ],
                          "additionalProperties": true
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "const": "choice",
                              "type": "string"
                            },
                            "instructions": {
                              "type": [
                                "string",
                                "object",
                                "array"
                              ]
                            },
                            "criteria": {
                              "type": "object",
                              "minProperties": 2,
                              "maxProperties": 255,
                              "additionalProperties": {
                                "type": [
                                  "string",
                                  "object",
                                  "array",
                                  "null"
                                ]
                              }
                            }
                          },
                          "required": [
                            "type",
                            "instructions",
                            "criteria"
                          ],
                          "additionalProperties": true
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "const": "score",
                              "type": "string"
                            },
                            "instructions": {
                              "type": [
                                "string",
                                "object",
                                "array"
                              ]
                            },
                            "criteria": {
                              "type": "array",
                              "items": {
                                "type": [
                                  "string",
                                  "object",
                                  "array"
                                ]
                              },
                              "minItems": 2,
                              "maxItems": 10
                            }
                          },
                          "required": [
                            "type",
                            "instructions",
                            "criteria"
                          ],
                          "additionalProperties": true
                        }
                      ]
                    },
                    "properties": {},
                    "description": "Questions to evaluate."
                  }
                },
                "required": [
                  "model",
                  "state",
                  "questions"
                ],
                "additionalProperties": true
              }
            }
          }
        },
        "description": "Jev decision evaluation through the Tikway gateway.",
        "x-mint": {
          "href": "/en/api-reference/decisions/jev/create",
          "metadata": {
            "sidebarTitle": "Jev decision evaluation"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "DecisionsResponse": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "answers": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "predicate"
                    },
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "probability": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "type",
                    "name",
                    "probability"
                  ],
                  "additionalProperties": true
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "choice"
                    },
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "choice": {
                      "type": [
                        "string",
                        "boolean"
                      ]
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "probabilities": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": [
                              "string",
                              "boolean"
                            ]
                          },
                          "probability": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        },
                        "required": [
                          "value",
                          "probability"
                        ],
                        "additionalProperties": true
                      }
                    }
                  },
                  "required": [
                    "type",
                    "name",
                    "choice",
                    "confidence",
                    "probabilities"
                  ],
                  "additionalProperties": true
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "score"
                    },
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "score": {
                      "type": "number"
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "probabilities": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "integer"
                          },
                          "label": {
                            "type": "string"
                          },
                          "probability": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        },
                        "required": [
                          "value",
                          "label",
                          "probability"
                        ],
                        "additionalProperties": true
                      }
                    },
                    "legend": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "properties": {}
                    }
                  },
                  "required": [
                    "type",
                    "name",
                    "score",
                    "confidence",
                    "probabilities"
                  ],
                  "additionalProperties": true
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "refusal"
                    },
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "name"
                  ],
                  "additionalProperties": true
                }
              ]
            }
          },
          "usage": {
            "type": "object",
            "properties": {
              "prompt_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "completion_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "total_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "prompt_tokens_details": {
                "type": "object",
                "properties": {}
              },
              "completion_tokens_details": {
                "type": "object",
                "properties": {}
              }
            },
            "required": [
              "prompt_tokens",
              "total_tokens"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "model",
          "answers",
          "usage"
        ],
        "additionalProperties": true,
        "title": "DecisionsResponse"
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "code": {
                "type": [
                  "string",
                  "integer",
                  "null"
                ]
              },
              "param": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": true
      }
    }
  }
}
