{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikway Seedream Image API",
    "description": "Tikway standard image API.",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "Image generation"
    },
    {
      "name": "Image generation/Seedream"
    }
  ],
  "paths": {
    "/v1/images/generations": {
      "post": {
        "summary": "Image generation",
        "deprecated": false,
        "description": "Seedream uses POST /v1/images/generations for text-to-image and image-to-image. Use optional images for reference inputs and size for output dimensions. Formats, backgrounds, watermarks, prompt options, and reference limits depend on the selected model.",
        "tags": [
          "Image generation/Seedream"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "title": "TikwayImageRequest",
                "description": "Use Doubao Seedream 5.0 Pro to generate images from text.",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "model",
                  "prompt"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Required. Use a model ID or available alias returned by Get Models.",
                    "examples": [
                      "volcengine/doubao-seedream-5.0-pro",
                      "volcengine/doubao-seedream-4.5"
                    ],
                    "minLength": 1
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Required. Describe the image to generate.",
                    "examples": [
                      "一座漂浮在云海上的未来城市，日出时分，电影级光影，建筑细节丰富"
                    ]
                  },
                  "size": {
                    "description": "Output size as WIDTHxHEIGHT, or auto for the model default. Supported sizes depend on the selected model.",
                    "oneOf": [
                      {
                        "type": "string",
                        "enum": [
                          "auto",
                          "1K",
                          "1.5K",
                          "2K"
                        ]
                      },
                      {
                        "type": "string",
                        "pattern": "^[1-9][0-9]*x[1-9][0-9]*$",
                        "examples": [
                          "1024x1024",
                          "2048x2048",
                          "2816x1584"
                        ]
                      }
                    ]
                  },
                  "output_format": {
                    "type": "string",
                    "enum": [
                      "png",
                      "jpeg"
                    ],
                    "default": "jpeg",
                    "description": "Output picture format. Transparent backgrounds must use png."
                  },
                  "background": {
                    "type": "string",
                    "enum": [
                      "opaque",
                      "transparent"
                    ],
                    "default": "opaque",
                    "description": "Output background. transparent can only be used with output_format=png."
                  },
                  "response_format": {
                    "type": "string",
                    "description": "Response format: url returns image URLs; b64_json returns Base64 image data.",
                    "default": "url",
                    "enum": [
                      "b64_json",
                      "url"
                    ]
                  },
                  "watermark": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether to add a watermark to the generated image."
                  },
                  "optimize_prompt_options": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "mode"
                    ],
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": [
                          "standard",
                          "fast"
                        ],
                        "description": "Prompt word optimization mode. Standard gives priority to effect, and fast gives priority to speed."
                      }
                    },
                    "description": "Volcano engine prompt word optimization settings.",
                    "x-apifox-orders": [
                      "mode"
                    ]
                  },
                  "images": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 14,
                    "description": "Optional reference images for image-to-image generation. Omit for text-to-image generation. Image limits depend on the selected model.",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "object",
                          "required": [
                            "image_url"
                          ],
                          "properties": {
                            "image_url": {
                              "type": "string",
                              "minLength": 1,
                              "description": "Image URL, data URL, or Base64 string."
                            }
                          },
                          "additionalProperties": false,
                          "x-apifox-orders": [
                            "image_url"
                          ]
                        }
                      ]
                    }
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "background"
                      ],
                      "properties": {
                        "background": {
                          "const": "transparent"
                        }
                      },
                      "x-apifox-orders": [
                        "background"
                      ]
                    },
                    "then": {
                      "required": [
                        "output_format"
                      ],
                      "properties": {
                        "output_format": {
                          "const": "png"
                        }
                      },
                      "x-apifox-orders": [
                        "output_format"
                      ]
                    }
                  }
                ],
                "examples": [
                  {
                    "model": "volcengine/doubao-seedream-5.0-pro",
                    "prompt": "一座漂浮在云海上的未来城市，日出时分，电影级光影",
                    "size": "2K",
                    "output_format": "png",
                    "response_format": "b64_json",
                    "watermark": false,
                    "optimize_prompt_options": {
                      "mode": "standard"
                    }
                  }
                ],
                "x-apifox-orders": [
                  "model",
                  "prompt",
                  "size",
                  "output_format",
                  "background",
                  "response_format",
                  "watermark",
                  "optimize_prompt_options",
                  "images"
                ]
              },
              "examples": {
                "text-to-image": {
                  "value": {
                    "model": "volcengine/doubao-seedream-4.5",
                    "prompt": "日落时分的群山景色，夕阳映照山峦与天空，光影柔和，画面自然细腻，具有电影感。",
                    "size": "1024x1024"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "title": "DoubaoSeedream50ProGenerationResponse",
                  "description": "Doubao Seedream 5.0 Pro image generation successful response.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "created",
                    "data"
                  ],
                  "properties": {
                    "created": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0,
                      "description": "Image creation time, Unix timestamp, unit is seconds."
                    },
                    "data": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "description": "Generate results. The model returns one image at a time.",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "index": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Results index."
                          },
                          "b64_json": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Base64 encoded image; returned when response_format=b64_json."
                          },
                          "url": {
                            "type": "string",
                            "format": "uri",
                            "description": "Temporary image link; returned when response_format=url."
                          }
                        },
                        "oneOf": [
                          {
                            "required": [
                              "b64_json"
                            ]
                          },
                          {
                            "required": [
                              "url"
                            ]
                          }
                        ]
                      }
                    },
                    "model": {
                      "type": "string",
                      "description": "The model ID that actually executes the request."
                    },
                    "size": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*x[1-9][0-9]*$",
                      "description": "actual generated size."
                    },
                    "output_format": {
                      "type": "string",
                      "enum": [
                        "png",
                        "jpeg"
                      ],
                      "description": "Actual output format."
                    },
                    "background": {
                      "type": "string",
                      "enum": [
                        "opaque",
                        "transparent"
                      ],
                      "description": "The actual background type used."
                    },
                    "usage": {
                      "type": "object",
                      "additionalProperties": true,
                      "description": "The usage information generated this time.",
                      "properties": {
                        "input_tokens": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Enter the number of tokens."
                        },
                        "input_tokens_details": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "text_tokens": {
                              "type": "integer",
                              "minimum": 0,
                              "description": "The number of tokens consumed by the prompt word."
                            },
                            "image_tokens": {
                              "type": "integer",
                              "minimum": 0,
                              "description": "Enter the number of tokens consumed by the image."
                            }
                          }
                        },
                        "output_tokens": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Output the number of tokens."
                        },
                        "total_tokens": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Total number of tokens."
                        },
                        "generated_images": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Number of images generated."
                        }
                      }
                    }
                  },
                  "examples": [
                    {
                      "created": 1784696685,
                      "data": [
                        {
                          "b64_json": "iVBORw0KGgoAAAANSUhEUgAA...",
                          "index": 0
                        }
                      ],
                      "model": "volcengine/doubao-seedream-5.0-pro",
                      "size": "2048x2048",
                      "output_format": "png",
                      "usage": {
                        "input_tokens": 42,
                        "output_tokens": 2048,
                        "total_tokens": 2090,
                        "generated_images": 1
                      }
                    }
                  ]
                },
                "example": {
                  "created": 1788920400,
                  "data": [
                    {
                      "index": 0,
                      "b64_json": "iVBORw0KGgoAAAANSUhEUgAA..."
                    }
                  ],
                  "model": "volcengine/doubao-seedream-5.0-pro",
                  "size": "2048x2048"
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "x-model-capabilities": {
          "volcengine/doubao-seedream-5.0-pro": [
            "prompt",
            "size",
            "output_format",
            "background",
            "response_format",
            "watermark",
            "optimize_prompt_options"
          ],
          "volcengine/doubao-seedream-4.5": [
            "prompt",
            "size",
            "response_format",
            "watermark",
            "optimize_prompt_options"
          ]
        },
        "x-mint": {
          "href": "/en/api-reference/images/seedream/generate",
          "metadata": {
            "sidebarTitle": "Image generation"
          }
        }
      }
    }
  },
  "webhooks": {},
  "components": {
    "schemas": {},
    "responses": {},
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "https://api.tikway.ai",
      "description": "production environment"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ]
}
