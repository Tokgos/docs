{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikway MAI Image Image API",
    "description": "Tikway standard image API.",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "Image generation"
    },
    {
      "name": "Image generation/MAI Image"
    }
  ],
  "paths": {
    "/v1/images/generations": {
      "post": {
        "summary": "Image generation",
        "deprecated": false,
        "description": "microsoft/mai-image-2.5-pro supports text-to-image and image-to-image through the generation endpoint. The optional images array accepts one JPEG or PNG reference image. Each request produces one PNG. Both dimensions must be at least 768 pixels, with no more than 1,048,576 total pixels.",
        "tags": [
          "Image generation/MAI Image"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "title": "TikwayImageRequest",
                "description": "Use Doubao Seedream 5.0 Pro to generate images from text.",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "model",
                  "prompt"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Required. Use a model ID or available alias returned by Get Models.",
                    "examples": [
                      "microsoft/mai-image-2.5-pro"
                    ],
                    "minLength": 1
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Required. Describe the image to generate.",
                    "examples": [
                      "一座漂浮在云海上的未来城市，日出时分，电影级光影，建筑细节丰富"
                    ]
                  },
                  "size": {
                    "type": "string",
                    "default": "1024x1024",
                    "pattern": "^[1-9][0-9]*x[1-9][0-9]*$",
                    "description": "Output size as WIDTHxHEIGHT, or auto for the model default. Supported sizes depend on the selected model."
                  },
                  "response_format": {
                    "type": "string",
                    "description": "Response format: url returns image URLs; b64_json returns Base64 image data.",
                    "default": "url",
                    "enum": [
                      "b64_json",
                      "url"
                    ]
                  },
                  "images": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "description": "Optional reference images for image-to-image generation. Omit for text-to-image generation. Image limits depend on the selected model.",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "object",
                          "required": [
                            "image_url"
                          ],
                          "properties": {
                            "image_url": {
                              "type": "string",
                              "minLength": 1,
                              "description": "Image URL, data URL, or Base64 string."
                            }
                          },
                          "additionalProperties": false,
                          "x-apifox-orders": [
                            "image_url"
                          ]
                        }
                      ]
                    }
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "background"
                      ],
                      "properties": {
                        "background": {
                          "const": "transparent"
                        }
                      },
                      "x-apifox-orders": [
                        "background"
                      ]
                    },
                    "then": {
                      "required": [
                        "output_format"
                      ],
                      "properties": {
                        "output_format": {
                          "const": "png"
                        }
                      },
                      "x-apifox-orders": [
                        "output_format"
                      ]
                    }
                  }
                ],
                "examples": [
                  {
                    "model": "microsoft/mai-image-2.5-pro",
                    "prompt": "雨夜的未来城市，写实摄影",
                    "size": "1024x1024",
                    "response_format": "url"
                  },
                  {
                    "model": "microsoft/mai-image-2.5-pro",
                    "prompt": "将产品置于白色摄影棚，保留外观",
                    "size": "1024x1024",
                    "response_format": "url",
                    "images": [
                      {
                        "image_url": "https://example.com/assets/product.png"
                      }
                    ]
                  }
                ],
                "x-apifox-orders": [
                  "model",
                  "prompt",
                  "images",
                  "size",
                  "response_format"
                ]
              },
              "examples": {
                "text-to-image": {
                  "value": {
                    "model": "microsoft/mai-image-2.5-pro",
                    "prompt": "雨夜的未来城市，写实摄影",
                    "size": "1024x1024",
                    "response_format": "url"
                  }
                },
                "reference-image": {
                  "value": {
                    "model": "microsoft/mai-image-2.5-pro",
                    "prompt": "将产品置于白色摄影棚，保留外观",
                    "size": "1024x1024",
                    "response_format": "url",
                    "images": [
                      {
                        "image_url": "https://example.com/assets/product.png"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "created": {
                      "type": "integer",
                      "description": "Unix timestamp of the image creation time, in seconds.",
                      "examples": [
                        1788480000
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "index": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Results index."
                          },
                          "b64_json": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Base64 encoded image; returned when response_format=b64_json."
                          },
                          "url": {
                            "type": "string",
                            "format": "uri",
                            "description": "Temporary image link; returned when response_format=url."
                          }
                        },
                        "additionalProperties": false,
                        "oneOf": [
                          {
                            "required": [
                              "b64_json"
                            ]
                          },
                          {
                            "required": [
                              "url"
                            ]
                          }
                        ]
                      },
                      "description": "Generate a list of results."
                    },
                    "model": {
                      "type": "string",
                      "description": "The model ID that actually executes the request."
                    },
                    "output_format": {
                      "type": "string",
                      "description": "Actual output format."
                    },
                    "size": {
                      "type": "string",
                      "description": "actual generated size."
                    },
                    "usage": {
                      "type": "object",
                      "properties": {
                        "input_tokens": {
                          "type": "integer",
                          "description": "Enter the number of tokens."
                        },
                        "input_tokens_details": {
                          "type": "object",
                          "properties": {
                            "text_tokens": {
                              "type": "integer",
                              "description": "The number of tokens consumed by the prompt word."
                            }
                          },
                          "required": [
                            "text_tokens"
                          ]
                        },
                        "output_tokens": {
                          "type": "integer",
                          "description": "Output the number of tokens."
                        },
                        "output_tokens_details": {
                          "type": "object",
                          "properties": {
                            "image_tokens": {
                              "type": "integer",
                              "description": "The number of tokens consumed by the output image."
                            }
                          },
                          "required": [
                            "image_tokens"
                          ]
                        },
                        "total_tokens": {
                          "type": "integer",
                          "description": "Total number of tokens."
                        }
                      },
                      "required": [
                        "input_tokens",
                        "input_tokens_details",
                        "output_tokens",
                        "output_tokens_details",
                        "total_tokens"
                      ],
                      "description": "The usage information generated this time."
                    }
                  },
                  "required": [
                    "created",
                    "data",
                    "model",
                    "output_format",
                    "size",
                    "usage"
                  ],
                  "title": "Microsoft MAI Image 2.5 image generation response",
                  "description": "Unify transformed OpenAI Images responses."
                },
                "example": {
                  "created": 1788923928,
                  "data": [
                    {
                      "index": 0,
                      "b64_json": "iVBORw0KGgoAAAANSUhEUgAA..."
                    }
                  ],
                  "model": "microsoft/mai-image-2.5-pro",
                  "output_format": "png",
                  "size": "1024x1024",
                  "usage": {
                    "input_tokens": 36,
                    "input_tokens_details": {
                      "text_tokens": 36
                    },
                    "output_tokens": 1024,
                    "output_tokens_details": {
                      "image_tokens": 1024
                    },
                    "total_tokens": 1060
                  }
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "x-model-capabilities": {
          "microsoft/mai-image-2.5-pro": [
            "prompt",
            "size",
            "response_format"
          ]
        },
        "x-mint": {
          "href": "/en/api-reference/images/mai-image/generate",
          "metadata": {
            "sidebarTitle": "Image generation"
          }
        }
      }
    }
  },
  "webhooks": {},
