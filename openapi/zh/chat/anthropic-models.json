{
  "openapi": "3.1.0",
  "info": {
    "title": "Anthropic 模型列表",
    "description": "获取平台全部可调用模型，以 Anthropic 协议返回，并包含 aliases、architecture 和 capabilities。",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "对话补全"
    },
    {
      "name": "对话补全/Anthropic协议"
    }
  ],
  "paths": {
    "/anthropic/v1/models": {
      "get": {
        "summary": "Get Models",
        "deprecated": false,
        "description": "返回与 GET /v1/models 相同的完整可调用模型目录，覆盖全部供应商、文本、图片、视频、语音、嵌入和决策模型，不按当前协议隐式过滤。保留当前协议的外层响应结构和分页；可用 provider、mode、type 显式筛选。\n\n每个模型都包含 aliases、architecture、capabilities.endpoints、capabilities.parameters 和 capabilities.reasoning_efforts，取值与 OpenAI 列表一致。参数读取方式：common 与端点路径数组取并集。列表展示不表示每个模型都能使用当前协议生成内容，实际可调用路径以 capabilities.endpoints 为准。\n\nGET /v1/models 携带 anthropic-version 请求头时也返回此格式。",
        "operationId": "getModels",
        "tags": [
          "对话补全/Anthropic协议"
        ],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "按模型类型筛选，省略返回全部。支持 text/image/video/music/embedding，忽略大小写和周围空格。多个类型逗号分隔或重复 type，未知或空值返回 400。",
            "required": false,
            "example": "image,video",
            "schema": {
              "type": "string",
              "minLength": 1,
              "examples": [
                "text",
                "image",
                "video",
                "music",
                "embedding",
                "image,video"
              ]
            }
          },
          {
            "name": "x-provider-route",
            "in": "header",
            "description": "上游速度cost、stable、fast",
            "example": "cost",
            "schema": {
              "type": "string",
              "default": "cost"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "当前可调用模型目录；示例能力值仅用于展示结构，实际以返回值为准。",
            "content": {
              "application/json": {
                "schema": {
                  "title": "AnthropicModelsResponse",
                  "description": "GET /anthropic/v1/models 的 HTTP 200 响应；GET /v1/models 携带 anthropic-version 时也使用此结构。模型范围与 OpenAI 列表相同，保留 Anthropic 游标分页。",
                  "type": "object",
                  "required": [
                    "data",
                    "first_id",
                    "has_more",
                    "last_id"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "type",
                          "id",
                          "allowed_fallback_models",
                          "capabilities",
                          "created_at",
                          "display_name",
                          "description",
                          "context_length",
                          "supported_parameters",
                          "max_input_tokens",
                          "max_tokens",
                          "aliases",
                          "architecture"
                        ],
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "model"
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "description": "完整平台模型 ID，保留供应商命名空间。"
                          },
                          "display_name": {
                            "type": "string",
                            "description": "模型显示名称。"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time",
                            "description": "模型发布时间。未配置时返回 1970-01-01T00:00:00Z。"
                          },
                          "description": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "context_length": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0,
                            "description": "上下文 token 上限，未配置时为 null。"
                          },
                          "max_input_tokens": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0,
                            "description": "最大输入 token 数，当前与 context_length 相同。"
                          },
                          "max_tokens": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0,
                            "description": "最大输出 token 数；未配置且无法从参数配置推导时为 null。"
                          },
                          "supported_parameters": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Anthropic 原生参数名；没有 Anthropic 协议参数配置时返回空数组。实际调用端点参数见 capabilities.parameters。"
                          },
                          "allowed_fallback_models": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "允许的回退模型 ID 列表，当前返回空数组。"
                          },
                          "aliases": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "模型的可用别名，来自当前平台配置；未配置时返回空数组。"
                          },
                          "architecture": {
                            "type": "object",
                            "required": [
                              "input_modalities",
                              "output_modalities"
                            ],
                            "properties": {
                              "input_modalities": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "output_modalities": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            },
                            "description": "模型可接受和可输出的模态，按平台配置及实际可调用端点生成。",
                            "additionalProperties": false
                          },
                          "capabilities": {
                            "type": "object",
                            "required": [
                              "reasoning_efforts",
                              "endpoints",
                              "parameters",
                              "batch",
                              "citations",
                              "code_execution",
                              "compaction",
                              "context_management",
                              "effort",
                              "image_input",
                              "pdf_input",
                              "structured_outputs",
                              "thinking"
                            ],
                            "properties": {
                              "reasoning_efforts": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "按实际端点参数配置汇总的推理档位；无可配置档位时返回空数组。"
                              },
                              "endpoints": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "minItems": 1,
                                "description": "模型当前实际可调用的 API 路径，来自平台路由配置。"
                              },
