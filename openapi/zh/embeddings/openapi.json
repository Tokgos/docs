{
  "openapi": "3.1.0",
  "info": {
    "title": "Mintlify",
    "description": "Qwen-Image 3.0 Pro 的 OpenAI 兼容图片生成与参考图编辑接口。",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "向量嵌入"
    }
  ],
  "paths": {
    "/v1/embeddings": {
      "post": {
        "summary": "GPT - 向量",
        "deprecated": false,
        "description": "",
        "tags": [
          "向量嵌入"
        ],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "EmbeddingRequest",
                "description": "将文本或 token ID 转换为向量表示。",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "description": "向量模型 ID。",
                    "examples": [
                      "openai/text-embedding-3-small",
                      "openai/text-embedding-3-large",
                      "bailian/text-embedding-v4",
                      "google/gemini-embedding-2-preview"
                    ]
                  },
                  "input": {
                    "description": "需要生成向量的输入。支持单个字符串、字符串数组、token ID 数组或 token ID 二维数组。Gemini embedding 模型当前只支持单个字符串。",
                    "oneOf": [
                      {
                        "title": "单条文本",
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "title": "批量文本",
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 2048,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      {
                        "title": "单条 Token 数组",
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 2048,
                        "items": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      {
                        "title": "批量 Token 数组",
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 2048,
                        "items": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 2048,
                          "items": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    ],
                    "examples": [
                      "Tikway 是一个 LLM Gateway",
                      [
                        "第一段文本",
                        "第二段文本"
                      ]
                    ]
                  },
                  "encoding_format": {
                    "type": "string",
                    "enum": [
                      "float",
                      "base64"
                    ],
                    "default": "float",
                    "description": "向量编码格式。float 返回浮点数数组；base64 返回 Base64 编码的 float32 数据。"
                  },
                  "dimensions": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "输出向量维度，仅部分模型支持。Gemini embedding 模型在当前网关中限制为 128 至 3072。"
                  },
                  "user": {
                    "type": "string",
                    "description": "终端用户标识，用于上游滥用监控。"
                  }
                },
                "examples": [
                  {
                    "model": "openai/text-embedding-3-small",
                    "input": "Tikway 是一个 LLM Gateway",
                    "encoding_format": "float"
                  },
                  {
                    "model": "bailian/text-embedding-v4",
                    "input": [
                      "第一段文本",
                      "第二段文本"
                    ],
                    "dimensions": 1024,
                    "encoding_format": "float"
                  }
                ]
              },
              "example": {
                "model": "openai/text-embedding-3-large",
                "input": "Hello, world!"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "title": "EmbeddingResponse",
                  "description": "OpenAI Embeddings 兼容响应。",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "object",
                    "data",
                    "model",
                    "usage"
                  ],
                  "properties": {
                    "object": {
                      "type": "string",
                      "const": "list",
                      "description": "固定为 list。"
                    },
                    "data": {
                      "type": "array",
                      "minItems": 1,
                      "description": "输入对应的向量结果列表。",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "object",
                          "embedding",
                          "index"
                        ],
                        "properties": {
                          "object": {
                            "type": "string",
                            "const": "embedding"
                          },
                          "embedding": {
                            "description": "向量数据。具体类型由请求中的 encoding_format 决定。",
                            "oneOf": [
                              {
                                "title": "Float 向量",
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                  "type": "number"
                                }
                              },
                              {
                                "title": "Base64 向量",
                                "type": "string",
                                "minLength": 1,
                                "contentEncoding": "base64",
                                "description": "按照 float32 小端序编码后的 Base64 字符串。"
                              }
                            ]
                          },
                          "index": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "对应输入内容的索引。"
                          }
                        }
                      }
                    },
                    "model": {
                      "type": "string",
                      "description": "实际使用的模型 ID。"
                    },
                    "usage": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "prompt_tokens",
                        "total_tokens"
                      ],
                      "properties": {
                        "prompt_tokens": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "输入消耗的 token 数。"
                        },
                        "total_tokens": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "本次请求总 token 数。"
                        }
                      }
                    }
                  },
                  "examples": [
                    {
                      "object": "list",
                      "data": [
                        {
                          "object": "embedding",
                          "index": 0,
                          "embedding": [
                            0.0023,
                            -0.0091,
                            0.0156
                          ]
                        }
                      ],
                      "model": "openai/text-embedding-3-small",
                      "usage": {
                        "prompt_tokens": 8,
                        "total_tokens": 8
                      }
                    }
                  ]
                },
                "example": {
                  "data": [
                    {
                      "embedding": [
                        -0.005828857421875,
                        -0.0241241455078125,
                        -0.02203369140625
                      ],
                      "index": 0,
                      "object": "embedding"
                    }
                  ],
                  "model": "openai/text-embedding-3-large",
                  "object": "list",
                  "usage": {
                    "prompt_tokens": 4,
                    "total_tokens": 4
                  }
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "x-mint": {
          "href": "/zh/api-reference/embeddings/openai/create",
          "metadata": {
            "sidebarTitle": "GPT - 向量"
          }
        }
      }
    },
    "/v1beta/models/google/{model}:embedContent": {
      "post": {
        "summary": "Gemini - 向量",
        "deprecated": false,
        "description": "Gemini 单条 embedContent 向量接口。请求字段为 content，不是对话生成接口的 contents；模型由 URL 选择。结果为 embedding.values 数值数组。",
        "tags": [
          "向量嵌入"
        ],
        "parameters": [
          {
            "name": "model",
            "in": "path",
            "required": true,
            "description": "Gemini 模型名称，不含 google/ 前缀。",
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "gemini-embedding-2-preview"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$id": "urn:tikway:schema:protocols:gemini:embed-content:request:1",
                "title": "gemini/embed-content 请求",
                "description": "gemini/embed-content 请求。扩展字段保留，在选定供应商后继续校验。",
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "content": {
                    "type": "object",
                    "properties": {
                      "parts": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "properties": {
                            "text": {
                              "type": "string"
                            },
                            "inlineData": {
                              "type": "object",
                              "properties": {},
                              "additionalProperties": true
                            },
                            "fileData": {
                              "type": "object",
                              "properties": {},
                              "additionalProperties": true
                            },
                            "functionCall": {
                              "type": "object",
                              "properties": {},
                              "additionalProperties": true
                            },
                            "functionResponse": {
                              "type": "object",
                              "properties": {},
                              "additionalProperties": true
                            }
                          },
                          "additionalProperties": true
                        }
                      }
                    },
                    "required": [
                      "parts"
                    ],
                    "additionalProperties": true
                  },
                  "outputDimensionality": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "taskType": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  }
                },
                "required": [
                  "content"
                ],
                "additionalProperties": true
              },
              "examples": {
                "文本向量": {
                  "value": {
                    "content": {
                      "parts": [
                        {
                          "text": "什么是向量检索？"
                        }
                      ]
                    },
                    "taskType": "RETRIEVAL_QUERY",
                    "outputDimensionality": 768
                  },
                  "summary": "文本向量"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$id": "urn:tikway:schema:protocols:gemini:embed-content:response:1",
                  "title": "gemini/embed-content 响应",
                  "description": "gemini/embed-content 响应。扩展字段保留，在选定供应商后继续校验。",
                  "type": "object",
                  "properties": {
                    "embedding": {
                      "type": "object",
                      "properties": {
                        "values": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        }
                      },
                      "required": [
                        "values"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "embedding"
                  ],
                  "additionalProperties": true,
                  "examples": [
                    {
                      "embedding": {
                        "values": [
                          0.012,
                          -0.031,
                          0.008
                        ]
                      }
                    }
                  ]
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "x-mint": {
          "href": "/zh/api-reference/embeddings/gemini/create",
          "metadata": {
            "sidebarTitle": "Gemini - 向量"
          }
        }
      }
    }
  },
  "webhooks": {},
  "components": {
    "schemas": {},
    "responses": {},
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "https://api.tikway.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ]
}
