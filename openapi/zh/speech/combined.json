{
  "openapi": "3.1.0",
  "info": {
    "title": "语音合成 API",
    "description": "使用 OpenAI 请求字段调用 OpenAI、Google、Qwen-Audio 和 Qwen-TTS。Google/Qwen 专有字段可放入 extra_body，也可直接放在 body 顶层。DashScope Client 自动选择语音上游接口并转换请求与响应；模型只需关联 /v1/audio/speech，无须配置原生多模态或 SpeechSynthesizer 端点。DashScope 的 Qwen3-TTS/Qwen-TTS 固定请求 dashscope.aliyuncs.com 官方接口，账号已有 MaaS Base URL 无需修改。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.tikway.ai"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/audio/speech": {
      "post": {
        "operationId": "createSpeech",
        "summary": "语音合成",
        "description": "使用 OpenAI 请求字段调用 OpenAI、Google、Qwen-Audio 和 Qwen-TTS。Google/Qwen 专有字段可放入 extra_body，也可直接放在 body 顶层。DashScope Client 自动选择语音上游接口并转换请求与响应；模型只需关联 /v1/audio/speech，无须配置原生多模态或 SpeechSynthesizer 端点。DashScope 的 Qwen3-TTS/Qwen-TTS 固定请求 dashscope.aliyuncs.com 官方接口，账号已有 MaaS Base URL 无需修改。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "description": "完整模型 ID 或唯一别名。示例模型需已在模型目录中配置。"
                  },
                  "input": {
                    "type": "string",
                    "maxLength": 4096,
                    "description": "待合成文本，OpenAI 上限 4096 字符；Qwen-TTS 上游上限 600 字符。"
                  },
                  "voice": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "id"
                        ],
                        "additionalProperties": true
                      }
                    ],
                    "description": "音色名或 {\"id\":\"voice_1234\"}。OpenAI 内置音色包括 alloy、ash、ballad、coral、echo、fable、onyx、nova、sage、shimmer、verse、marin、cedar；Google 可传预置名、voice_ ID 或 voicekey_；Qwen 使用对应模型音色。"
                  },
                  "instructions": {
                    "type": "string",
                    "maxLength": 4096,
                    "description": "语音风格指令。Google 3.8 映射到 speech_metadata.style，正文 input 不加指令前缀；2.5/3.1 使用旧版提示词。Qwen-Audio/CosyVoice 映射 instruction。Qwen-TTS 不支持。"
                  },
                  "response_format": {
                    "type": "string",
                    "enum": [
                      "mp3",
                      "opus",
                      "aac",
                      "flac",
                      "wav",
                      "pcm"
                    ],
                    "description": "OpenAI 默认 mp3，支持全部枚举。Qwen-Audio 默认 mp3，支持 mp3/pcm/wav/opus。Google 默认 wav，支持 wav/pcm。Qwen-TTS 固定 wav。不支持的格式返回参数错误，不进行隐式转码。 Google 3.8 原生 WAV 保持原容器，pcm 请求提取 PCM；旧模型的 PCM 仅在请求 wav 时封装一次。"
                  },
                  "speed": {
                    "type": "number",
                    "minimum": 0.25,
                    "maximum": 4,
                    "default": 1,
                    "description": "OpenAI 范围 0.25–4，默认 1；Qwen-Audio 映射 rate，范围 0.5–2；Google 通过自然语言指令控制，效果依赖模型；Qwen-TTS 仅接受 1。"
                  },
                  "stream_format": {
                    "type": "string",
                    "enum": [
                      "audio",
                      "sse"
                    ],
                    "default": "audio",
                    "description": "audio 返回音频字节；sse 返回 speech.audio.delta（Base64 audio）和 speech.audio.done（usage）。OpenAI tts-1/tts-1-hd 不支持 SSE。Google 合成和 WAV 封装会先缓冲完整音频。"
                  },
                  "extra_body": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "sample_rate": {
                        "type": "integer",
                        "enum": [
                          8000,
                          12000,
                          16000,
                          22050,
                          24000,
                          44100,
                          48000
                        ],
                        "description": "Qwen-Audio 采样率；opus 不支持 22050、44100。"
                      },
                      "volume": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "rate": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 2,
                        "description": "Qwen-Audio 原生语速；同时传 speed 时以 speed 为准。"
                      },
                      "bit_rate": {
                        "type": "integer",
                        "minimum": 6,
                        "maximum": 510
                      },
                      "pitch": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 2
                      },
                      "enable_ssml": {
                        "type": "boolean"
                      },
                      "word_timestamp_enabled": {
                        "type": "boolean",
                        "description": "Qwen-Audio 原生参数；统一语音响应仅返回音频及用量，不暴露原生时间戳事件。"
                      },
                      "seed": {
                        "type": "integer",
                        "description": "Qwen-Audio 范围 0–65535；Google 使用模型支持的范围。"
                      },
                      "language_hints": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "instruction": {
                        "type": "string",
                        "description": "Qwen-Audio 原生指令；同时传 instructions 时以 instructions 为准。"
                      },
                      "enable_aigc_tag": {
                        "type": "boolean"
                      },
                      "aigc_propagator": {
                        "type": "string"
                      },
                      "aigc_propagate_id": {
                        "type": "string"
                      },
                      "hot_fix": {
                        "type": "object",
                        "properties": {
                          "pronunciation": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": {
                                "type": "string"
                              }
                            }
                          },
                          "replace": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "required": [],
                        "additionalProperties": true
                      },
                      "language_type": {
                        "type": "string",
                        "enum": [
                          "Auto",
                          "Chinese",
                          "English",
                          "German",
                          "Italian",
                          "Portuguese",
                          "Spanish",
                          "Japanese",
                          "Korean",
                          "French",
                          "Russian"
                        ],
                        "description": "Qwen-TTS 语言。"
                      },
                      "speech_config": {
                        "type": "object",
                        "properties": {
                          "languageCode": {
                            "type": "string"
                          },
                          "voiceConfig": {
                            "type": "object",
                            "properties": {
                              "voice": {
                                "type": "string"
                              },
                              "prebuiltVoiceConfig": {
                                "type": "object",
                                "properties": {
                                  "voiceName": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "voiceName"
                                ]
                              }
                            },
                            "additionalProperties": true
                          },
                          "multiSpeakerVoiceConfig": {
                            "type": "object",
                            "properties": {
                              "speakerVoiceConfigs": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 2,
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "speaker": {
                                      "type": "string"
                                    },
                                    "voiceConfig": {
                                      "type": "object",
                                      "properties": {
                                        "voice": {
                                          "type": "string"
                                        },
                                        "prebuiltVoiceConfig": {
                                          "type": "object",
                                          "properties": {
                                            "voiceName": {
                                              "type": "string"
                                            }
                                          },
                                          "required": [
                                            "voiceName"
                                          ]
                                        }
                                      },
                                      "additionalProperties": true
                                    }
                                  },
                                  "required": [
                                    "speaker",
                                    "voiceConfig"
                                  ]
                                }
                              }
                            },
                            "required": [
                              "speakerVoiceConfigs"
                            ]
                          }
                        },
                        "additionalProperties": true
                      },
                      "generation_config": {
                        "type": "object",
                        "additionalProperties": true
                      },
                      "language_code": {
                        "type": "string",
                        "description": "Google BCP-47 语言代码。"
                      },
                      "multi_speaker_voice_config": {
                        "type": "object",
                        "properties": {
                          "speakerVoiceConfigs": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 2,
                            "items": {
                              "type": "object",
                              "properties": {
                                "speaker": {
                                  "type": "string"
                                },
                                "voiceConfig": {
                                  "type": "object",
                                  "properties": {
                                    "voice": {
                                      "type": "string"
                                    },
                                    "prebuiltVoiceConfig": {
                                      "type": "object",
                                      "properties": {
                                        "voiceName": {
                                          "type": "string"
                                        }
                                      },
                                      "required": [
                                        "voiceName"
                                      ]
                                    }
                                  },
                                  "additionalProperties": true
                                }
                              },
                              "required": [
                                "speaker",
                                "voiceConfig"
                              ]
                            }
                          }
                        },
                        "required": [
                          "speakerVoiceConfigs"
                        ]
                      },
                      "temperature": {
                        "type": "number"
                      },
                      "stream": {
                        "type": "boolean",
                        "description": "扩展参数：要求 Qwen 原生流式生成；stream_format 决定对外返回音频还是 SSE。"
                      },
                      "speech_metadata": {
                        "type": "object",
                        "properties": {
                          "speaker": {
                            "type": "string"
                          },
                          "style": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true,
                        "description": "Google 3.8 的逐句风格和说话人元数据。"
                      },
                      "contents": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "properties": {
                            "role": {
                              "type": "string",
                              "enum": [
                                "user"
                              ]
                            },
                            "parts": {
                              "type": "array",
                              "minItems": 1,
                              "items": {
                                "type": "object",
                                "properties": {
                                  "text": {
                                    "type": "string"
                                  },
                                  "speech_metadata": {
                                    "type": "object",
                                    "properties": {
                                      "speaker": {
                                        "type": "string"
                                      },
                                      "style": {
                                        "type": "string"
                                      }
                                    },
                                    "additionalProperties": true
                                  }
                                },
                                "required": [
                                  "text"
                                ]
                              }
                            }
                          },
                          "required": [
                            "parts"
                          ]
                        },
                        "description": "Google 文本 turns；用于多说话人，覆盖由 input 自动生成的 contents；仅允许文本。"
                      }
                    },
                    "description": "Google/Qwen 扩展参数。也可直接放在 body 顶层；同名字段顶层优先，仅展开一层。"
                  },
                  "sample_rate": {
                    "type": "integer",
                    "enum": [
                      8000,
                      12000,
                      16000,
                      22050,
                      24000,
                      44100,
                      48000
                    ],
                    "description": "Qwen-Audio 采样率；opus 不支持 22050、44100。"
                  },
                  "volume": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "rate": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 2,
                    "description": "Qwen-Audio 原生语速；同时传 speed 时以 speed 为准。"
                  },
                  "bit_rate": {
                    "type": "integer",
                    "minimum": 6,
                    "maximum": 510
                  },
                  "pitch": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 2
                  },
                  "enable_ssml": {
                    "type": "boolean"
                  },
                  "word_timestamp_enabled": {
                    "type": "boolean",
                    "description": "Qwen-Audio 原生参数；统一语音响应仅返回音频及用量，不暴露原生时间戳事件。"
                  },
                  "seed": {
                    "type": "integer",
                    "description": "Qwen-Audio 范围 0–65535；Google 使用模型支持的范围。"
                  },
                  "language_hints": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "instruction": {
                    "type": "string",
                    "description": "Qwen-Audio 原生指令；同时传 instructions 时以 instructions 为准。"
                  },
                  "enable_aigc_tag": {
                    "type": "boolean"
                  },
                  "aigc_propagator": {
                    "type": "string"
                  },
                  "aigc_propagate_id": {
                    "type": "string"
                  },
                  "hot_fix": {
                    "type": "object",
                    "properties": {
                      "pronunciation": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      },
                      "replace": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "required": [],
                    "additionalProperties": true
                  },
                  "language_type": {
                    "type": "string",
                    "enum": [
                      "Auto",
                      "Chinese",
                      "English",
                      "German",
                      "Italian",
                      "Portuguese",
                      "Spanish",
                      "Japanese",
                      "Korean",
                      "French",
