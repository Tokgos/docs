                    ],
                    "description": "Qwen-TTS 语言。"
                  },
                  "speech_config": {
                    "type": "object",
                    "properties": {
                      "languageCode": {
                        "type": "string"
                      },
                      "voiceConfig": {
                        "type": "object",
                        "properties": {
                          "voice": {
                            "type": "string"
                          },
                          "prebuiltVoiceConfig": {
                            "type": "object",
                            "properties": {
                              "voiceName": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "voiceName"
                            ]
                          }
                        },
                        "additionalProperties": true
                      },
                      "multiSpeakerVoiceConfig": {
                        "type": "object",
                        "properties": {
                          "speakerVoiceConfigs": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 2,
                            "items": {
                              "type": "object",
                              "properties": {
                                "speaker": {
                                  "type": "string"
                                },
                                "voiceConfig": {
                                  "type": "object",
                                  "properties": {
                                    "voice": {
                                      "type": "string"
                                    },
                                    "prebuiltVoiceConfig": {
                                      "type": "object",
                                      "properties": {
