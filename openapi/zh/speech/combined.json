                                "voiceConfig"
                              ]
                            }
                          }
                        },
                        "required": [
                          "speakerVoiceConfigs"
                        ]
                      }
                    },
                    "additionalProperties": true
                  },
                  "generation_config": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "language_code": {
                    "type": "string",
                    "description": "Google BCP-47 语言代码。"
                  },
                  "multi_speaker_voice_config": {
                    "type": "object",
                    "properties": {
                      "speakerVoiceConfigs": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 2,
                        "items": {
                          "type": "object",
                          "properties": {
                            "speaker": {
