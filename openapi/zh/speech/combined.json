              },
              "examples": {
                "openai": {
                  "value": {
                    "model": "openai/gpt-4o-mini-tts",
                    "input": "Hello, welcome to our service.",
                    "voice": "alloy",
                    "response_format": "mp3"
                  }
                },
                "qwen_audio": {
                  "value": {
                    "model": "qwen/qwen-audio-3.0-tts-flash",
                    "input": "Welcome to the speech test.",
