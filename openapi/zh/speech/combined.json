                "example": "data: {\"type\":\"speech.audio.delta\",\"audio\":\"AAABAA==\"}\n\ndata: {\"type\":\"speech.audio.done\",\"usage\":{\"input_tokens\":4,\"output_tokens\":2}}\n\n"
