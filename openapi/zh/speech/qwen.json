{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikway Qwen 语音合成 API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.tikway.ai"
    }
  ],
  "tags": [
    {
      "name": "语音合成/Qwen"
    }
  ],
  "paths": {
    "/v1/audio/speech": {
      "post": {
        "summary": "Qwen - 文转语音",
        "description": "通过 POST /v1/audio/speech 调用 Qwen3-TTS，返回 WAV 或统一 SSE 音频事件。语言扩展可放在 extra_body 或 body 顶层，顶层同名字段优先。模型 ID 或别名需已在目标平台配置。",
        "operationId": "createSpeech",
        "tags": [
          "语音合成/Qwen"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "音频字节或统一 SSE 音频事件；支持的媒体类型见下方列表。",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "example1": {
                    "summary": "成功示例",
                    "value": "data: {\"type\":\"speech.audio.delta\",\"audio\":\"UklGRigAAABXQVZFZm10IBAAAAABAAEAwF0AAIC7AAACABAAZGF0YQQAAAAAAAEA\"}\n\ndata: {\"type\":\"speech.audio.done\",\"usage\":{\"input_tokens\":0,\"output_tokens\":0,\"total_tokens\":0,\"characters\":12}}\n\n"
                  }
                }
              },
              "audio/wav": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "code": {
                          "type": [
                            "string",
                            "integer",
                            "null"
                          ]
                        },
                        "param": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "code": {
                          "type": [
                            "string",
                            "integer",
                            "null"
                          ]
                        },
                        "param": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "code": {
                          "type": [
                            "string",
                            "integer",
                            "null"
                          ]
                        },
                        "param": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "502": {
            "description": "Upstream error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "code": {
                          "type": [
                            "string",
                            "integer",
                            "null"
                          ]
                        },
                        "param": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "其他网关错误；根据 HTTP 状态码和 error.message 排查。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "code": {
                          "type": [
                            "string",
                            "integer",
                            "null"
                          ]
                        },
                        "param": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "title": "Qwen3-TTS 请求体",
                "description": "使用平台标准 model、字符串 input 和 voice 调用 Qwen3-TTS，固定返回 WAV 音频。语言可放入 extra_body 或顶层，同名字段顶层优先。",
                "type": "object",
                "required": [
                  "model",
                  "input",
                  "voice"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "description": "网关已配置的 Qwen3-TTS-Flash 模型 ID 或别名。",
                    "examples": [
                      "qwen3-tts-flash",
                      "bailian/qwen3-tts-flash"
                    ]
                  },
                  "input": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 600,
                    "description": "需要合成的朗读文本，最多 600 字符，支持多语种混合输入。",
                    "examples": [
                      "你好，欢迎测试语音合成接口。"
                    ]
                  },
                  "voice": {
                    "type": "string",
                    "description": "填写 Qwen3-TTS 支持的预置音色，区分大小写；完整清单见 Qwen 音色指南。",
                    "examples": [
                      "Cherry",
                      "Serena",
                      "Ethan"
                    ],
                    "minLength": 1
                  },
                  "response_format": {
                    "type": "string",
                    "enum": [
                      "wav"
                    ],
                    "default": "wav",
                    "description": "Qwen3-TTS 固定返回 WAV；省略时使用 WAV。"
                  },
                  "stream_format": {
                    "type": "string",
                    "enum": [
                      "audio",
                      "sse"
                    ],
                    "default": "audio",
                    "description": "audio 返回 WAV 音频字节；sse 返回网关统一的 speech.audio.delta 和 speech.audio.done 事件，音频分片为 Base64。"
                  },
                  "extra_body": {
                    "type": "object",
                    "description": "供应商扩展参数。字段直接放入此对象，无须嵌套原生 input 或 parameters。",
                    "properties": {
                      "language_type": {
                        "type": "string",
                        "enum": [
                          "Auto",
                          "Chinese",
                          "English",
                          "German",
                          "Italian",
                          "Portuguese",
                          "Spanish",
                          "Japanese",
                          "Korean",
                          "French",
                          "Russian"
                        ],
                        "default": "Auto",
                        "description": "合成语言。Auto 自动识别；单一语种建议指定对应语言。"
                      }
                    },
                    "additionalProperties": false
                  },
                  "language_type": {
                    "type": "string",
                    "enum": [
                      "Auto",
                      "Chinese",
                      "English",
                      "German",
                      "Italian",
                      "Portuguese",
                      "Spanish",
                      "Japanese",
                      "Korean",
                      "French",
                      "Russian"
                    ],
                    "description": "兼容顶层扩展写法；与 extra_body.language_type 同时存在时，以此字段为准。通常只需选择一种位置传入。"
                  }
                },
                "additionalProperties": false,
                "examples": [
                  {
                    "model": "qwen3-tts-flash",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Cherry"
                  },
                  {
                    "model": "qwen3-tts-flash",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Cherry",
                    "extra_body": {
                      "language_type": "Chinese"
                    }
                  },
                  {
                    "model": "qwen3-tts-flash",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Serena",
                    "language_type": "Chinese"
                  },
                  {
                    "model": "qwen3-tts-flash",
                    "input": "Hello, welcome to the speech synthesis demo.",
                    "voice": "Ethan",
                    "extra_body": {
                      "language_type": "English"
                    }
                  },
                  {
                    "model": "qwen3-tts-flash",
                    "input": "你好，欢迎来到语音演示。Hello, welcome to the demo.",
                    "voice": "Cherry",
                    "extra_body": {
                      "language_type": "Auto"
                    }
                  },
                  {
                    "model": "qwen3-tts-flash",
                    "input": "こんにちは。音声合成のデモへようこそ。",
                    "voice": "Momo",
                    "extra_body": {
                      "language_type": "Japanese"
                    }
                  },
                  {
                    "model": "qwen3-tts-flash",
                    "input": "안녕하세요. 음성 합성 데모에 오신 것을 환영합니다.",
                    "voice": "Serena",
                    "extra_body": {
                      "language_type": "Korean"
                    }
                  },
                  {
                    "model": "qwen3-tts-flash",
                    "input": "Bonjour, bienvenue dans cette démonstration de synthèse vocale.",
                    "voice": "Maia",
                    "extra_body": {
                      "language_type": "French"
                    }
                  },
                  {
                    "model": "qwen3-tts-flash",
                    "input": "Hola, bienvenidos a esta demostración de síntesis de voz.",
                    "voice": "Cherry",
                    "extra_body": {
                      "language_type": "Spanish"
                    }
                  },
                  {
                    "model": "qwen3-tts-flash",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Cherry",
                    "stream_format": "sse",
                    "extra_body": {
                      "language_type": "Chinese"
                    }
                  },
                  {
                    "model": "qwen3-tts-flash",
                    "input": "Hello, the language at the body root takes precedence.",
                    "voice": "Cherry",
                    "language_type": "English",
                    "extra_body": {
                      "language_type": "Chinese"
                    }
                  },
                  {
                    "model": "bailian/qwen3-tts-flash",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Kai",
                    "stream_format": "audio"
                  }
                ]
              },
              "examples": {
                "qwen_minimal": {
                  "summary": "最小请求：默认返回 WAV",
                  "value": {
                    "model": "qwen3-tts-flash",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Cherry"
                  }
                },
                "qwen_chinese_extra_body": {
                  "summary": "中文：语言放入 extra_body",
                  "value": {
                    "model": "qwen3-tts-flash",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Cherry",
                    "extra_body": {
                      "language_type": "Chinese"
                    }
                  }
                },
                "qwen_chinese_root": {
                  "summary": "中文：语言直接放在顶层",
                  "value": {
                    "model": "qwen3-tts-flash",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Serena",
                    "language_type": "Chinese"
                  }
                },
                "qwen_english": {
                  "summary": "英文：Ethan 音色",
                  "value": {
                    "model": "qwen3-tts-flash",
                    "input": "Hello, welcome to the speech synthesis demo.",
                    "voice": "Ethan",
                    "extra_body": {
                      "language_type": "English"
                    }
                  }
                },
                "qwen_multilingual_auto": {
                  "summary": "中英混合：自动识别语言",
                  "value": {
                    "model": "qwen3-tts-flash",
                    "input": "你好，欢迎来到语音演示。Hello, welcome to the demo.",
                    "voice": "Cherry",
                    "extra_body": {
                      "language_type": "Auto"
                    }
                  }
                },
                "qwen_japanese": {
                  "summary": "日语：Momo 音色",
                  "value": {
                    "model": "qwen3-tts-flash",
                    "input": "こんにちは。音声合成のデモへようこそ。",
                    "voice": "Momo",
                    "extra_body": {
                      "language_type": "Japanese"
                    }
                  }
                },
                "qwen_korean": {
                  "summary": "韩语：Serena 音色",
                  "value": {
                    "model": "qwen3-tts-flash",
                    "input": "안녕하세요. 음성 합성 데모에 오신 것을 환영합니다.",
                    "voice": "Serena",
                    "extra_body": {
                      "language_type": "Korean"
                    }
                  }
                },
                "qwen_french": {
                  "summary": "法语：Maia 音色",
                  "value": {
                    "model": "qwen3-tts-flash",
                    "input": "Bonjour, bienvenue dans cette démonstration de synthèse vocale.",
                    "voice": "Maia",
                    "extra_body": {
                      "language_type": "French"
                    }
                  }
                },
                "qwen_spanish": {
                  "summary": "西班牙语：Cherry 音色",
                  "value": {
                    "model": "qwen3-tts-flash",
                    "input": "Hola, bienvenidos a esta demostración de síntesis de voz.",
                    "voice": "Cherry",
                    "extra_body": {
                      "language_type": "Spanish"
                    }
                  }
                },
                "qwen_sse": {
                  "summary": "SSE：返回统一音频事件",
                  "description": "audio 字段为 Base64；结束事件为 speech.audio.done。",
                  "value": {
                    "model": "qwen3-tts-flash",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Cherry",
                    "stream_format": "sse",
                    "extra_body": {
                      "language_type": "Chinese"
                    }
                  }
                },
                "qwen_root_wins": {
                  "summary": "同名扩展：顶层语言优先",
                  "description": "实际使用顶层 language_type=English。",
                  "value": {
                    "model": "qwen3-tts-flash",
                    "input": "Hello, the language at the body root takes precedence.",
                    "voice": "Cherry",
                    "language_type": "English",
                    "extra_body": {
                      "language_type": "Chinese"
                    }
                  }
                },
                "qwen_full_model_id": {
                  "summary": "完整模型 ID：bailian 前缀",
                  "description": "模型 ID 或别名需在目标平台配置。",
                  "value": {
                    "model": "bailian/qwen3-tts-flash",
                    "input": "你好，欢迎使用语音合成。",
                    "voice": "Kai",
                    "stream_format": "audio"
                  }
                }
              }
            }
          }
        },
        "x-mint": {
          "href": "/zh/api-reference/speech/qwen/create",
          "metadata": {
            "sidebarTitle": "Qwen - 文转语音"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
