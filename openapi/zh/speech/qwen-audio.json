                    "stream_format": "audio",
                    "extra_body": {
                      "stream": true
                    }
                  }
                },
                "qwen_audio_english": {
                  "summary": "3.1 Flash：英文音色 Emily",
                  "value": {
                    "model": "bailian/qwen-audio-3.1-tts-flash",
                    "input": "Hello, welcome to the speech synthesis demo.",
                    "voice": "Emily_v3.1",
